@code {
    private BusinessSettingsFormModel _settings = new();
    private List<InvoiceFollowUpItemViewModel> _items = new();
    private InvoiceFollowUpSummaryViewModel _summary = new();

    private bool _loading = true;
    private bool _saving;

    private string? _searchTerm;
    private string _followUpStatusFilter = "all";
    private string _reminderFilter = "all";

    private string? _message;
    private bool _isSuccess;

    private bool _showFollowModal;
    private UpdateInvoiceFollowUpModel _followModel = new();
    private string _activeInvoiceNumber = string.Empty;
    private decimal _activeBalanceDue;

    private int _currentPage = 1;
    private int _pageSize = 10;
    private int? _openActionInvoiceId;

    private string CurrencyLabel =>
        string.IsNullOrWhiteSpace(_settings.CurrencySymbol)
            ? "R"
            : _settings.CurrencySymbol;

    private List<InvoiceFollowUpItemViewModel> OrderedItems =>
        _items
            .OrderBy(x => x.NextFollowUpDate.HasValue ? x.NextFollowUpDate.Value.Date : DateTime.MaxValue)
            .ThenByDescending(x => x.DaysOverdue)
            .ToList();

    private int TotalFollowUps => OrderedItems.Count;

    private string FollowUpPlural => TotalFollowUps == 1 ? "" : "s";

    private int TotalPages =>
        TotalFollowUps == 0
            ? 1
            : (int)Math.Ceiling(TotalFollowUps / (double)_pageSize);

    private int SafeCurrentPage =>
        Math.Min(Math.Max(_currentPage, 1), TotalPages);

    private int PageStart =>
        TotalFollowUps == 0
            ? 0
            : ((SafeCurrentPage - 1) * _pageSize) + 1;

    private int PageEnd =>
        TotalFollowUps == 0
            ? 0
            : Math.Min(SafeCurrentPage * _pageSize, TotalFollowUps);

    private List<InvoiceFollowUpItemViewModel> PaginatedItems =>
        OrderedItems
            .Skip((SafeCurrentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();

    private string PreviousPageClass =>
        _currentPage <= 1 ? "follow-page-btn is-disabled" : "follow-page-btn";

    private string NextPageClass =>
        _currentPage >= TotalPages ? "follow-page-btn is-disabled" : "follow-page-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("invoice-follow-ups"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        await LoadFollowUpsAsync();
    }

    private async Task LoadFollowUpsAsync()
    {
        _loading = true;
        _openActionInvoiceId = null;

        _items = await InvoiceFollowUpService.GetFollowUpsAsync(
            _searchTerm,
            _followUpStatusFilter,
            _reminderFilter);

        _summary = InvoiceFollowUpService.BuildSummary(_items);

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadFollowUpsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private void FollowStatusChanged(ChangeEventArgs e)
    {
        _followUpStatusFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private void ReminderFilterChanged(ChangeEventArgs e)
    {
        _reminderFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = null;
        _followUpStatusFilter = "all";
        _reminderFilter = "all";
        _currentPage = 1;

        await LoadFollowUpsAsync();
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            _openActionInvoiceId = null;
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            _openActionInvoiceId = null;
        }
    }

    private void ToggleActionMenu(int invoiceId)
    {
        _openActionInvoiceId = _openActionInvoiceId == invoiceId ? null : invoiceId;
    }

    private void OpenFollowUpModal(InvoiceFollowUpItemViewModel item)
    {
        _openActionInvoiceId = null;

        _followModel = new UpdateInvoiceFollowUpModel
        {
            InvoiceId = item.Id,
            FollowUpStatus = item.FollowUpStatus == "Not Started"
                ? "Contacted"
                : item.FollowUpStatus,
            NextFollowUpDate = item.NextFollowUpDate ?? DateTime.Today.AddDays(2),
            FollowUpNotes = item.FollowUpNotes
        };

        _activeInvoiceNumber = item.InvoiceNumber;
        _activeBalanceDue = item.BalanceDue;
        _showFollowModal = true;
    }

    private void CloseFollowUpModal()
    {
        _showFollowModal = false;
    }

    private async Task SaveFollowUpAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        var result = await InvoiceFollowUpService.UpdateFollowUpAsync(_followModel);

        _saving = false;

        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            _showFollowModal = false;
            _currentPage = 1;
            await LoadFollowUpsAsync();
        }
    }

    private void ViewInvoice(int invoiceId)
    {
        _openActionInvoiceId = null;
        NavigationManager.NavigateTo($"/invoices/print/{invoiceId}");
    }

    private string Money(decimal value)
    {
        return $"{CurrencyLabel} {value:0.00}";
    }

    private string GetFollowStatusClass(string status)
    {
        return status switch
        {
            "Not Started" => "not-started",
            "Contacted" => "contacted",
            "Promised to Pay" => "promised",
            "No Response" => "no-response",
            "Disputed" => "disputed",
            "Escalated" => "escalated",
            _ => "not-started"
        };
    }

    private string GetNextFollowUpClass(DateTime nextDate)
    {
        return nextDate.Date < DateTime.Today
            ? "follow-next-overdue"
            : "follow-next-due";
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }
}