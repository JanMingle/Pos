@page "/invoice-follow-ups"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Invoices
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject InvoiceFollowUpService InvoiceFollowUpService
@inject InvoiceService InvoiceService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Invoice Follow-ups</PageTitle>

<section class="follow-page">
    <div class="follow-top">
        <div>
            <div class="follow-kicker">
                <i class="bi bi-calendar-check"></i>
                Collection reminders
            </div>

            <h1>Invoice Follow-ups</h1>
            <p>Track customer follow-ups for unpaid and partially paid invoices.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="follow-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="follow-summary-grid">
        <div class="follow-summary-card hero">
            <div class="follow-summary-icon">
                <i class="bi bi-wallet2"></i>
            </div>
            <span>Outstanding</span>
            <strong>@_summary.TotalOutstanding</strong>
            <small>@Money(_summary.OutstandingBalance) due</small>
        </div>

        <div class="follow-summary-card">
            <div class="follow-summary-icon amber">
                <i class="bi bi-bell"></i>
            </div>
            <span>Due for Follow-up</span>
            <strong>@_summary.DueForFollowUp</strong>
            <small>Today or overdue</small>
        </div>

        <div class="follow-summary-card">
            <div class="follow-summary-icon green">
                <i class="bi bi-calendar-check"></i>
            </div>
            <span>Promised to Pay</span>
            <strong>@_summary.PromisedToPay</strong>
            <small>Invoices marked promised</small>
        </div>

        <div class="follow-summary-card">
            <div class="follow-summary-icon red">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
            <span>Escalated</span>
            <strong>@_summary.Escalated</strong>
            <small>Needs urgent attention</small>
        </div>
    </div>

    <div class="follow-control-panel">
        <div class="follow-search">
            <i class="bi bi-search"></i>
            <input @bind="_searchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search invoice, customer, phone or email" />
        </div>

        <select value="@_followUpStatusFilter" @onchange="FollowStatusChanged">
            <option value="all">All follow-up statuses</option>
            <option value="Not Started">Not Started</option>
            <option value="Contacted">Contacted</option>
            <option value="Promised to Pay">Promised to Pay</option>
            <option value="No Response">No Response</option>
            <option value="Disputed">Disputed</option>
            <option value="Escalated">Escalated</option>
        </select>

        <select value="@_reminderFilter" @onchange="ReminderFilterChanged">
            <option value="all">All reminders</option>
            <option value="due-today">Due today</option>
            <option value="overdue-follow-up">Follow-up overdue</option>
            <option value="no-follow-up-date">No follow-up date</option>
            <option value="overdue-invoice">Invoice overdue</option>
        </select>

        <button type="button" class="follow-secondary-btn" @onclick="ApplyFiltersAsync">
            <i class="bi bi-filter"></i>
            Filter
        </button>

        <button type="button" class="follow-ghost-btn" @onclick="ResetFiltersAsync">
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
        </button>
    </div>

    <div class="follow-table-card">
        <div class="follow-table-header">
            <div>
                <h2>Follow-up List</h2>
                <p>Showing @PageStart - @PageEnd of @TotalFollowUps follow-up@(FollowUpPlural).</p>
            </div>
        </div>

        @if (_loading)
        {
            <div class="follow-empty">
                <div class="follow-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading follow-ups...</strong>
                <span>Please wait while we load outstanding invoice follow-ups.</span>
            </div>
        }
        else if (_items.Count == 0)
        {
            <div class="follow-empty">
                <div class="follow-empty-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <strong>No follow-ups found</strong>
                <span>No outstanding invoices match the selected filters.</span>
            </div>
        }
        else
        {
            <div class="follow-table-wrap">
                <table class="follow-table">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Contact</th>
                            <th>Due</th>
                            <th>Balance</th>
                            <th>Follow-up</th>
                            <th>Next</th>
                            <th>Count</th>
                            <th class="follow-actions-col">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in PaginatedItems)
                        {
                            <tr>
                                <td>
                                    <strong>@item.InvoiceNumber</strong>
                                    <span class="follow-muted">@item.Status</span>
                                </td>

                                <td>@item.CustomerName</td>

                                <td>
                                    <span class="follow-muted">@(!string.IsNullOrWhiteSpace(item.CustomerPhone) ? item.CustomerPhone : "-")</span>
                                    <span class="follow-muted">@(!string.IsNullOrWhiteSpace(item.CustomerEmail) ? item.CustomerEmail : "-")</span>
                                </td>

                                <td>
                                    @(item.DueDate?.ToString("yyyy-MM-dd") ?? "-")
                                    @if (item.DaysOverdue > 0)
                                    {
                                        <span class="follow-muted danger">@item.DaysOverdue day(s) overdue</span>
                                    }
                                </td>

                                <td class="follow-money">@Money(item.BalanceDue)</td>

                                <td>
                                    <span class="follow-pill @GetFollowStatusClass(item.FollowUpStatus)">
                                        @item.FollowUpStatus
                                    </span>

                                    @if (item.LastFollowUpAt.HasValue)
                                    {
                                        <span class="follow-muted">Last: @item.LastFollowUpAt.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                </td>

                                <td>
                                    @if (item.NextFollowUpDate.HasValue)
                                    {
                                        <span class="@GetNextFollowUpClass(item.NextFollowUpDate.Value)">
                                            @item.NextFollowUpDate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="follow-muted">Not set</span>
                                    }
                                </td>

                                <td>@item.FollowUpCount</td>

                                <td class="follow-actions-cell">
                                    <div class="follow-action-menu">
                                        <button type="button"
                                                class="follow-action-toggle"
                                                @onclick="() => ToggleActionMenu(item.Id)">
                                            <span>Actions</span>
                                            <i class="bi bi-chevron-down"></i>
                                        </button>

                                        @if (_openActionInvoiceId == item.Id)
                                        {
                                            <div class="follow-action-dropdown">
                                                <button type="button" @onclick="() => OpenFollowUpModal(item)">
                                                    <i class="bi bi-pencil-square"></i>
                                                    <span>Update follow-up</span>
                                                </button>

                                                <button type="button" @onclick="() => ViewInvoice(item.Id)">
                                                    <i class="bi bi-receipt"></i>
                                                    <span>View invoice</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="follow-pagination">
                <div class="follow-page-info">
                    Showing
                    <strong>@PageStart</strong>
                    -
                    <strong>@PageEnd</strong>
                    of
                    <strong>@TotalFollowUps</strong>
                </div>

                <div class="follow-page-controls">
                    <button type="button"
                            class="@PreviousPageClass"
                            @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="follow-page-count">
                        Page @_currentPage of @TotalPages
                    </span>

                    <button type="button"
                            class="@NextPageClass"
                            @onclick="NextPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

@if (_showFollowModal)
{
    <div class="follow-modal-backdrop">
        <div class="follow-modal">
            <div class="follow-modal-header">
                <div>
                    <span>Follow-up</span>
                    <h4>@_activeInvoiceNumber</h4>
                    <p>Balance due: @Money(_activeBalanceDue)</p>
                </div>

                <button type="button" class="follow-close-btn" @onclick="CloseFollowUpModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="follow-form-grid">
                <div>
                    <label>Status</label>
                    <select @bind="_followModel.FollowUpStatus">
                        <option value="Contacted">Contacted</option>
                        <option value="Promised to Pay">Promised to Pay</option>
                        <option value="No Response">No Response</option>
                        <option value="Disputed">Disputed</option>
                        <option value="Escalated">Escalated</option>
                    </select>
                </div>

                <div>
                    <label>Next Follow-up Date</label>
                    <input type="date" @bind="_followModel.NextFollowUpDate" />
                </div>

                <div class="span-2">
                    <label>Notes</label>
                    <textarea @bind="_followModel.FollowUpNotes" placeholder="Example: Customer promised to pay on Friday."></textarea>
                </div>
            </div>

            <button type="button" class="follow-primary-btn full mt @(_saving ? "is-disabled" : "")" @onclick="SaveFollowUpAsync">
                <i class="bi bi-check-circle"></i>
                @(_saving ? "Saving..." : "Save Follow-up")
            </button>
        </div>
    </div>
}

<style>
    .follow-page {
        animation: followIn .22s ease both;
    }

    .follow-top {
        margin-bottom: 16px;
    }

    .follow-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .follow-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .follow-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .follow-primary-btn,
    .follow-secondary-btn,
    .follow-ghost-btn,
    .follow-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        transition: transform .18s ease;
    }

    .follow-primary-btn {
        color: #fff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17,24,39,.12);
    }

    .follow-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .follow-ghost-btn,
    .follow-page-btn {
        color: #475569;
        background: #fff;
        border: 1px solid #e5e7eb;
    }

        .follow-primary-btn:hover,
        .follow-secondary-btn:hover,
        .follow-ghost-btn:hover,
        .follow-page-btn:hover {
            transform: translateY(-1px);
        }

        .follow-primary-btn.is-disabled,
        .follow-page-btn.is-disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }

    .follow-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .follow-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .follow-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .follow-alert span {
            flex: 1;
        }

        .follow-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .follow-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .follow-summary-card {
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
    }

        .follow-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

        .follow-summary-card span,
        .follow-summary-card strong,
        .follow-summary-card small {
            display: block;
        }

        .follow-summary-card span {
            margin-top: 11px;
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .follow-summary-card strong {
            margin-top: 6px;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 760;
            letter-spacing: -.02em;
        }

        .follow-summary-card small {
            margin-top: 4px;
            color: #98a2b3;
            font-size: .72rem;
            line-height: 1.35;
        }

        .follow-summary-card.hero span,
        .follow-summary-card.hero strong,
        .follow-summary-card.hero small {
            color: #ffffff;
        }

    .follow-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .follow-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .follow-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

        .follow-summary-icon.red {
            color: #d92d20;
            background: #fef3f2;
        }

    .follow-control-panel {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 190px 190px auto auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17,24,39,.035);
    }

        .follow-control-panel select,
        .follow-form-grid input,
        .follow-form-grid select,
        .follow-form-grid textarea {
            width: 100%;
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #fff;
            color: #111827;
            padding: 0 12px;
            font-size: 16px;
            outline: none;
        }

    .follow-search {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #e5e7eb;
        color: #98a2b3;
    }

        .follow-search input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            color: #111827;
            font-size: 16px;
        }

    .follow-table-card {
        overflow: visible;
        border-radius: 22px;
        background: #fff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
    }

    .follow-table-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
    }

        .follow-table-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .follow-table-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .follow-table-wrap {
        overflow-x: auto;
        padding-bottom: 100px;
    }

    .follow-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: collapse;
    }

        .follow-table th {
            padding: 12px 16px;
            background: #fafafa;
            color: #667085;
            font-size: .7rem;
            font-weight: 750;
            text-transform: uppercase;
            border-bottom: 1px solid #e8eaef;
            white-space: nowrap;
        }

        .follow-table td {
            padding: 14px 16px;
            color: #334155;
            font-size: .82rem;
            border-bottom: 1px solid #f1f2f5;
            vertical-align: middle;
        }

    .follow-muted {
        display: block;
        color: #667085;
        font-size: .74rem;
        margin-top: 2px;
    }

        .follow-muted.danger {
            color: #d92d20;
        }

    .follow-money {
        color: #111827;
        font-weight: 760;
    }

    .follow-pill,
    .follow-next-due,
    .follow-next-overdue {
        display: inline-flex;
        min-height: 27px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 750;
        white-space: nowrap;
    }

        .follow-pill.not-started {
            color: #667085;
            background: #f3f4f6;
        }

        .follow-pill.contacted {
            color: #2563eb;
            background: #eff6ff;
        }

        .follow-pill.promised {
            color: #15803d;
            background: #ecfdf5;
        }

        .follow-pill.no-response {
            color: #b7791f;
            background: #fffbeb;
        }

        .follow-pill.disputed,
        .follow-pill.escalated {
            color: #d92d20;
            background: #fef3f2;
        }

    .follow-next-due {
        color: #2563eb;
        background: #eff6ff;
    }

    .follow-next-overdue {
        color: #d92d20;
        background: #fef3f2;
    }

    .follow-actions-col,
    .follow-actions-cell {
        text-align: right;
    }

    .follow-actions-cell {
        position: relative;
        min-width: 150px;
    }

    .follow-action-menu {
        position: relative;
        display: inline-block;
    }

    .follow-action-toggle {
        min-height: 34px;
        border-radius: 11px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #252525;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 11px;
        font-size: .74rem;
        font-weight: 750;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(17, 24, 39, .04);
    }

    .follow-action-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 195px;
        padding: 7px;
        border-radius: 15px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 18px 38px rgba(17, 24, 39, .14);
        z-index: 100;
        display: grid;
        gap: 4px;
        text-align: left;
    }

        .follow-action-dropdown button {
            width: 100%;
            min-height: 36px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #344054;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 10px;
            font-size: .78rem;
            font-weight: 650;
            text-align: left;
        }

            .follow-action-dropdown button:hover {
                background: #fafafa;
                color: #252525;
            }

            .follow-action-dropdown button i {
                width: 18px;
                color: #8FA6A1;
            }

    .follow-empty {
        margin: 18px;
        padding: 34px 20px;
        border-radius: 18px;
        background: #fafafa;
        border: 1px dashed #d0d5dd;
        text-align: center;
    }

    .follow-empty-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 16px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .follow-empty strong,
    .follow-empty span {
        display: block;
    }

    .follow-empty strong {
        color: #111827;
        font-size: .9rem;
        font-weight: 720;
    }

    .follow-empty span {
        margin-top: 4px;
        color: #667085;
        font-size: .78rem;
    }

    .follow-pagination {
        padding: 14px 18px;
        border-top: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        border-radius: 0 0 22px 22px;
    }

    .follow-page-info {
        color: #667085;
        font-size: .78rem;
        font-weight: 600;
    }

        .follow-page-info strong {
            color: #111827;
        }

    .follow-page-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .follow-page-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding: 0 11px;
        border-radius: 11px;
        background: #fafafa;
        border: 1px solid #e8eaef;
        color: #667085;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .follow-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1050;
        padding: 20px;
        background: rgba(15, 23, 42, .44);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        overflow-y: auto;
    }

    .follow-modal {
        width: 100%;
        max-width: 650px;
        max-height: none;
        margin-top: 10px;
        margin-bottom: 20px;
        padding: 22px;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .24);
    }

    .follow-modal-header {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding-bottom: 16px;
        margin-bottom: 18px;
        border-bottom: 1px solid #edf2f7;
    }

        .follow-modal-header span {
            color: #8FA6A1;
            font-size: .72rem;
            font-weight: 750;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .follow-modal-header h4 {
            margin: 3px 0 0;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 720;
        }

        .follow-modal-header p {
            margin: 5px 0 0;
            color: #667085;
            font-size: .84rem;
        }

    .follow-close-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
