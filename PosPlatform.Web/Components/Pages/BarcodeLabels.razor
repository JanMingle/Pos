@page "/barcode-labels"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Products
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject ProductService ProductService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Barcode Labels</PageTitle>

<section class="labels-page">
    <div class="labels-top">
        <div>
            <div class="labels-kicker">
                <i class="bi bi-upc-scan"></i>
                Barcode printing
            </div>

            <h1>Barcode Labels</h1>
            <p>Search products, scan barcodes, prepare a print queue and print labels quickly.</p>
        </div>

        <button type="button"
                class="labels-primary-btn"
                disabled="@(_queue.Count == 0 ? "disabled" : null)"
                @onclick="PrintLabelsAsync">
            <i class="bi bi-printer"></i>
            Print Labels
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="labels-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="labels-summary-grid">
        <div class="labels-summary-card hero">
            <div class="labels-summary-icon">
                <i class="bi bi-printer"></i>
            </div>
            <span>Total Labels</span>
            <strong>@TotalLabels</strong>
            <small>Ready to print</small>
        </div>

        <div class="labels-summary-card">
            <div class="labels-summary-icon green">
                <i class="bi bi-box-seam"></i>
            </div>
            <span>Products Loaded</span>
            <strong>@_products.Count</strong>
            <small>Current search result</small>
        </div>

        <div class="labels-summary-card">
            <div class="labels-summary-icon blue">
                <i class="bi bi-list-check"></i>
            </div>
            <span>Queue Items</span>
            <strong>@_queue.Count</strong>
            <small>Products selected</small>
        </div>

        <div class="labels-summary-card">
            <div class="labels-summary-icon amber">
                <i class="bi bi-currency-exchange"></i>
            </div>
            <span>Currency</span>
            <strong>@CurrencyLabel</strong>
            <small>@_settings.CurrencyCode</small>
        </div>
    </div>

    <div class="labels-barcode-row">
        <div class="labels-barcode-box">
            <i class="bi bi-upc-scan"></i>
            <input @bind="_barcodeValue"
                   @bind:event="oninput"
                   @onkeydown="HandleBarcodeKeyDown"
                   placeholder="Scan barcode or type SKU, then press Enter" />
        </div>

        <button type="button"
                class="labels-primary-btn"
                disabled="@(_barcodeScanning ? "disabled" : null)"
                @onclick="ScanBarcodeAsync">
            <i class="bi bi-upc"></i>
            @(_barcodeScanning ? "Checking..." : "Find Item")
        </button>
    </div>

    <div class="labels-control-panel">
        <div class="labels-search">
            <i class="bi bi-search"></i>
            <input @bind="_searchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search by product name, SKU, barcode or type" />
        </div>

        <button type="button" class="labels-secondary-btn" @onclick="LoadProductsAsync">
            <i class="bi bi-search"></i>
            Search
        </button>

        <button type="button" class="labels-ghost-btn" @onclick="ResetSearchAsync">
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
        </button>
    </div>

    <div class="labels-grid">
        <div class="labels-panel">
            <div class="labels-panel-header">
                <div>
                    <h2>Products</h2>
                    <p>Showing @PageStart - @PageEnd of @TotalProducts product@(@TotalProducts == 1 ? "" : "s").</p>
                </div>

                <span class="labels-status-note">
                    <i class="bi bi-shield-check"></i>
                    Tenant scoped
                </span>
            </div>

            @if (_loading)
            {
                <div class="labels-empty">
                    <div class="labels-empty-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <strong>Loading products...</strong>
                    <span>Please wait while we fetch catalogue items.</span>
                </div>
            }
            else if (_products.Count == 0)
            {
                <div class="labels-empty">
                    <div class="labels-empty-icon">
                        <i class="bi bi-box"></i>
                    </div>
                    <strong>No products found</strong>
                    <span>Search by product name, SKU or barcode.</span>
                </div>
            }
            else
            {
                <div class="labels-table-wrap">
                    <table class="labels-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Barcode</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th class="labels-actions-col">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in PaginatedProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="labels-product-cell">
                                            <div class="labels-avatar">@GetInitials(item.ProductName)</div>
                                            <div>
                                                <strong>@item.ProductName</strong>
                                                <span>@item.ProductType</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="labels-code">@item.SKU</span>
                                    </td>

                                    <td>
                                        <span class="labels-code">
                                            @(string.IsNullOrWhiteSpace(item.Barcode) ? "No barcode" : item.Barcode)
                                        </span>
                                    </td>

                                    <td class="labels-price">@Money(item.SellingPrice)</td>

                                    <td>
                                        <span class="labels-pill @(item.IsActive ? "active" : "inactive")">
                                            @(item.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>

                                    <td class="labels-actions-cell">
                                        <button type="button"
                                                class="labels-mini-btn"
                                                disabled="@(string.IsNullOrWhiteSpace(GetPrintableCode(item)) ? "disabled" : null)"
                                                @onclick="() => AddToQueue(item)">
                                            <i class="bi bi-plus-lg"></i>
                                            Add Label
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="labels-pagination">
                    <div class="labels-page-info">
                        Showing
                        <strong>@PageStart</strong>
                        -
                        <strong>@PageEnd</strong>
                        of
                        <strong>@TotalProducts</strong>
                    </div>

                    <div class="labels-page-controls">
                        <button type="button"
                                class="labels-page-btn"
                                disabled="@(_currentPage <= 1 ? "disabled" : null)"
                                @onclick="PreviousPage">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </button>

                        <span class="labels-page-count">
                            Page @_currentPage of @TotalPages
                        </span>

                        <button type="button"
                                class="labels-page-btn"
                                disabled="@(_currentPage >= TotalPages ? "disabled" : null)"
                                @onclick="NextPage">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="labels-panel labels-queue-panel">
            <div class="labels-panel-header">
                <div>
                    <h2>Print Queue</h2>
                    <p>@_queue.Count product@((_queue.Count == 1) ? "" : "s") selected.</p>
                </div>

                @if (_queue.Count > 0)
                {
                    <button type="button" class="labels-ghost-btn small" @onclick="ClearQueue">
                        Clear
                    </button>
                }
            </div>

            @if (_queue.Count == 0)
            {
                <div class="labels-empty">
                    <div class="labels-empty-icon">
                        <i class="bi bi-printer"></i>
                    </div>
                    <strong>No labels selected</strong>
                    <span>Add products from the list to prepare labels for printing.</span>
                </div>
            }
            else
            {
                <div class="labels-queue">
                    @foreach (var item in _queue)
                    {
                        <div class="labels-queue-item">
                            <div class="labels-queue-main">
                                <strong>@item.ProductName</strong>
                                <span>@item.Code</span>
                                <small>@Money(item.SellingPrice)</small>
                            </div>

                            <div class="labels-qty-box">
                                <label>Qty</label>
                                <input type="number" min="1" max="500" @bind="item.Quantity" />
                            </div>

                            <button type="button" class="labels-remove-btn" @onclick="() => RemoveFromQueue(item)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    }
                </div>

                <div class="labels-print-footer">
                    <div>
                        <span>Total labels</span>
                        <strong>@TotalLabels</strong>
                    </div>

                    <button type="button"
                            class="labels-primary-btn"
                            disabled="@(_queue.Count == 0 ? "disabled" : null)"
                            @onclick="PrintLabelsAsync">
                        <i class="bi bi-printer"></i>
                        Print Labels
                    </button>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .labels-page {
        animation: labelsIn .22s ease both;
    }

    .labels-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .labels-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .labels-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .labels-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .labels-primary-btn,
    .labels-secondary-btn,
    .labels-ghost-btn,
    .labels-mini-btn,
    .labels-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        text-decoration: none;
        transition: transform .18s ease;
    }

    .labels-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17, 24, 39, .12);
    }

    .labels-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .labels-ghost-btn,
    .labels-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

        .labels-ghost-btn.small {
            min-height: 32px;
            padding: 0 10px;
            font-size: .74rem;
        }

    .labels-mini-btn {
        min-height: 32px;
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
        padding: 0 10px;
        font-size: .74rem;
    }

        .labels-primary-btn:hover,
        .labels-secondary-btn:hover,
        .labels-ghost-btn:hover,
        .labels-mini-btn:hover,
        .labels-page-btn:hover {
            transform: translateY(-1px);
        }

        .labels-primary-btn:disabled,
        .labels-mini-btn:disabled,
        .labels-page-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
        }

    .labels-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .labels-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .labels-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .labels-alert span {
            flex: 1;
        }

        .labels-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .labels-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .labels-summary-card {
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
    }

        .labels-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

        .labels-summary-card span,
        .labels-summary-card strong,
        .labels-summary-card small {
            display: block;
        }

        .labels-summary-card span {
            margin-top: 11px;
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .labels-summary-card strong {
            margin-top: 6px;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 760;
            letter-spacing: -.02em;
        }

        .labels-summary-card small {
            margin-top: 4px;
            color: #98a2b3;
            font-size: .72rem;
            line-height: 1.35;
        }

        .labels-summary-card.hero span,
        .labels-summary-card.hero strong,
        .labels-summary-card.hero small {
            color: #ffffff;
        }

    .labels-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .labels-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .labels-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .labels-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

    .labels-barcode-row,
    .labels-control-panel {
        display: grid;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17, 24, 39, .035);
    }

    .labels-barcode-row {
        grid-template-columns: minmax(240px, 1fr) auto;
    }

    .labels-control-panel {
        grid-template-columns: minmax(240px, 1fr) auto auto;
    }

    .labels-barcode-box {
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 15px;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
        color: #8FA6A1;
    }

    .labels-search {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #e5e7eb;
        color: #98a2b3;
    }

        .labels-barcode-box input,
        .labels-search input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            color: #111827;
            font-size: 16px;
        }

    .labels-barcode-box input {
        font-weight: 650;
    }

    .labels-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(340px, .65fr);
        gap: 16px;
        align-items: start;
    }

    .labels-panel {
        background: #ffffff;
        border: 1px solid #e8eaef;
        border-radius: 22px;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
        overflow: hidden;
    }

    .labels-queue-panel {
        position: sticky;
        top: 88px;
    }

    .labels-panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .labels-panel-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .labels-panel-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .labels-status-note {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border-radius: 999px;
        color: #8FA6A1;
        background: #f2f6f5;
        font-size: .74rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .labels-table-wrap {
        overflow-x: auto;
    }

    .labels-table {
        width: 100%;
        min-width: 840px;
        border-collapse: collapse;
    }

        .labels-table th {
            padding: 12px 16px;
            background: #fafafa;
            color: #667085;
            font-size: .7rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 1px solid #e8eaef;
            white-space: nowrap;
        }

        .labels-table td {
            padding: 14px 16px;
            color: #334155;
            font-size: .82rem;
            border-bottom: 1px solid #f1f2f5;
            vertical-align: middle;
        }

    .labels-product-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .labels-avatar {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 750;
    }

    .labels-product-cell strong,
    .labels-product-cell span {
        display: block;
    }

    .labels-product-cell strong {
        color: #111827;
        font-size: .85rem;
        font-weight: 720;
    }

    .labels-product-cell span {
        margin-top: 2px;
        color: #98a2b3;
        font-size: .72rem;
    }

    .labels-code {
        display: inline-flex;
        min-height: 27px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        color: #475569;
        background: #fafafa;
        border: 1px solid #e8eaef;
        font-size: .72rem;
        font-weight: 650;
    }

    .labels-price {
        color: #111827;
        font-weight: 750;
    }

    .labels-pill {
        display: inline-flex;
        min-height: 27px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 750;
    }

        .labels-pill.active {
            color: #15803d;
            background: #ecfdf5;
        }

        .labels-pill.inactive {
            color: #667085;
            background: #f3f4f6;
        }

    .labels-actions-col,
    .labels-actions-cell {
        text-align: right;
    }

    .labels-queue {
        padding: 14px 18px;
        display: grid;
        gap: 10px;
        max-height: 520px;
        overflow-y: auto;
    }

    .labels-queue-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 76px auto;
        gap: 10px;
        align-items: center;
        padding: 13px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid #e8eaef;
    }

    .labels-queue-main strong,
    .labels-queue-main span,
    .labels-queue-main small {
        display: block;
    }

    .labels-queue-main strong {
        color: #111827;
        font-size: .84rem;
        font-weight: 720;
    }

    .labels-queue-main span {
        margin-top: 3px;
        color: #667085;
        font-size: .72rem;
    }

    .labels-queue-main small {
        margin-top: 4px;
        color: #111827;
        font-size: .78rem;
        font-weight: 750;
    }

    .labels-qty-box label {
        display: block;
        margin-bottom: 4px;
        color: #667085;
        font-size: .68rem;
        font-weight: 700;
    }

    .labels-qty-box input {
        width: 70px;
        min-height: 34px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
        padding: 0 9px;
        font-size: 16px;
        outline: none;
    }

    .labels-remove-btn {
        width: 36px;
        height: 36px;
        border-radius: 11px;
        border: 1px solid #fecaca;
        background: #fef3f2;
        color: #d92d20;
    }

    .labels-print-footer {
        padding: 14px 18px 18px;
        border-top: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .labels-print-footer span,
        .labels-print-footer strong {
            display: block;
        }

        .labels-print-footer span {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .labels-print-footer strong {
            margin-top: 3px;
            color: #111827;
            font-size: .96rem;
            font-weight: 750;
        }

    .labels-empty {
        margin: 18px;
        padding: 34px 20px;
        border-radius: 18px;
        background: #fafafa;
        border: 1px dashed #d0d5dd;
        text-align: center;
    }

    .labels-empty-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 16px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .labels-empty strong,
    .labels-empty span {
        display: block;
    }

    .labels-empty strong {
        color: #111827;
        font-size: .9rem;
        font-weight: 720;
    }

    .labels-empty span {
        margin-top: 4px;
        color: #667085;
        font-size: .78rem;
    }

    .labels-pagination {
        padding: 14px 18px;
        border-top: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #ffffff;
    }

    .labels-page-info {
        color: #667085;
        font-size: .78rem;
        font-weight: 600;
    }

        .labels-page-info strong {
            color: #111827;
        }

    .labels-page-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .labels-page-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding: 0 11px;
        border-radius: 11px;
        background: #fafafa;
