@code {
    private List<StockProductRowViewModel> _products = new();
    private List<StockMovementRowViewModel> _movements = new();
    private List<BranchOptionViewModel> _branches = new();

    private StockSummaryViewModel _summary = new();
    private BusinessSettingsFormModel _settings = new();

    private StockAdjustmentModel _adjustment = new()
    {
        AdjustmentType = "Stock In",
        Quantity = 1
    };

    private bool _loadingStock = true;
    private bool _loadingMovements = true;
    private bool _savingAdjustment;

    private string? _searchTerm;
    private string _statusFilter = "all";
    private int? _branchFilter;
    private string? _barcodeValue;
    private bool _barcodeScanning;

    private DateTime? _fromDate = DateTime.Today;
    private DateTime? _toDate = DateTime.Today;

    private string? _message;
    private bool _isSuccess;

    private int _stockPage = 1;
    private int _stockPageSize = 10;

    private int _movementPage = 1;
    private int _movementPageSize = 10;

    private bool StockEnabled => _settings.StockTrackingEnabled;

    private int TotalStockProducts => _products.Count;

    private string StockItemWord => TotalStockProducts == 1 ? "item" : "items";

    private int StockTotalPages =>
        TotalStockProducts == 0
            ? 1
            : (int)Math.Ceiling(TotalStockProducts / (double)_stockPageSize);

    private int SafeStockPage =>
        Math.Min(Math.Max(_stockPage, 1), StockTotalPages);

    private int StockPageStart =>
        TotalStockProducts == 0
            ? 0
            : ((SafeStockPage - 1) * _stockPageSize) + 1;

    private int StockPageEnd =>
        TotalStockProducts == 0
            ? 0
            : Math.Min(SafeStockPage * _stockPageSize, TotalStockProducts);

    private List<StockProductRowViewModel> PaginatedStockProducts =>
        _products
            .Skip((SafeStockPage - 1) * _stockPageSize)
            .Take(_stockPageSize)
            .ToList();

    private string PreviousStockPageClass =>
        _stockPage <= 1 ? "stock-page-btn is-disabled" : "stock-page-btn";

    private string NextStockPageClass =>
        _stockPage >= StockTotalPages ? "stock-page-btn is-disabled" : "stock-page-btn";

    private List<StockMovementRowViewModel> OrderedMovements =>
        _movements
            .OrderByDescending(x => x.CreatedAt)
            .ToList();

    private int TotalMovements => OrderedMovements.Count;

    private string MovementPlural => TotalMovements == 1 ? "" : "s";

    private int MovementTotalPages =>
        TotalMovements == 0
            ? 1
            : (int)Math.Ceiling(TotalMovements / (double)_movementPageSize);

    private int SafeMovementPage =>
        Math.Min(Math.Max(_movementPage, 1), MovementTotalPages);

    private int MovementPageStart =>
        TotalMovements == 0
            ? 0
            : ((SafeMovementPage - 1) * _movementPageSize) + 1;

    private int MovementPageEnd =>
        TotalMovements == 0
            ? 0
            : Math.Min(SafeMovementPage * _movementPageSize, TotalMovements);

    private List<StockMovementRowViewModel> PaginatedMovements =>
        OrderedMovements
            .Skip((SafeMovementPage - 1) * _movementPageSize)
            .Take(_movementPageSize)
            .ToList();

    private string PreviousMovementPageClass =>
        _movementPage <= 1 ? "stock-page-btn is-disabled" : "stock-page-btn";

    private string NextMovementPageClass =>
        _movementPage >= MovementTotalPages ? "stock-page-btn is-disabled" : "stock-page-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("stock"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        _branches = await BranchService.GetBranchOptionsAsync();

        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        if (StockEnabled)
        {
            await LoadStockAsync();
        }
        else
        {
            _products = new List<StockProductRowViewModel>();
            _summary = new StockSummaryViewModel();
            _loadingStock = false;
        }

        await LoadMovementsAsync();
    }

    private async Task LoadStockAsync()
    {
        _loadingStock = true;

        _products = await StockService.GetStockProductsAsync(_searchTerm, _statusFilter, _branchFilter);
        _summary = await StockService.GetStockSummaryAsync(_branchFilter);

        if (_stockPage > StockTotalPages)
        {
            _stockPage = StockTotalPages;
        }

        _loadingStock = false;
    }

    private async Task LoadMovementsAsync()
    {
        _loadingMovements = true;

        _movements = await StockService.GetMovementsAsync(_fromDate, _toDate, _searchTerm, _branchFilter);

        if (_movementPage > MovementTotalPages)
        {
            _movementPage = MovementTotalPages;
        }

        _loadingMovements = false;
    }

    private async Task ApplyStockFiltersAsync()
    {
        _stockPage = 1;
        _movementPage = 1;

        await LoadStockAsync();
        await LoadMovementsAsync();
    }

    private async Task ApplyMovementFiltersAsync()
    {
        _movementPage = 1;
        await LoadMovementsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyStockFiltersAsync();
        }
    }

    private void StatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "all";
        _stockPage = 1;
    }

    private void NextStockPage()
    {
        if (_stockPage < StockTotalPages)
        {
            _stockPage++;
        }
    }

    private void PreviousStockPage()
    {
        if (_stockPage > 1)
        {
            _stockPage--;
        }
    }

    private void NextMovementPage()
    {
        if (_movementPage < MovementTotalPages)
        {
            _movementPage++;
        }
    }

    private void PreviousMovementPage()
    {
        if (_movementPage > 1)
        {
            _movementPage--;
        }
    }

    private async Task HandleBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ScanBarcodeAsync();
        }
    }

    private async Task ScanBarcodeAsync()
    {
        if (_barcodeScanning)
        {
            return;
        }

        var code = _barcodeValue?.Trim();

        if (string.IsNullOrWhiteSpace(code))
        {
            ShowMessage("Scan or type a barcode/SKU first.", false);
            return;
        }

        _barcodeScanning = true;

        _searchTerm = code;
        _statusFilter = "all";
        _stockPage = 1;
        _movementPage = 1;

        await LoadStockAsync();
        await LoadMovementsAsync();

        _barcodeScanning = false;

        if (_products.Count == 0)
        {
            ShowMessage($"No stock item found for barcode or SKU: {code}", false);
            return;
        }

        ShowMessage($"{_products.Count} stock item found for: {code}", true);
        _barcodeValue = null;
    }

    private void OpenAdjustment()
    {
        _adjustment = new StockAdjustmentModel
        {
            AdjustmentType = "Stock In",
            Quantity = 1
        };
    }

    private void OpenAdjustment(int productId)
    {
        _adjustment = new StockAdjustmentModel
        {
            ProductId = productId,
            AdjustmentType = "Stock In",
            Quantity = 1
        };
    }

    private async Task SaveAdjustmentAsync()
    {
        if (_savingAdjustment)
        {
            return;
        }

        _savingAdjustment = true;

        var result = await StockService.AdjustStockAsync(_adjustment);

        _savingAdjustment = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            _adjustment = new StockAdjustmentModel
            {
                AdjustmentType = "Stock In",
                Quantity = 1
            };

            _stockPage = 1;
            _movementPage = 1;

            await LoadAllAsync();
        }
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = null;
        _barcodeValue = null;
        _statusFilter = "all";
        _branchFilter = null;
        _stockPage = 1;
        _movementPage = 1;

        await LoadAllAsync();
    }

    private string Money(decimal value)
    {
        var symbol = string.IsNullOrWhiteSpace(_settings.CurrencySymbol)
            ? "R"
            : _settings.CurrencySymbol;

        return $"{symbol} {value:0.00}";
    }

    private string GetTypeClass(string? productType)
    {
        return productType switch
        {
            "Service" => "service",
            "Package / Bundle" => "package",
            "Voucher" => "voucher",
            "Digital Product" => "digital",
            _ => "physical"
        };
    }

    private string GetMovementClass(string movementType)
    {
        return movementType switch
        {
            "Sale" => "blue",
            "Purchase" => "success",
            "Stock In" => "success",
            "Stock Out" => "warning",
            "Correction" => "gray",
            _ => "gray"
        };
    }

    private string GetUnitLabel(string? unit)
    {
        return string.IsNullOrWhiteSpace(unit) ? "" : unit;
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }

    private string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "P";
        }

        var words = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(x => x[0].ToString().ToUpper());

        return string.Join("", words);
    }
}