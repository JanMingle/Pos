@page "/stock"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Stock
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Models.Branches
@using PosPlatform.Web.Services
@inject StockService StockService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject BranchService BranchService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Stock</PageTitle>

<section class="stock-page">
    <div class="stock-top">
        <div>
            <div class="stock-kicker">
                <i class="bi bi-boxes"></i>
                Inventory control
            </div>

            <h1>Stock Management</h1>
            <p>Monitor stock-tracked items, scan SKU/barcodes, adjust quantities and review stock movement history.</p>
        </div>

        @if (StockEnabled)
        {
            <button type="button" class="stock-primary-btn" @onclick="OpenAdjustment">
                <i class="bi bi-plus-lg"></i>
                New Adjustment
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="stock-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="stock-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Business Type</span>
            <strong>@_settings.BusinessType</strong>
        </div>

        <div>
            <span>Currency</span>
            <strong>@_settings.CurrencyCode · @_settings.CurrencySymbol</strong>
        </div>

        <div>
            <span>Stock Tracking</span>
            <strong>@(StockEnabled ? "Enabled" : "Disabled")</strong>
        </div>
    </div>

    @if (!StockEnabled)
    {
        <div class="stock-settings-warning">
            <div>
                <strong>Stock tracking is disabled</strong>
                <span>Enable stock tracking in Business Settings if this business needs inventory control.</span>
            </div>

            <a href="/settings" class="stock-settings-link">
                Open Settings
            </a>
        </div>
    }
    else
    {
        <div class="stock-summary-grid">
            <div class="stock-summary-card hero">
                <div class="stock-summary-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <span>Stock Items</span>
                <strong>@_summary.TotalStockItems</strong>
                <small>Tracked inventory items</small>
            </div>

            <div class="stock-summary-card">
                <div class="stock-summary-icon blue">
                    <i class="bi bi-stack"></i>
                </div>
                <span>Total Units</span>
                <strong>@_summary.TotalUnits.ToString("0.##")</strong>
                <small>Units currently available</small>
            </div>

            <div class="stock-summary-card">
                <div class="stock-summary-icon amber">
                    <i class="bi bi-exclamation-circle"></i>
                </div>
                <span>Low Stock</span>
                <strong>@_summary.LowStockItems</strong>
                <small>Items needing attention</small>
            </div>

            <div class="stock-summary-card">
                <div class="stock-summary-icon red">
                    <i class="bi bi-x-octagon"></i>
                </div>
                <span>Out of Stock</span>
                <strong>@_summary.OutOfStockItems</strong>
                <small>Unavailable items</small>
            </div>

            <div class="stock-summary-card">
                <div class="stock-summary-icon green">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <span>Stock Value</span>
                <strong>@Money(_summary.TotalStockValue)</strong>
                <small>Cost value of inventory</small>
            </div>
        </div>

        <div class="stock-barcode-row">
            <div class="stock-barcode-box">
                <i class="bi bi-upc-scan"></i>
                <input @bind="_barcodeValue"
                       @bind:event="oninput"
                       @onkeydown="HandleBarcodeKeyDown"
                       placeholder="Scan barcode or type SKU, then press Enter" />
            </div>

            <button type="button"
                    class="stock-primary-btn"
                    @onclick="ScanBarcodeAsync">
                <i class="bi bi-upc"></i>
                @(_barcodeScanning ? "Checking..." : "Find Item")
            </button>
        </div>

        <div class="stock-control-panel">
            <div class="stock-search">
                <i class="bi bi-search"></i>
                <input @bind="_searchTerm"
                       @bind:event="oninput"
                       @onkeydown="HandleSearchKeyDown"
                       placeholder="Search stock item, SKU, barcode or type" />
            </div>

            <select class="stock-filter" value="@_statusFilter" @onchange="StatusFilterChanged">
                <option value="all">All stock</option>
                <option value="healthy">Healthy stock</option>
                <option value="low">Low stock</option>
                <option value="out">Out of stock</option>
                <option value="active">Active items</option>
                <option value="inactive">Inactive items</option>
            </select>

            <select class="stock-branch-filter" @bind="_branchFilter">
                <option value="">All branches</option>
                @foreach (var branch in _branches)
                {
                    <option value="@branch.Id">
                        @branch.Name
                        @if (branch.IsMainBranch)
                        {
                            @(" · Main")
                        }
                    </option>
                }
            </select>

            <button type="button" class="stock-secondary-btn" @onclick="ApplyStockFiltersAsync">
                <i class="bi bi-filter"></i>
                Apply
            </button>

            <button type="button" class="stock-ghost-btn" @onclick="ResetFiltersAsync">
                <i class="bi bi-arrow-counterclockwise"></i>
                Reset
            </button>
        </div>

        <div class="stock-grid">
            <div class="stock-panel">
                <div class="stock-panel-header">
                    <div>
                        <h2>Current Stock</h2>
                        <p>Showing @StockPageStart - @StockPageEnd of @TotalStockProducts stock @StockItemWord.</p>
                    </div>

                    <span class="stock-status-note">
                        <i class="bi bi-shield-check"></i>
                        Tenant scoped
                    </span>
                </div>

                @if (_loadingStock)
                {
                    <div class="stock-empty">
                        <div class="stock-empty-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <strong>Loading stock...</strong>
                        <span>Please wait while we fetch inventory records.</span>
                    </div>
                }
                else if (_products.Count == 0)
                {
                    <div class="stock-empty">
                        <div class="stock-empty-icon">
                            <i class="bi bi-box"></i>
                        </div>
                        <strong>No stock-tracked items found</strong>
                        <span>Only items with Track Stock enabled appear here.</span>
                    </div>
                }
                else
                {
                    <div class="stock-table-wrap">
                        <table class="stock-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Available</th>
                                    <th>Reorder</th>
                                    <th>Value</th>
                                    <th>Status</th>
                                    <th class="stock-actions-col">Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in PaginatedStockProducts)
                                {
                                    <tr>
                                        <td>
                                            <div class="stock-product-cell">
                                                <div class="stock-avatar">@GetInitials(item.ProductName)</div>
                                                <div>
                                                    <strong>@item.ProductName</strong>
                                                    <span>@item.SKU</span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="stock-type-pill @GetTypeClass(item.ProductType)">
                                                @item.ProductType
                                            </span>

                                            @if (item.AgeRestricted)
                                            {
                                                <span class="stock-age-pill">Age</span>
                                            }
                                        </td>

                                        <td>@(string.IsNullOrWhiteSpace(item.CategoryName) ? "Uncategorised" : item.CategoryName)</td>
                                        <td>@item.QuantityInStock.ToString("0.##") @GetUnitLabel(item.UnitOfMeasure)</td>
                                        <td>@item.ReorderLevel.ToString("0.##") @GetUnitLabel(item.UnitOfMeasure)</td>
                                        <td class="stock-money">@Money(item.StockValue)</td>

                                        <td>
                                            @if (item.IsOutOfStock)
                                            {
                                                <span class="stock-pill danger">Out</span>
                                            }
                                            else if (item.IsLowStock)
                                            {
                                                <span class="stock-pill warning">Low</span>
                                            }
                                            else
                                            {
                                                <span class="stock-pill success">Healthy</span>
                                            }
                                        </td>

                                        <td class="stock-actions-cell">
                                            <button type="button" class="stock-mini-btn" @onclick="() => OpenAdjustment(item.ProductId)">
                                                <i class="bi bi-pencil-square"></i>
                                                Adjust
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="stock-pagination">
                        <div class="stock-page-info">
                            Showing
                            <strong>@StockPageStart</strong>
                            -
                            <strong>@StockPageEnd</strong>
                            of
                            <strong>@TotalStockProducts</strong>
                        </div>

                        <div class="stock-page-controls">
                            <button type="button"
                                    class="@PreviousStockPageClass"
                                    @onclick="PreviousStockPage">
                                <i class="bi bi-chevron-left"></i>
                                Previous
                            </button>

                            <span class="stock-page-count">
                                Page @_stockPage of @StockTotalPages
                            </span>

                            <button type="button"
                                    class="@NextStockPageClass"
                                    @onclick="NextStockPage">
                                Next
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="stock-panel stock-adjustment-panel">
                <div class="stock-panel-header">
                    <div>
                        <h2>Manual Adjustment</h2>
                        <p>Adjust stock quantities for the selected branch and item.</p>
                    </div>
                </div>

                <EditForm Model="_adjustment" OnValidSubmit="SaveAdjustmentAsync">
                    <DataAnnotationsValidator />

                    <div class="stock-adjustment-form">
                        <div>
                            <label>Stock Item</label>
                            <InputSelect class="stock-input" @bind-Value="_adjustment.ProductId">
                                <option value="0">Select stock item</option>
                                @foreach (var product in _products)
                                {
                                    <option value="@product.ProductId">
                                        @product.ProductName (@product.SKU) - @product.QuantityInStock.ToString("0.##") @GetUnitLabel(product.UnitOfMeasure)
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div>
                            <label>Adjustment Type</label>
                            <InputSelect class="stock-input" @bind-Value="_adjustment.AdjustmentType">
                                <option value="Stock In">Stock In</option>
                                <option value="Stock Out">Stock Out</option>
                                <option value="Correction">Correction</option>
                            </InputSelect>
                        </div>

                        @if (_adjustment.AdjustmentType == "Correction")
                        {
                            <div>
                                <label>New Quantity</label>
                                <InputNumber class="stock-input" @bind-Value="_adjustment.NewQuantity" />
                            </div>
                        }
                        else
                        {
                            <div>
                                <label>Quantity</label>
                                <InputNumber class="stock-input" @bind-Value="_adjustment.Quantity" />
                            </div>
                        }

                        <div>
                            <label>Notes</label>
                            <InputTextArea class="stock-input stock-textarea"
                                           @bind-Value="_adjustment.Notes"
                                           placeholder="Example: Supplier delivery, damaged item, manual correction..." />
                        </div>

                        <ValidationSummary class="stock-validation" />

                        <button type="submit" class="stock-primary-btn">
                            <i class="bi bi-check2-circle"></i>
                            @(_savingAdjustment ? "Saving..." : "Save Adjustment")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="stock-panel stock-history-panel">
        <div class="stock-panel-header stock-history-header">
            <div>
                <h2>Stock Movement History</h2>
                <p>Showing @MovementPageStart - @MovementPageEnd of @TotalMovements movement@MovementPlural.</p>
            </div>

            <div class="stock-date-filters">
                <input type="date" @bind="_fromDate" />
                <input type="date" @bind="_toDate" />

                <select class="stock-branch-filter" @bind="_branchFilter">
                    <option value="">All branches</option>
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Id">
                            @branch.Name
                            @if (branch.IsMainBranch)
                            {
                                @(" · Main")
                            }
                        </option>
                    }
                </select>

                <button type="button" class="stock-secondary-btn" @onclick="ApplyMovementFiltersAsync">
                    <i class="bi bi-filter"></i>
                    Filter
                </button>
            </div>
        </div>

        @if (_loadingMovements)
        {
            <div class="stock-empty">
                <div class="stock-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading movements...</strong>
                <span>Please wait.</span>
            </div>
        }
        else if (_movements.Count == 0)
        {
            <div class="stock-empty">
                <div class="stock-empty-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <strong>No movements found</strong>
                <span>Stock changes will appear here after sales, purchases or manual adjustments.</span>
            </div>
        }
        else
        {
            <div class="stock-table-wrap">
                <table class="stock-table movement-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Item</th>
                            <th>Type</th>
                            <th>Movement</th>
                            <th>Qty</th>
                            <th>Before</th>
                            <th>After</th>
                            <th>Reference</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var movement in PaginatedMovements)
                        {
                            <tr>
                                <td>@movement.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <strong>@movement.ProductName</strong>
                                    <span class="stock-muted">@movement.SKU</span>
                                </td>
                                <td>
                                    <span class="stock-type-pill @GetTypeClass(movement.ProductType)">
                                        @movement.ProductType
                                    </span>
                                </td>
                                <td>
                                    <span class="stock-pill @GetMovementClass(movement.MovementType)">
                                        @movement.MovementType
                                    </span>
                                </td>
                                <td>@movement.Quantity.ToString("0.##") @GetUnitLabel(movement.UnitOfMeasure)</td>
                                <td>@movement.QuantityBefore.ToString("0.##")</td>
                                <td>@movement.QuantityAfter.ToString("0.##")</td>
                                <td>@movement.ReferenceType @movement.ReferenceId</td>
                                <td>@movement.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="stock-pagination">
                <div class="stock-page-info">
                    Showing
                    <strong>@MovementPageStart</strong>
                    -
                    <strong>@MovementPageEnd</strong>
                    of
                    <strong>@TotalMovements</strong>
                </div>

                <div class="stock-page-controls">
                    <button type="button"
                            class="@PreviousMovementPageClass"
                            @onclick="PreviousMovementPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="stock-page-count">
                        Page @_movementPage of @MovementTotalPages
                    </span>

                    <button type="button"
                            class="@NextMovementPageClass"
                            @onclick="NextMovementPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .stock-page {
        animation: stockIn .22s ease both;
    }

    .stock-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .stock-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .stock-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .stock-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .stock-primary-btn,
    .stock-secondary-btn,
    .stock-ghost-btn,
    .stock-mini-btn,
    .stock-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        transition: transform .18s ease;
        white-space: nowrap;
    }

    .stock-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17, 24, 39, .12);
    }

    .stock-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .stock-ghost-btn,
    .stock-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .stock-mini-btn {
        min-height: 32px;
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
        padding: 0 10px;
        font-size: .74rem;
    }

        .stock-primary-btn:hover,
        .stock-secondary-btn:hover,
        .stock-ghost-btn:hover,
        .stock-mini-btn:hover,
        .stock-page-btn:hover {
            transform: translateY(-1px);
        }

    .stock-page-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .stock-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .stock-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .stock-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .stock-alert span {
            flex: 1;
        }

        .stock-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .stock-settings-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
    }

        .stock-settings-strip div {
            padding: 13px;
            border-radius: 16px;
            background: #ffffff;
            border: 1px solid #e8eaef;
            box-shadow: 0 10px 24px rgba(17, 24, 39, .035);
        }

        .stock-settings-strip span,
        .stock-settings-strip strong {
            display: block;
        }

        .stock-settings-strip span {
            color: #98a2b3;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .stock-settings-strip strong {
            margin-top: 4px;
            color: #111827;
            font-size: .84rem;
            font-weight: 720;
        }

    .stock-settings-warning {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
        padding: 16px;
        border-radius: 18px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
    }

        .stock-settings-warning strong,
        .stock-settings-warning span {
            display: block;
        }

        .stock-settings-warning strong {
            color: #9a3412;
            font-size: .9rem;
            font-weight: 750;
        }

        .stock-settings-warning span {
            margin-top: 3px;
            color: #c2410c;
            font-size: .78rem;
        }

    .stock-settings-link {
        min-height: 36px;
        border-radius: 10px;
        padding: 0 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #252525;
        color: #ffffff;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .stock-summary-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .stock-summary-card {
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
    }

        .stock-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

        .stock-summary-card span,
        .stock-summary-card strong,
        .stock-summary-card small {
            display: block;
        }

        .stock-summary-card span {
            margin-top: 11px;
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .stock-summary-card strong {
            margin-top: 6px;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 760;
            letter-spacing: -.02em;
        }

        .stock-summary-card small {
            margin-top: 4px;
            color: #98a2b3;
            font-size: .72rem;
            line-height: 1.35;
        }

        .stock-summary-card.hero span,
        .stock-summary-card.hero strong,
        .stock-summary-card.hero small {
            color: #ffffff;
        }

    .stock-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .stock-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .stock-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .stock-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

        .stock-summary-icon.red {
            color: #d92d20;
            background: #fef3f2;
        }

    .stock-barcode-row {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17, 24, 39, .035);
    }

    .stock-barcode-box {
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 15px;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
        color: #8FA6A1;
    }

        .stock-barcode-box input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            color: #111827;
            font-size: 16px;
            font-weight: 650;
        }

    .stock-control-panel {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 170px 190px auto auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
