@code {
    private List<UserListItemViewModel> _users = new();
    private List<RoleOptionViewModel> _roles = new();
    private List<BranchOptionViewModel> _branches = new();

    private UserFormModel _form = new()
    {
        RoleName = "Sales User"
    };

    private bool _loading = true;
    private bool _saving;
    private bool _showModal;

    private bool _showStatusConfirm;
    private bool _savingStatus;

    private string? _searchTerm;
    private string _roleFilter = "all";
    private int? _branchFilter;

    private string? _message;
    private bool _isSuccess;

    private int _currentPage = 1;
    private string _rowsMode = "10";
    private int? _openActionUserId;

    private int _statusUserId;
    private string _statusUserEmail = string.Empty;
    private bool _statusUserIsDisabled;

    private bool ShowAllRows =>
        _rowsMode.Equals("all", StringComparison.OrdinalIgnoreCase);

    private int PageSize => ParseRows(_rowsMode);

    private List<UserListItemViewModel> OrderedUsers =>
        _users
            .OrderBy(x => x.IsDisabled)
            .ThenBy(x => x.RoleName)
            .ThenBy(x => x.Email)
            .ToList();

    private int TotalUserRows => OrderedUsers.Count;

    private int TotalPages =>
        TotalUserRows == 0 || ShowAllRows
            ? 1
            : (int)Math.Ceiling(TotalUserRows / (double)PageSize);

    private int SafeCurrentPage =>
        Math.Min(Math.Max(_currentPage, 1), TotalPages);

    private int PageStart =>
        TotalUserRows == 0
            ? 0
            : ShowAllRows
                ? 1
                : ((SafeCurrentPage - 1) * PageSize) + 1;

    private int PageEnd =>
        TotalUserRows == 0
            ? 0
            : ShowAllRows
                ? TotalUserRows
                : Math.Min(SafeCurrentPage * PageSize, TotalUserRows);

    private List<UserListItemViewModel> PaginatedUsers =>
        ShowAllRows
            ? OrderedUsers
            : OrderedUsers
                .Skip((SafeCurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();

    private string PreviousPageClass =>
        _currentPage <= 1 || ShowAllRows
            ? "users-page-btn is-disabled"
            : "users-page-btn";

    private string NextPageClass =>
        _currentPage >= TotalPages || ShowAllRows
            ? "users-page-btn is-disabled"
            : "users-page-btn";

    private string SaveButtonClass =>
        _saving
            ? "users-primary-btn is-disabled"
            : "users-primary-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("users"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _roles = await UserManagementService.GetRoleOptionsAsync();
        _branches = await UserManagementService.GetBranchesAsync();

        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        _openActionUserId = null;

        _users = await UserManagementService.GetUsersAsync(_searchTerm, _roleFilter, _branchFilter);

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadUsersAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private void RoleFilterChanged(ChangeEventArgs e)
    {
        _roleFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private void BranchFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        _branchFilter = int.TryParse(value, out var branchId)
            ? branchId
            : null;

        _currentPage = 1;
    }

    private void RowsChanged(ChangeEventArgs e)
    {
        _rowsMode = e.Value?.ToString() ?? "10";
        _currentPage = 1;
    }

    private void NextPage()
    {
        if (!ShowAllRows && _currentPage < TotalPages)
        {
            _currentPage++;
            _openActionUserId = null;
        }
    }

    private void PreviousPage()
    {
        if (!ShowAllRows && _currentPage > 1)
        {
            _currentPage--;
            _openActionUserId = null;
        }
    }

    private void ToggleActionMenu(int userId)
    {
        _openActionUserId = _openActionUserId == userId ? null : userId;
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = null;
        _roleFilter = "all";
        _branchFilter = null;
        _currentPage = 1;

        await LoadUsersAsync();
    }

    private void OpenAddModal()
    {
        _openActionUserId = null;

        _form = new UserFormModel
        {
            RoleName = "Sales User",
            BranchId = _branches.FirstOrDefault(x => x.IsMainBranch)?.Id
                ?? _branches.FirstOrDefault()?.Id
        };

        _showModal = true;
    }

    private async Task OpenEditModal(int id)
    {
        _openActionUserId = null;

        var model = await UserManagementService.GetUserFormAsync(id);

        if (model == null)
        {
            ShowMessage("User not found.", false);
            return;
        }

        _form = model;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _form = new UserFormModel
        {
            RoleName = "Sales User"
        };
    }

    private async Task SaveUserAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        var result = await UserManagementService.SaveUserAsync(_form);

        _saving = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            CloseModal();
            _currentPage = 1;
            await LoadUsersAsync();
        }
    }

    private void ConfirmToggleUserStatus(int userId, string email, bool isDisabled)
    {
        _openActionUserId = null;

        _statusUserId = userId;
        _statusUserEmail = email;
        _statusUserIsDisabled = isDisabled;
        _showStatusConfirm = true;
    }

    private void CancelToggleUserStatus()
    {
        _showStatusConfirm = false;
        _savingStatus = false;

        _statusUserId = 0;
        _statusUserEmail = string.Empty;
        _statusUserIsDisabled = false;
    }

    private async Task ToggleUserStatusConfirmedAsync()
    {
        if (_statusUserId <= 0)
        {
            CancelToggleUserStatus();
            return;
        }

        _savingStatus = true;

        var result = await UserManagementService.ToggleUserStatusAsync(_statusUserId);

        _savingStatus = false;

        ShowMessage(result.Message, result.Success);

        var shouldReload = result.Success;

        CancelToggleUserStatus();

        if (shouldReload)
        {
            await LoadUsersAsync();
        }
    }

    private int ParseRows(string value)
    {
        return int.TryParse(value, out var rows) && rows > 0
            ? rows
            : 10;
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }

    private string GetRoleDescription(string roleName)
    {
        return _roles.FirstOrDefault(x => x.Name == roleName)?.Description ?? "";
    }

    private string GetRoleClass(string roleName)
    {
        return roleName switch
        {
            "Owner" => "owner",
            "Admin" => "admin",
            "Sales User" => "sales",
            "Inventory User" => "inventory",
            "Accounting User" => "accounting",
            "Manager" => "manager",
            "Viewer" => "viewer",
            _ => "viewer"
        };
    }

    private string GetRoleIcon(string roleName)
    {
        return roleName switch
        {
            "Owner" => "bi-gem",
            "Admin" => "bi-shield-lock",
            "Sales User" => "bi-cart-check",
            "Inventory User" => "bi-boxes",
            "Accounting User" => "bi-calculator",
            "Manager" => "bi-person-badge",
            "Viewer" => "bi-eye",
            _ => "bi-person"
        };
    }

    private string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "U";
        }

        var emailName = value.Split('@')[0];

        var words = emailName
            .Split(new[] { '.', '-', '_' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(x => x[0].ToString().ToUpper());

        var result = string.Join("", words);

        return string.IsNullOrWhiteSpace(result) ? "U" : result;
    }
}