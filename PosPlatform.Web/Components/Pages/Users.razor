@page "/users"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Users
@using PosPlatform.Web.Services
@inject UserManagementService UserManagementService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Users</PageTitle>

<section class="users-page">
    <div class="users-top">
        <div>
            <div class="users-kicker">
                <i class="bi bi-people"></i>
                Access control
            </div>

            <h1>User Management</h1>
            <p>Create users, assign roles, control access and keep your POS operations secure.</p>
        </div>

        <button type="button" class="users-primary-btn" @onclick="OpenAddModal">
            <i class="bi bi-person-plus"></i>
            Add User
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="users-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="users-role-grid">
        @foreach (var role in _roles)
        {
            <div class="users-role-card">
                <div class="users-role-icon @GetRoleClass(role.Name)">
                    <i class="bi @GetRoleIcon(role.Name)"></i>
                </div>

                <div>
                    <strong>@role.Name</strong>
                    <span>@role.Description</span>
                </div>
            </div>
        }
    </div>

    <div class="users-control-panel">
        <div class="users-search">
            <i class="bi bi-search"></i>
            <input @bind="_searchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search email or phone number" />
        </div>

        <select class="users-filter" value="@_roleFilter" @onchange="RoleFilterChanged">
            <option value="all">All roles</option>
            @foreach (var role in _roles)
            {
                <option value="@role.Name">@role.Name</option>
            }
        </select>

        <select class="users-filter"
                value="@(_branchFilter?.ToString() ?? "")"
                @onchange="BranchFilterChanged">
            <option value="">All branches</option>
            @foreach (var branch in _branches)
            {
                <option value="@branch.Id">
                    @branch.Name
                    @if (branch.IsMainBranch)
                    {
                        @(" · Main")
                    }
                </option>
            }
        </select>

        <button type="button" class="users-secondary-btn" @onclick="ApplyFiltersAsync">
            <i class="bi bi-filter"></i>
            Apply
        </button>

        <button type="button" class="users-ghost-btn" @onclick="ResetFiltersAsync">
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
        </button>
    </div>

    <div class="users-panel">
        <div class="users-panel-header">
            <div>
                <h2>System Users</h2>
                <p>Showing @PageStart - @PageEnd of @TotalUserRows user@(TotalUserRows == 1 ? "" : "s").</p>
            </div>

            <div class="users-rows-tool">
                <label>Rows</label>
                <select value="@_rowsMode" @onchange="RowsChanged">
                    <option value="10">10 rows</option>
                    <option value="25">25 rows</option>
                    <option value="50">50 rows</option>
                    <option value="all">Show all</option>
                </select>
            </div>
        </div>

        @if (_loading)
        {
            <div class="users-empty">
                <div class="users-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading users...</strong>
                <span>Please wait while we fetch user records.</span>
            </div>
        }
        else if (_users.Count == 0)
        {
            <div class="users-empty">
                <div class="users-empty-icon">
                    <i class="bi bi-people"></i>
                </div>
                <strong>No users found</strong>
                <span>Create your first user or adjust the filters.</span>
            </div>
        }
        else
        {
            <div class="users-table-wrap">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Branch</th>
                            <th>Status</th>
                            <th class="users-actions-col">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in PaginatedUsers)
                        {
                            <tr>
                                <td>
                                    <div class="users-user-cell">
                                        <div class="users-avatar">@GetInitials(user.Email)</div>
                                        <div>
                                            <strong>@user.Email</strong>
                                            <span>ID: @user.Id</span>
                                        </div>
                                    </div>
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>

                                <td>
                                    <span class="users-role-pill @GetRoleClass(user.RoleName)">
                                        @user.RoleName
                                    </span>
                                </td>

                                <td>@user.BranchName</td>

                                <td>
                                    <span class="users-status-pill @(user.IsDisabled ? "disabled" : "active")">
                                        @user.Status
                                    </span>
                                </td>

                                <td class="users-actions-cell">
                                    <div class="users-action-menu">
                                        <button type="button"
                                                class="users-action-toggle"
                                                @onclick="() => ToggleActionMenu(user.Id)">
                                            <span>Actions</span>
                                            <i class="bi bi-chevron-down"></i>
                                        </button>

                                        @if (_openActionUserId == user.Id)
                                        {
                                            <div class="users-action-dropdown">
                                                <button type="button" @onclick="() => OpenEditModal(user.Id)">
                                                    <i class="bi bi-pencil"></i>
                                                    <span>Edit user</span>
                                                </button>

                                                <button type="button" @onclick="() => ConfirmToggleUserStatus(user.Id, user.Email, user.IsDisabled)">
                                                    <i class="bi @(user.IsDisabled ? "bi-unlock" : "bi-lock")"></i>
                                                    <span>@(user.IsDisabled ? "Activate user" : "Disable user")</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="users-pagination">
                <div class="users-page-info">
                    Showing
                    <strong>@PageStart</strong>
                    -
                    <strong>@PageEnd</strong>
                    of
                    <strong>@TotalUserRows</strong>
                </div>

                <div class="users-page-controls">
                    <button type="button" class="@PreviousPageClass" @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="users-page-count">
                        @(ShowAllRows ? "Showing all" : $"Page {_currentPage} of {TotalPages}")
                    </span>

                    <button type="button" class="@NextPageClass" @onclick="NextPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

@if (_showModal)
{
    <div class="users-modal-backdrop">
        <div class="users-modal">
            <div class="users-modal-header">
                <div>
                    <span>User setup</span>
                    <h4>@(_form.Id.HasValue ? "Edit User" : "Add User")</h4>
                    <p>Assign the user to a branch and select the correct operational role.</p>
                </div>

                <button type="button" class="users-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_form" OnValidSubmit="SaveUserAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="users-validation" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="users-label">Email Address</label>
                        <InputText class="users-input" @bind-Value="_form.Email" />
                    </div>

                    <div class="col-md-6">
                        <label class="users-label">Phone Number</label>
                        <InputText class="users-input" @bind-Value="_form.PhoneNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="users-label">Role</label>
                        <InputSelect class="users-input" @bind-Value="_form.RoleName">
                            @foreach (var role in _roles)
                            {
                                <option value="@role.Name">@role.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="users-label">Branch</label>
                        <InputSelect class="users-input" @bind-Value="_form.BranchId">
                            <option value="">Default branch</option>
                            @foreach (var branch in _branches)
                            {
                                <option value="@branch.Id">@branch.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="users-label">
                            Password @(_form.Id.HasValue ? "(leave blank to keep current)" : "")
                        </label>
                        <InputText type="password" class="users-input" @bind-Value="_form.Password" />
                    </div>

                    <div class="col-md-6">
                        <label class="users-label">Confirm Password</label>
                        <InputText type="password" class="users-input" @bind-Value="_form.ConfirmPassword" />
                    </div>
                </div>

                <div class="users-role-help">
                    <strong>@_form.RoleName</strong>
                    <span>@GetRoleDescription(_form.RoleName)</span>
                </div>

                <div class="users-modal-actions">
                    <button type="button" class="users-ghost-btn" @onclick="CloseModal">Cancel</button>

                    <button type="submit" class="@SaveButtonClass">
                        <i class="bi bi-check2-circle"></i>
                        @(_saving ? "Saving..." : "Save User")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showStatusConfirm)
{
    <div class="users-modal-backdrop">
        <div class="users-modal users-status-modal">
            <div class="users-status-confirm-icon @(_statusUserIsDisabled ? "activate" : "disable")">
                <i class="bi @(_statusUserIsDisabled ? "bi-unlock" : "bi-lock")"></i>
            </div>

            <h4>@(_statusUserIsDisabled ? "Activate User?" : "Disable User?")</h4>

            <p>
                Are you sure you want to
                <strong>@(_statusUserIsDisabled ? "activate" : "disable") @_statusUserEmail</strong>?
            </p>

            <div class="users-confirm-summary">
                <div>
                    <span>User</span>
                    <strong>@_statusUserEmail</strong>
                </div>

                <div>
                    <span>New Status</span>
                    <strong>@(_statusUserIsDisabled ? "Active" : "Disabled")</strong>
                </div>
            </div>

            <div class="users-modal-note @(_statusUserIsDisabled ? "activate" : "disable")">
                <i class="bi bi-info-circle"></i>
                <span>
                    @if (_statusUserIsDisabled)
                    {
                        @("This user will regain access based on their assigned role and branch.")
                    }
                    else
                    {
                        @("This user will no longer be able to access the system until activated again.")
                    }
                </span>
            </div>

            <div class="users-modal-actions">
                <button type="button" class="users-ghost-btn" @onclick="CancelToggleUserStatus">
                    Cancel
                </button>

                <button type="button"
                        class="@(_statusUserIsDisabled ? "users-primary-btn" : "users-danger-btn")"
                        disabled="@_savingStatus"
                        @onclick="ToggleUserStatusConfirmedAsync">
                    <i class="bi @(_statusUserIsDisabled ? "bi-unlock" : "bi-lock")"></i>
                    @(_savingStatus ? "Updating..." : (_statusUserIsDisabled ? "Yes, Activate" : "Yes, Disable"))
                </button>
            </div>
        </div>
    </div>
}

<style>
    .users-page {
        animation: usersIn .22s ease both;
    }

    .users-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .users-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .users-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .users-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .users-primary-btn,
    .users-secondary-btn,
    .users-ghost-btn,
    .users-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        transition: transform .18s ease;
        white-space: nowrap;
    }

    .users-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17,24,39,.12);
    }

    .users-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .users-ghost-btn,
    .users-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

        .users-primary-btn:hover,
        .users-secondary-btn:hover,
        .users-ghost-btn:hover,
        .users-page-btn:hover {
            transform: translateY(-1px);
        }

        .users-primary-btn.is-disabled,
        .users-page-btn.is-disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
        }

    .users-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .users-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .users-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .users-alert span {
            flex: 1;
        }

        .users-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .users-role-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .users-role-card {
        display: flex;
        gap: 12px;
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
    }

    .users-role-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .users-role-card strong {
        display: block;
        color: #111827;
        font-size: .86rem;
        font-weight: 720;
    }

    .users-role-card span {
        display: block;
        margin-top: 3px;
        color: #667085;
        font-size: .74rem;
        line-height: 1.35;
    }

    .users-control-panel {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 180px 180px auto auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17,24,39,.035);
    }

    .users-search {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #e5e7eb;
        color: #98a2b3;
    }

        .users-search input,
        .users-filter,
        .users-input,
        .users-rows-tool select {
            width: 100%;
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            color: #111827;
            padding: 0 12px;
            font-size: 16px;
            outline: none;
        }

        .users-search input {
            border: 0;
            background: transparent;
            padding: 0;
        }

    .users-panel {
        background: #ffffff;
        border: 1px solid #e8eaef;
        border-radius: 22px;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
        overflow: visible;
    }

    .users-panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .users-panel-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .users-panel-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .users-rows-tool {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 170px;
    }

        .users-rows-tool label {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

    .users-table-wrap {
        overflow-x: auto;
        padding-bottom: 100px;
    }

    .users-table {
        width: 100%;
        min-width: 860px;
        border-collapse: collapse;
    }

        .users-table th {
            padding: 12px 16px;
            background: #fafafa;
            color: #667085;
            font-size: .7rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 1px solid #e8eaef;
            white-space: nowrap;
        }

        .users-table td {
            padding: 14px 16px;
            color: #334155;
            font-size: .82rem;
            border-bottom: 1px solid #f1f2f5;
            vertical-align: middle;
        }

    .users-user-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .users-avatar {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 750;
    }

    .users-user-cell strong {
        display: block;
        color: #111827;
        font-size: .85rem;
        font-weight: 720;
    }

    .users-user-cell span {
        display: block;
        margin-top: 2px;
        color: #98a2b3;
        font-size: .72rem;
    }

    .users-role-pill,
    .users-status-pill {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 750;
        white-space: nowrap;
    }

        .users-role-pill.owner,
        .users-role-icon.owner {
            color: #be123c;
            background: #fff1f2;
        }

        .users-role-pill.admin,
        .users-role-icon.admin {
            color: #2563eb;
            background: #eff6ff;
        }

        .users-role-pill.sales,
        .users-role-icon.sales {
            color: #16a34a;
            background: #ecfdf5;
        }

        .users-role-pill.inventory,
        .users-role-icon.inventory {
            color: #d97706;
            background: #fffbeb;
        }

        .users-role-pill.accounting,
        .users-role-icon.accounting {
            color: #7c3aed;
            background: #f5f3ff;
        }

        .users-role-pill.manager,
        .users-role-icon.manager {
            color: #111827;
            background: #f3f4f6;
        }

        .users-role-pill.viewer,
        .users-role-icon.viewer {
            color: #667085;
            background: #f8fafc;
        }

        .users-status-pill.active {
            color: #15803d;
            background: #ecfdf5;
        }

        .users-status-pill.disabled {
            color: #d92d20;
            background: #fef3f2;
        }

    .users-actions-col,
    .users-actions-cell {
        text-align: right;
    }

    .users-actions-cell {
        position: relative;
        min-width: 150px;
    }

    .users-action-menu {
        position: relative;
        display: inline-block;
    }

    .users-action-toggle {
        min-height: 34px;
        border-radius: 11px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #252525;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 11px;
        font-size: .74rem;
        font-weight: 750;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(17, 24, 39, .04);
    }

    .users-action-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 195px;
        padding: 7px;
        border-radius: 15px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 18px 38px rgba(17, 24, 39, .14);
        z-index: 100;
        display: grid;
        gap: 4px;
        text-align: left;
    }

        .users-action-dropdown button {
            width: 100%;
            min-height: 36px;
            border: 0;
            border-radius: 11px;
            background: transparent;
            color: #344054;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 10px;
            font-size: .78rem;
            font-weight: 650;
            text-align: left;
        }

            .users-action-dropdown button:hover {
                background: #fafafa;
                color: #252525;
            }

            .users-action-dropdown button i {
                width: 18px;
                color: #8FA6A1;
            }

    .users-empty {
        margin: 18px;
        padding: 34px 20px;
        border-radius: 18px;
        background: #fafafa;
        border: 1px dashed #d0d5dd;
        text-align: center;
    }

    .users-empty-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 16px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .users-empty strong,
    .users-empty span {
        display: block;
    }

    .users-empty strong {
        color: #111827;
        font-size: .9rem;
        font-weight: 720;
    }

    .users-empty span {
        margin-top: 4px;
        color: #667085;
        font-size: .78rem;
    }

    .users-pagination {
        padding: 14px 18px;
        border-top: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        border-radius: 0 0 22px 22px;
    }

    .users-page-info {
        color: #667085;
        font-size: .78rem;
        font-weight: 600;
    }

        .users-page-info strong {
            color: #111827;
        }

    .users-page-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .users-page-count {
        min-height: 34px;
