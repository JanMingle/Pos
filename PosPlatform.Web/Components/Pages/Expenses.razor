    private int? _openExpenseActionId;
    private int? _openCategoryActionId;

    private int _deleteExpenseId;
    private string _deleteExpenseNumber = string.Empty;
    private string _deleteExpenseCategory = string.Empty;
    private decimal _deleteExpenseAmount;

    private int _categoryStatusId;
    private string _categoryStatusName = string.Empty;
    private bool _categoryIsActive;

    private int _deleteCategoryId;
    private string _deleteCategoryName = string.Empty;
    private int _deleteCategoryExpenseCount;

    private decimal TotalExpenses => _expenses.Sum(x => x.TotalAmount);
    private decimal TotalTax => _expenses.Sum(x => x.TaxAmount);

    private string CurrencyLabel =>
        string.IsNullOrWhiteSpace(_settings.CurrencySymbol)
            ? "R"
            : _settings.CurrencySymbol;

    private bool ShowAllExpenseRows =>
        _expenseRowsMode.Equals("all", StringComparison.OrdinalIgnoreCase);

    private bool ShowAllCategoryRows =>
        _categoryRowsMode.Equals("all", StringComparison.OrdinalIgnoreCase);

    private int ExpensePageSize => ParseRows(_expenseRowsMode);
    private int CategoryPageSize => ParseRows(_categoryRowsMode);

    private List<ExpenseListItemViewModel> OrderedExpenses =>
        _expenses
            .OrderByDescending(x => x.ExpenseDate)
            .ThenByDescending(x => x.Id)
            .ToList();

    private List<ExpenseCategoryListItemViewModel> OrderedCategories =>
        _categories
            .OrderBy(x => x.CategoryName)
            .ToList();

    private int TotalExpenseRows => OrderedExpenses.Count;
    private int TotalCategoryRows => OrderedCategories.Count;

    private int ExpenseTotalPages =>
        TotalExpenseRows == 0 || ShowAllExpenseRows
            ? 1
            : (int)Math.Ceiling(TotalExpenseRows / (double)ExpensePageSize);

    private int CategoryTotalPages =>
        TotalCategoryRows == 0 || ShowAllCategoryRows
            ? 1
            : (int)Math.Ceiling(TotalCategoryRows / (double)CategoryPageSize);

    private int SafeExpensePage =>
        Math.Min(Math.Max(_expensePage, 1), ExpenseTotalPages);

    private int SafeCategoryPage =>
        Math.Min(Math.Max(_categoryPage, 1), CategoryTotalPages);

    private int ExpensePageStart =>
        TotalExpenseRows == 0
            ? 0
            : ShowAllExpenseRows
                ? 1
                : ((SafeExpensePage - 1) * ExpensePageSize) + 1;

    private int ExpensePageEnd =>
        TotalExpenseRows == 0
            ? 0
            : ShowAllExpenseRows
                ? TotalExpenseRows
                : Math.Min(SafeExpensePage * ExpensePageSize, TotalExpenseRows);

    private int CategoryPageStart =>
        TotalCategoryRows == 0
            ? 0
            : ShowAllCategoryRows
                ? 1
                : ((SafeCategoryPage - 1) * CategoryPageSize) + 1;

    private int CategoryPageEnd =>
        TotalCategoryRows == 0
            ? 0
            : ShowAllCategoryRows
                ? TotalCategoryRows
                : Math.Min(SafeCategoryPage * CategoryPageSize, TotalCategoryRows);

    private List<ExpenseListItemViewModel> PaginatedExpenses =>
        ShowAllExpenseRows
            ? OrderedExpenses
            : OrderedExpenses
                .Skip((SafeExpensePage - 1) * ExpensePageSize)
                .Take(ExpensePageSize)
                .ToList();

    private List<ExpenseCategoryListItemViewModel> PaginatedCategories =>
        ShowAllCategoryRows
            ? OrderedCategories
            : OrderedCategories
                .Skip((SafeCategoryPage - 1) * CategoryPageSize)
                .Take(CategoryPageSize)
                .ToList();

    private string PreviousExpensePageClass =>
        _expensePage <= 1 || ShowAllExpenseRows
            ? "expenses-page-btn is-disabled"
            : "expenses-page-btn";

    private string NextExpensePageClass =>
        _expensePage >= ExpenseTotalPages || ShowAllExpenseRows
            ? "expenses-page-btn is-disabled"
            : "expenses-page-btn";

    private string PreviousCategoryPageClass =>
        _categoryPage <= 1 || ShowAllCategoryRows
            ? "expenses-page-btn is-disabled"
            : "expenses-page-btn";

    private string NextCategoryPageClass =>
        _categoryPage >= CategoryTotalPages || ShowAllCategoryRows
            ? "expenses-page-btn is-disabled"
            : "expenses-page-btn";

    private string ExpenseSaveButtonClass =>
        _savingExpense
            ? "expenses-primary-btn is-disabled"
            : "expenses-primary-btn";

    private string CategorySaveButtonClass =>
        _savingCategory
            ? "expenses-primary-btn is-disabled"
            : "expenses-primary-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("expenses"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        _branches = await BranchService.GetBranchOptionsAsync();

        await LoadCategoriesAsync();
        await LoadExpensesAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        _loadingCategories = true;
        _openCategoryActionId = null;

        _categories = await ExpenseService.GetCategoriesAsync(_categorySearch, _categoryStatus, _branchFilter);
        _categoryOptions = await ExpenseService.GetCategoryOptionsAsync();

        if (_categoryPage > CategoryTotalPages)
        {
            _categoryPage = CategoryTotalPages;
        }

        _loadingCategories = false;
    }

    private async Task LoadExpensesAsync()
    {
        _loadingExpenses = true;
        _openExpenseActionId = null;

        _expenses = await ExpenseService.GetExpensesAsync(_fromDate, _toDate, _expenseSearch, _branchFilter);

        if (_expensePage > ExpenseTotalPages)
        {
            _expensePage = ExpenseTotalPages;
        }

        _loadingExpenses = false;
    }

    private async Task ApplyExpenseFiltersAsync()
    {
        _expensePage = 1;
        _categoryPage = 1;

        await LoadExpensesAsync();
        await LoadCategoriesAsync();
    }

    private async Task ApplyCategoryFiltersAsync()
    {
        _categoryPage = 1;
        await LoadCategoriesAsync();
    }

    private async Task HandleExpenseSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyExpenseFiltersAsync();
        }
    }

    private async Task HandleCategorySearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyCategoryFiltersAsync();
        }
    }

    private void BranchFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        _branchFilter = int.TryParse(value, out var branchId)
            ? branchId
            : null;

        _expensePage = 1;
        _categoryPage = 1;
    }

    private void CategoryStatusChanged(ChangeEventArgs e)
    {
        _categoryStatus = e.Value?.ToString() ?? "all";
        _categoryPage = 1;
    }

    private void ExpenseRowsChanged(ChangeEventArgs e)
    {
        _expenseRowsMode = e.Value?.ToString() ?? "10";
        _expensePage = 1;
    }

    private void CategoryRowsChanged(ChangeEventArgs e)
    {
        _categoryRowsMode = e.Value?.ToString() ?? "10";
        _categoryPage = 1;
    }

    private void NextExpensePage()
    {
        if (!ShowAllExpenseRows && _expensePage < ExpenseTotalPages)
        {
            _expensePage++;
            _openExpenseActionId = null;
        }
    }

    private void PreviousExpensePage()
    {
        if (!ShowAllExpenseRows && _expensePage > 1)
        {
            _expensePage--;
            _openExpenseActionId = null;
        }
    }

    private void NextCategoryPage()
    {
        if (!ShowAllCategoryRows && _categoryPage < CategoryTotalPages)
        {
            _categoryPage++;
            _openCategoryActionId = null;
        }
    }

    private void PreviousCategoryPage()
    {
        if (!ShowAllCategoryRows && _categoryPage > 1)
        {
            _categoryPage--;
            _openCategoryActionId = null;
        }
    }

    private void ToggleExpenseActionMenu(int expenseId)
    {
        _openCategoryActionId = null;
        _openExpenseActionId = _openExpenseActionId == expenseId ? null : expenseId;
    }

    private void ToggleCategoryActionMenu(int categoryId)
    {
        _openExpenseActionId = null;
        _openCategoryActionId = _openCategoryActionId == categoryId ? null : categoryId;
    }

    private void OpenExpenseModal()
    {
        _openExpenseActionId = null;

        _expenseForm = new ExpenseFormModel
        {
            ExpenseDate = DateTime.Today,
            PaymentMethod = "Cash"
        };

        _showExpenseModal = true;
    }

    private async Task EditExpenseAsync(int id)
    {
        _openExpenseActionId = null;

        var model = await ExpenseService.GetExpenseByIdAsync(id);

        if (model == null)
        {
            ShowMessage("Expense not found.", false);
            return;
        }

        _expenseForm = model;
        _showExpenseModal = true;
    }

    private void CloseExpenseModal()
    {
        _showExpenseModal = false;
        _expenseForm = new ExpenseFormModel();
    }

    private async Task SaveExpenseAsync()
    {
        if (_savingExpense)
        {
            return;
        }

        _savingExpense = true;

        var result = await ExpenseService.SaveExpenseAsync(_expenseForm);

        _savingExpense = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            CloseExpenseModal();
            _expensePage = 1;
            await LoadExpensesAsync();
            await LoadCategoriesAsync();
        }
    }

    private void ConfirmDeleteExpense(int id, string expenseNumber, string categoryName, decimal totalAmount)
    {
        _openExpenseActionId = null;

        _deleteExpenseId = id;
        _deleteExpenseNumber = expenseNumber;
        _deleteExpenseCategory = categoryName;
        _deleteExpenseAmount = totalAmount;
        _showDeleteExpenseConfirm = true;
    }

    private void CancelDeleteExpense()
    {
        _showDeleteExpenseConfirm = false;
        _savingDeleteExpense = false;

        _deleteExpenseId = 0;
        _deleteExpenseNumber = string.Empty;
        _deleteExpenseCategory = string.Empty;
        _deleteExpenseAmount = 0;
    }

    private async Task DeleteExpenseConfirmedAsync()
    {
        if (_deleteExpenseId <= 0)
        {
            CancelDeleteExpense();
            return;
        }

        _savingDeleteExpense = true;

        var result = await ExpenseService.DeleteExpenseAsync(_deleteExpenseId);

        _savingDeleteExpense = false;

        ShowMessage(result.Message, result.Success);

        var shouldReload = result.Success;

        CancelDeleteExpense();

        if (shouldReload)
        {
            await LoadExpensesAsync();
            await LoadCategoriesAsync();
        }
    }

    private void ConfirmToggleCategory(int id, string name, bool isActive)
    {
        _openCategoryActionId = null;

        _categoryStatusId = id;
        _categoryStatusName = name;
        _categoryIsActive = isActive;
        _showCategoryStatusConfirm = true;
    }

    private void CancelToggleCategory()
    {
        _showCategoryStatusConfirm = false;
        _savingCategoryStatus = false;

        _categoryStatusId = 0;
        _categoryStatusName = string.Empty;
        _categoryIsActive = false;
    }

    private async Task ToggleCategoryConfirmedAsync()
    {
        if (_categoryStatusId <= 0)
        {
            CancelToggleCategory();
            return;
        }

        _savingCategoryStatus = true;

        var result = await ExpenseService.ToggleCategoryStatusAsync(_categoryStatusId);

        _savingCategoryStatus = false;

        ShowMessage(result.Message, result.Success);

        var shouldReload = result.Success;

        CancelToggleCategory();

        if (shouldReload)
        {
            await LoadCategoriesAsync();
        }
    }

    private void ConfirmDeleteCategory(int id, string name, int expenseCount)
    {
        _openCategoryActionId = null;

        _deleteCategoryId = id;
        _deleteCategoryName = name;
        _deleteCategoryExpenseCount = expenseCount;
        _showDeleteCategoryConfirm = true;
    }

    private void CancelDeleteCategory()
    {
        _showDeleteCategoryConfirm = false;
        _savingDeleteCategory = false;

        _deleteCategoryId = 0;
        _deleteCategoryName = string.Empty;
        _deleteCategoryExpenseCount = 0;
    }

    private async Task DeleteCategoryConfirmedAsync()
    {
        if (_deleteCategoryId <= 0)
        {
            CancelDeleteCategory();
            return;
        }

        _savingDeleteCategory = true;

        var result = await ExpenseService.DeleteCategoryAsync(_deleteCategoryId);

        _savingDeleteCategory = false;

        ShowMessage(result.Message, result.Success);

        var shouldReload = result.Success;

        CancelDeleteCategory();

        if (shouldReload)
        {
            await LoadCategoriesAsync();
        }
    }

    private void OpenCategoryModal()
    {
        _openCategoryActionId = null;

        _categoryForm = new ExpenseCategoryFormModel
        {
            IsActive = true
        };

        _showCategoryModal = true;
    }

    private async Task EditCategoryAsync(int id)
    {
        _openCategoryActionId = null;

        var model = await ExpenseService.GetCategoryByIdAsync(id);

        if (model == null)
        {
            ShowMessage("Expense category not found.", false);
            return;
        }

        _categoryForm = model;
        _showCategoryModal = true;
    }

    private void CloseCategoryModal()
    {
        _showCategoryModal = false;
        _categoryForm = new ExpenseCategoryFormModel();
    }

    private async Task SaveCategoryAsync()
    {
        if (_savingCategory)
        {
            return;
        }

        _savingCategory = true;

        var result = await ExpenseService.SaveCategoryAsync(_categoryForm);

        _savingCategory = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            CloseCategoryModal();
            _categoryPage = 1;
            await LoadCategoriesAsync();
        }
    }

    private string GetCategoryToggleIcon(bool isActive)
    {
        return isActive ? "bi-pause-circle" : "bi-play-circle";
    } 

    private int ParseRows(string value)
    {
        return int.TryParse(value, out var rows) && rows > 0
            ? rows
            : 10;
    }

    private string Money(decimal value)
    {
        return $"{CurrencyLabel} {value:0.00}";
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }
}