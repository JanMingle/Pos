@page "/expenses"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Models.Expenses
@using PosPlatform.Web.Models.Branches
@using PosPlatform.Web.Services
@inject ExpenseService ExpenseService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager
@inject BranchService BranchService

<PageTitle>Expenses</PageTitle>

<section class="expenses-page">
    <div class="expenses-top">
        <div>
            <div class="expenses-kicker">
                <i class="bi bi-wallet2"></i>
                Business expenses
            </div>

            <h1>Expenses</h1>
            <p>Record rent, salaries, transport, electricity, internet, marketing and other business costs.</p>
        </div>

        <div class="expenses-top-actions">
            <button type="button" class="expenses-secondary-btn" @onclick="OpenCategoryModal">
                <i class="bi bi-tags"></i>
                Add Category
            </button>

            <button type="button" class="expenses-primary-btn" @onclick="OpenExpenseModal">
                <i class="bi bi-plus-lg"></i>
                Add Expense
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="expenses-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="expenses-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Business Type</span>
            <strong>@_settings.BusinessType</strong>
        </div>

        <div>
            <span>Currency</span>
            <strong>@_settings.CurrencyCode · @_settings.CurrencySymbol</strong>
        </div>

        <div>
            <span>Expense Categories</span>
            <strong>@_categories.Count total</strong>
        </div>
    </div>

    <div class="expenses-summary-grid">
        <div class="expenses-summary-card hero">
            <div class="expenses-summary-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <span>Total Expenses</span>
            <strong>@Money(TotalExpenses)</strong>
            <small>For selected filters</small>
        </div>

        <div class="expenses-summary-card">
            <div class="expenses-summary-icon blue">
                <i class="bi bi-receipt"></i>
            </div>
            <span>Expense Count</span>
            <strong>@_expenses.Count</strong>
            <small>Expense records found</small>
        </div>

        <div class="expenses-summary-card">
            <div class="expenses-summary-icon amber">
                <i class="bi bi-percent"></i>
            </div>
            <span>Tax Amount</span>
            <strong>@Money(TotalTax)</strong>
            <small>Tax captured</small>
        </div>

        <div class="expenses-summary-card">
            <div class="expenses-summary-icon green">
                <i class="bi bi-tags"></i>
            </div>
            <span>Active Categories</span>
            <strong>@_categories.Count(x => x.IsActive)</strong>
            <small>Available for expenses</small>
        </div>
    </div>

    <div class="expenses-grid">
        <div class="expenses-panel">
            <div class="expenses-panel-header">
                <div>
                    <h2>Expense Records</h2>
                    <p>Showing @ExpensePageStart - @ExpensePageEnd of @TotalExpenseRows expense@(TotalExpenseRows == 1 ? "" : "s").</p>
                </div>

                <div class="expenses-panel-tools">
                    <div class="expenses-date-filters">
                        <input type="date" @bind="_fromDate" />
                        <input type="date" @bind="_toDate" />

                        <select class="expenses-filter-select"
                                value="@(_branchFilter?.ToString() ?? "")"
                                @onchange="BranchFilterChanged">
                            <option value="">All branches</option>
                            @foreach (var branch in _branches)
                            {
                                <option value="@branch.Id">
                                    @branch.Name
                                    @if (branch.IsMainBranch)
                                    {
                                        @(" · Main")
                                    }
                                </option>
                            }
                        </select>

                        <div class="expenses-search small-search">
                            <i class="bi bi-search"></i>
                            <input @bind="_expenseSearch"
                                   @bind:event="oninput"
                                   @onkeydown="HandleExpenseSearchKeyDown"
                                   placeholder="Search expense" />
                        </div>

                        <button type="button" class="expenses-secondary-btn" @onclick="ApplyExpenseFiltersAsync">
                            <i class="bi bi-filter"></i>
                            Filter
                        </button>
                    </div>

                    <div class="expenses-rows-tool">
                        <label>Rows</label>
                        <select value="@_expenseRowsMode" @onchange="ExpenseRowsChanged">
                            <option value="10">10 rows</option>
                            <option value="25">25 rows</option>
                            <option value="50">50 rows</option>
                            <option value="all">Show all</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (_loadingExpenses)
            {
                <div class="expenses-empty">
                    <div class="expenses-empty-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <strong>Loading expenses...</strong>
                    <span>Please wait while we fetch expense records.</span>
                </div>
            }
            else if (_expenses.Count == 0)
            {
                <div class="expenses-empty">
                    <div class="expenses-empty-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <strong>No expenses found</strong>
                    <span>Add your first expense or change the selected date range.</span>
                </div>
            }
            else
            {
                <div class="expenses-table-wrap">
                    <table class="expenses-table">
                        <thead>
                            <tr>
                                <th>Expense No.</th>
                                <th>Date</th>
                                <th>Category</th>
                                <th>Vendor</th>
                                <th>Reference</th>
                                <th>Payment</th>
                                <th>Subtotal</th>
                                <th>Tax</th>
                                <th>Total</th>
                                <th>Created By</th>
                                <th class="expenses-actions-col">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var expense in PaginatedExpenses)
                            {
                                <tr>
                                    <td><strong>@expense.ExpenseNumber</strong></td>
                                    <td>@expense.ExpenseDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td>@expense.CategoryName</td>
                                    <td>@(string.IsNullOrWhiteSpace(expense.VendorName) ? "-" : expense.VendorName)</td>
                                    <td>@(string.IsNullOrWhiteSpace(expense.ReferenceNumber) ? "-" : expense.ReferenceNumber)</td>
                                    <td>@expense.PaymentMethod</td>
                                    <td>@Money(expense.Subtotal)</td>
                                    <td>@Money(expense.TaxAmount)</td>
                                    <td class="expenses-strong">@Money(expense.TotalAmount)</td>
                                    <td>@expense.CreatedByName</td>
                                    <td class="expenses-actions-cell">
                                        <div class="expenses-action-menu">
                                            <button type="button"
                                                    class="expenses-action-toggle"
                                                    @onclick="() => ToggleExpenseActionMenu(expense.Id)">
                                                <span>Actions</span>
                                                <i class="bi bi-chevron-down"></i>
                                            </button>

                                            @if (_openExpenseActionId == expense.Id)
                                            {
                                                <div class="expenses-action-dropdown">
                                                    <button type="button" @onclick="() => EditExpenseAsync(expense.Id)">
                                                        <i class="bi bi-pencil"></i>
                                                        <span>Edit expense</span>
                                                    </button>
                                                    <button type="button"
                                                            class="danger"
                                                            @onclick="() => ConfirmDeleteExpense(expense.Id, expense.ExpenseNumber, expense.CategoryName, expense.TotalAmount)">
                                                        <i class="bi bi-trash"></i>
                                                        <span>Delete expense</span>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="expenses-pagination">
                    <div class="expenses-page-info">
                        Showing
                        <strong>@ExpensePageStart</strong>
                        -
                        <strong>@ExpensePageEnd</strong>
                        of
                        <strong>@TotalExpenseRows</strong>
                    </div>

                    <div class="expenses-page-controls">
                        <button type="button" class="@PreviousExpensePageClass" @onclick="PreviousExpensePage">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </button>

                        <span class="expenses-page-count">
                            @(ShowAllExpenseRows ? "Showing all" : $"Page {_expensePage} of {ExpenseTotalPages}")
                        </span>

                        <button type="button" class="@NextExpensePageClass" @onclick="NextExpensePage">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="expenses-panel">
            <div class="expenses-panel-header categories-header">
                <div>
                    <h2>Categories</h2>
                    <p>Showing @CategoryPageStart - @CategoryPageEnd of @TotalCategoryRows categor@(TotalCategoryRows == 1 ? "y" : "ies").</p>
                </div>

                <div class="expenses-rows-tool">
                    <label>Rows</label>
                    <select value="@_categoryRowsMode" @onchange="CategoryRowsChanged">
                        <option value="10">10 rows</option>
                        <option value="25">25 rows</option>
                        <option value="50">50 rows</option>
                        <option value="all">Show all</option>
                    </select>
                </div>
            </div>

            <div class="expenses-category-filters">
                <div class="expenses-search">
                    <i class="bi bi-search"></i>
                    <input @bind="_categorySearch"
                           @bind:event="oninput"
                           @onkeydown="HandleCategorySearchKeyDown"
                           placeholder="Search category" />
                </div>

                <select class="expenses-input" value="@_categoryStatus" @onchange="CategoryStatusChanged">
                    <option value="all">All</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>

                <button type="button" class="expenses-secondary-btn" @onclick="ApplyCategoryFiltersAsync">
                    <i class="bi bi-filter"></i>
                    Apply
                </button>
            </div>

            @if (_loadingCategories)
            {
                <div class="expenses-empty">
                    <div class="expenses-empty-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <strong>Loading categories...</strong>
                    <span>Please wait while we fetch expense categories.</span>
                </div>
            }
            else if (_categories.Count == 0)
            {
                <div class="expenses-empty">
                    <div class="expenses-empty-icon">
                        <i class="bi bi-tags"></i>
                    </div>
                    <strong>No categories found</strong>
                    <span>Create categories such as Rent, Salaries, Internet and Transport.</span>
                </div>
            }
            else
            {
                <div class="expenses-category-list">
                    @foreach (var category in PaginatedCategories)
                    {
                        <div class="expenses-category-card">
                            <div>
                                <strong>@category.CategoryName</strong>
                                <span>@(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)</span>
                                <small>@category.ExpenseCount expense@(category.ExpenseCount == 1 ? "" : "s") · @Money(category.TotalSpent)</small>
                            </div>

                            <div class="expenses-category-actions">
                                <span class="expenses-status-pill @(category.IsActive ? "active" : "inactive")">
                                    @(category.IsActive ? "Active" : "Inactive")
                                </span>

                                <div class="expenses-action-menu">
                                    <button type="button"
                                            class="expenses-category-toggle"
                                            @onclick="() => ToggleCategoryActionMenu(category.Id)">
                                        <i class="bi bi-three-dots"></i>
                                    </button>

                                    @if (_openCategoryActionId == category.Id)
                                    {
                                        <div class="expenses-action-dropdown category-dropdown">
                                            <button type="button" @onclick="() => EditCategoryAsync(category.Id)">
                                                <i class="bi bi-pencil"></i>
                                                <span>Edit category</span>
                                            </button>

                                            <button type="button"
                                                    @onclick="() => ConfirmToggleCategory(category.Id, category.CategoryName, category.IsActive)">
                                                <i class="bi @GetCategoryToggleIcon(category.IsActive)"></i>
                                                <span>@(category.IsActive ? "Pause category" : "Activate category")</span>
                                            </button>

                                            <button type="button"
                                                    class="danger"
                                                    @onclick="() => ConfirmDeleteCategory(category.Id, category.CategoryName, category.ExpenseCount)">
                                                <i class="bi bi-trash"></i>
                                                <span>Delete category</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="expenses-pagination">
                    <div class="expenses-page-info">
                        Showing
                        <strong>@CategoryPageStart</strong>
                        -
                        <strong>@CategoryPageEnd</strong>
                        of
                        <strong>@TotalCategoryRows</strong>
                    </div>

                    <div class="expenses-page-controls">
                        <button type="button" class="@PreviousCategoryPageClass" @onclick="PreviousCategoryPage">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </button>

                        <span class="expenses-page-count">
                            @(ShowAllCategoryRows ? "Showing all" : $"Page {_categoryPage} of {CategoryTotalPages}")
                        </span>

                        <button type="button" class="@NextCategoryPageClass" @onclick="NextCategoryPage">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@if (_showExpenseModal)
{
    <div class="expenses-modal-backdrop">
        <div class="expenses-modal">
            <div class="expenses-modal-header">
                <div>
                    <span>Expense record</span>
                    <h4>@(_expenseForm.Id.HasValue ? "Edit Expense" : "Add Expense")</h4>
                    <p>Capture real business costs so reports can calculate net profit.</p>
                </div>

                <button type="button" class="expenses-close-btn" @onclick="CloseExpenseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_expenseForm" OnValidSubmit="SaveExpenseAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="expenses-validation" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="expenses-label">Category</label>
                        <InputSelect class="expenses-input" @bind-Value="_expenseForm.ExpenseCategoryId">
                            <option value="0">Select category</option>
                            @foreach (var category in _categoryOptions)
                            {
                                <option value="@category.Id">@category.CategoryName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6">
                        <label class="expenses-label">Expense Date</label>
                        <InputDate class="expenses-input" @bind-Value="_expenseForm.ExpenseDate" />
                    </div>

                    <div class="col-md-6">
                        <label class="expenses-label">Vendor / Paid To</label>
                        <InputText class="expenses-input" @bind-Value="_expenseForm.VendorName" />
                    </div>

                    <div class="col-md-6">
                        <label class="expenses-label">Reference Number</label>
                        <InputText class="expenses-input" @bind-Value="_expenseForm.ReferenceNumber" />
                    </div>

                    <div class="col-md-6">
                        <label class="expenses-label">Payment Method</label>
                        <InputSelect class="expenses-input" @bind-Value="_expenseForm.PaymentMethod">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="EFT">EFT</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Debit Order">Debit Order</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-3">
                        <label class="expenses-label">Subtotal (@CurrencyLabel)</label>
                        <InputNumber class="expenses-input" @bind-Value="_expenseForm.Subtotal" />
                    </div>

                    <div class="col-md-3">
                        <label class="expenses-label">Tax (@CurrencyLabel)</label>
                        <InputNumber class="expenses-input" @bind-Value="_expenseForm.TaxAmount" />
                    </div>

                    <div class="col-12">
                        <div class="expenses-total-preview">
                            <span>Total Expense</span>
                            <strong>@Money(_expenseForm.Subtotal + _expenseForm.TaxAmount)</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="expenses-label">Notes</label>
                        <InputTextArea class="expenses-input expenses-textarea" @bind-Value="_expenseForm.Notes" />
                    </div>
                </div>

                <div class="expenses-modal-actions">
                    <button type="button" class="expenses-ghost-btn" @onclick="CloseExpenseModal">Cancel</button>

                    <button type="submit" class="@ExpenseSaveButtonClass">
                        <i class="bi bi-check2-circle"></i>
                        @(_savingExpense ? "Saving..." : "Save Expense")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showCategoryModal)
{
    <div class="expenses-modal-backdrop">
        <div class="expenses-modal small">
            <div class="expenses-modal-header">
                <div>
                    <span>Expense category</span>
                    <h4>@(_categoryForm.Id.HasValue ? "Edit Category" : "Add Category")</h4>
                    <p>Create categories such as Rent, Salaries, Internet, Transport and Marketing.</p>
                </div>

                <button type="button" class="expenses-close-btn" @onclick="CloseCategoryModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_categoryForm" OnValidSubmit="SaveCategoryAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="expenses-validation" />

                <div class="row g-3">
                    <div class="col-12">
                        <label class="expenses-label">Category Name</label>
                        <InputText class="expenses-input" @bind-Value="_categoryForm.CategoryName" />
                    </div>

                    <div class="col-12">
                        <label class="expenses-label">Description</label>
                        <InputTextArea class="expenses-input expenses-textarea" @bind-Value="_categoryForm.Description" />
                    </div>

                    <div class="col-12">
                        <label class="expenses-check">
                            <InputCheckbox @bind-Value="_categoryForm.IsActive" />
                            <span>
                                <strong>Active category</strong>
                                <small>Allow this category to be selected for new expenses.</small>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="expenses-modal-actions">
                    <button type="button" class="expenses-ghost-btn" @onclick="CloseCategoryModal">Cancel</button>

                    <button type="submit" class="@CategorySaveButtonClass">
                        <i class="bi bi-check2-circle"></i>
                        @(_savingCategory ? "Saving..." : "Save Category")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteExpenseConfirm)
{
    <div class="expenses-modal-backdrop">
        <div class="expenses-modal expenses-confirm-modal">
            <div class="expenses-confirm-icon danger">
                <i class="bi bi-trash"></i>
            </div>

            <h4>Delete Expense?</h4>

            <p>
                Are you sure you want to delete expense
                <strong>@_deleteExpenseNumber</strong>?
            </p>

            <div class="expenses-confirm-summary">
                <div>
                    <span>Category</span>
                    <strong>@_deleteExpenseCategory</strong>
                </div>

                <div>
                    <span>Total Amount</span>
                    <strong>@Money(_deleteExpenseAmount)</strong>
                </div>
            </div>

            <div class="expenses-modal-note danger">
                <i class="bi bi-exclamation-triangle"></i>
                <span>This expense will be removed from reports and dashboard totals.</span>
            </div>

            <div class="expenses-modal-actions">
                <button type="button" class="expenses-ghost-btn" @onclick="CancelDeleteExpense">
                    Cancel
                </button>

                <button type="button"
                        class="expenses-danger-btn"
                        disabled="@_savingDeleteExpense"
                        @onclick="DeleteExpenseConfirmedAsync">
                    <i class="bi bi-trash"></i>
                    @(_savingDeleteExpense ? "Deleting..." : "Yes, Delete")
                </button>
            </div>
        </div>
    </div>
}

@if (_showCategoryStatusConfirm)
{
    <div class="expenses-modal-backdrop">
        <div class="expenses-modal expenses-confirm-modal">
            <div class="expenses-confirm-icon @(_categoryIsActive ? "pause" : "activate")">
                <i class="bi @(_categoryIsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
            </div>

            <h4>@(_categoryIsActive ? "Pause Category?" : "Activate Category?")</h4>

            <p>
                Are you sure you want to
                <strong>@(_categoryIsActive ? "pause" : "activate") @_categoryStatusName</strong>?
            </p>

            <div class="expenses-confirm-summary">
                <div>
                    <span>Category</span>
                    <strong>@_categoryStatusName</strong>
                </div>

                <div>
                    <span>New Status</span>
                    <strong>@(_categoryIsActive ? "Inactive" : "Active")</strong>
                </div>
            </div>

            <div class="expenses-modal-note @(_categoryIsActive ? "pause" : "activate")">
                <i class="bi bi-info-circle"></i>
                <span>
                    @if (_categoryIsActive)
                    {
                        @("Paused categories will no longer be available when adding new expenses.")
                    }
                    else
                    {
                        @("Activated categories will be available again when adding expenses.")
                    }
                </span>
            </div>

            <div class="expenses-modal-actions">
                <button type="button" class="expenses-ghost-btn" @onclick="CancelToggleCategory">
                    Cancel
                </button>

                <button type="button"
                        class="@(_categoryIsActive ? "expenses-warning-btn" : "expenses-primary-btn")"
                        disabled="@_savingCategoryStatus"
                        @onclick="ToggleCategoryConfirmedAsync">
                    <i class="bi @(_categoryIsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                    @(_savingCategoryStatus ? "Updating..." : (_categoryIsActive ? "Yes, Pause" : "Yes, Activate"))
                </button>
            </div>
        </div>
    </div>
}

@if (_showDeleteCategoryConfirm)
{
    <div class="expenses-modal-backdrop">
        <div class="expenses-modal expenses-confirm-modal">
            <div class="expenses-confirm-icon danger">
                <i class="bi bi-trash"></i>
            </div>

            <h4>Delete Category?</h4>

            <p>
                Are you sure you want to delete
                <strong>@_deleteCategoryName</strong>?
            </p>

            <div class="expenses-confirm-summary">
                <div>
                    <span>Category</span>
                    <strong>@_deleteCategoryName</strong>
                </div>

                <div>
                    <span>Linked Expenses</span>
                    <strong>@_deleteCategoryExpenseCount</strong>
                </div>
            </div>

            <div class="expenses-modal-note danger">
                <i class="bi bi-exclamation-triangle"></i>
                <span>
                    If this category has linked expenses, the system may prevent deletion or keep the records protected.
                </span>
            </div>

            <div class="expenses-modal-actions">
                <button type="button" class="expenses-ghost-btn" @onclick="CancelDeleteCategory">
                    Cancel
                </button>

                <button type="button"
                        class="expenses-danger-btn"
                        disabled="@_savingDeleteCategory"
                        @onclick="DeleteCategoryConfirmedAsync">
                    <i class="bi bi-trash"></i>
                    @(_savingDeleteCategory ? "Deleting..." : "Yes, Delete")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .expenses-page {
        animation: expensesIn .22s ease both;
    }

    .expenses-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .expenses-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .expenses-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .expenses-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .expenses-top-actions {
        display: flex;
        gap: 10px;
