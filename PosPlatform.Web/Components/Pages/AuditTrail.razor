@code {
    private BusinessSettingsFormModel _settings = new();
    private List<AuditLogListItemViewModel> _logs = new();

    private bool _loading = true;

    private DateTime? _fromDate = DateTime.Today.AddDays(-7);
    private DateTime? _toDate = DateTime.Today;

    private string _moduleFilter = "all";
    private string _actionFilter = "all";
    private string? _searchTerm;

    private AuditLogListItemViewModel? _selectedLog;

    private int _currentPage = 1;
    private string _rowsMode = "10";

    private bool ShowAllRows =>
        _rowsMode.Equals("all", StringComparison.OrdinalIgnoreCase);

    private int PageSize => ParseRows(_rowsMode);

    private List<AuditLogListItemViewModel> OrderedLogs =>
        _logs
            .OrderByDescending(x => x.CreatedAt)
            .ToList();

    private int TotalLogRows => OrderedLogs.Count;

    private int TotalPages =>
        TotalLogRows == 0 || ShowAllRows
            ? 1
            : (int)Math.Ceiling(TotalLogRows / (double)PageSize);

    private int SafeCurrentPage =>
        Math.Min(Math.Max(_currentPage, 1), TotalPages);

    private int PageStart =>
        TotalLogRows == 0
            ? 0
            : ShowAllRows
                ? 1
                : ((SafeCurrentPage - 1) * PageSize) + 1;

    private int PageEnd =>
        TotalLogRows == 0
            ? 0
            : ShowAllRows
                ? TotalLogRows
                : Math.Min(SafeCurrentPage * PageSize, TotalLogRows);

    private List<AuditLogListItemViewModel> PaginatedLogs =>
        ShowAllRows
            ? OrderedLogs
            : OrderedLogs
                .Skip((SafeCurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();

    private string PreviousPageClass =>
        _currentPage <= 1 || ShowAllRows
            ? "audit-page-btn is-disabled"
            : "audit-page-btn";

    private string NextPageClass =>
        _currentPage >= TotalPages || ShowAllRows
            ? "audit-page-btn is-disabled"
            : "audit-page-btn";

    private int UniqueUserCount =>
        _logs
            .Where(x => !string.IsNullOrWhiteSpace(x.UserName))
            .Select(x => x.UserName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

    private List<AuditChartItem> TopModules =>
        _logs
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Module) ? "Unknown" : x.Module)
            .Select(x => new AuditChartItem(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .Take(6)
            .ToList();

    private List<AuditChartItem> TopActions =>
        _logs
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Action) ? "Unknown" : x.Action)
            .Select(x => new AuditChartItem(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .Take(6)
            .ToList();

    private int TopModuleMax =>
        TopModules.Count == 0 ? 1 : TopModules.Max(x => x.Count);

    private int TopActionMax =>
        TopActions.Count == 0 ? 1 : TopActions.Max(x => x.Count);

    private string TopModuleName =>
        TopModules.FirstOrDefault()?.Name ?? "No data";

    private string TopActionName =>
        TopActions.FirstOrDefault()?.Name ?? "No data";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("audit-trail"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _loading = true;

        _logs = await AuditLogService.GetLogsAsync(
            _fromDate,
            _toDate,
            _moduleFilter,
            _actionFilter,
            _searchTerm);

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadLogsAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private void ModuleFilterChanged(ChangeEventArgs e)
    {
        _moduleFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private void ActionFilterChanged(ChangeEventArgs e)
    {
        _actionFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private void RowsChanged(ChangeEventArgs e)
    {
        _rowsMode = e.Value?.ToString() ?? "10";
        _currentPage = 1;
    }

    private void NextPage()
    {
        if (!ShowAllRows && _currentPage < TotalPages)
        {
            _currentPage++;
        }
    }

    private void PreviousPage()
    {
        if (!ShowAllRows && _currentPage > 1)
        {
            _currentPage--;
        }
    }

    private async Task ResetFiltersAsync()
    {
        _fromDate = DateTime.Today.AddDays(-7);
        _toDate = DateTime.Today;
        _moduleFilter = "all";
        _actionFilter = "all";
        _searchTerm = null;
        _currentPage = 1;

        await LoadLogsAsync();
    }

    private void ViewLog(AuditLogListItemViewModel log)
    {
        _selectedLog = log;
    }

    private void CloseLog()
    {
        _selectedLog = null;
    }

    private int ParseRows(string value)
    {
        return int.TryParse(value, out var rows) && rows > 0
            ? rows
            : 10;
    }

    private string GetBarStyle(int value, int max)
    {
        if (max <= 0)
        {
            return "width:0%;";
        }

        var width = Math.Min(100, value / (decimal)max * 100);

        return $"width:{width.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private string GetActionBarClass(string action)
    {
        return action switch
        {
            "Create" => "green",
            "Open" => "green",
            "Cash In" => "green",
            "Update" => "blue",
            "Transfer" => "blue",
            "Delete" => "red",
            "Refund" => "red",
            "Cash Out" => "red",
            "Stock In" => "green",
            "Stock Out" => "red",
            "Correction" => "blue",
            "Close" => "blue",
            "Void" => "red",
            _ => "gray"
        };
    }

    private string GetActionClass(string action)
    {
        return action switch
        {
            "Create" => "create",
            "Open" => "open",
            "Cash In" => "cash-in",
            "Update" => "update",
            "Transfer" => "transfer",
            "Delete" => "delete",
            "Refund" => "refund",
            "Cash Out" => "cash-out",
            "Stock In" => "cash-in",
            "Stock Out" => "cash-out",
            "Correction" => "update",
            "Close" => "update",
            "Void" => "refund",
            _ => "default"
        };
    }

    private record AuditChartItem(string Name, int Count);
}