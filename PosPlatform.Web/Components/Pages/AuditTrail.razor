@page "/audit-trail"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Audit
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject AuditLogService AuditLogService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Audit Trail</PageTitle>

<section class="audit-page">
    <div class="audit-top">
        <div>
            <div class="audit-kicker">
                <i class="bi bi-shield-lock"></i>
                Security record
            </div>

            <h1>Audit Trail</h1>
            <p>Track important actions across the business, including who did what and when.</p>
        </div>
    </div>

    <div class="audit-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Records Showing</span>
            <strong>@TotalLogRows</strong>
        </div>

        <div>
            <span>Date Range</span>
            <strong>@_fromDate?.ToString("yyyy-MM-dd") → @_toDate?.ToString("yyyy-MM-dd")</strong>
        </div>

        <div>
            <span>Access</span>
            <strong>Management</strong>
        </div>
    </div>

    <div class="audit-summary-grid">
        <div class="audit-summary-card hero">
            <div class="audit-summary-icon">
                <i class="bi bi-list-check"></i>
            </div>
            <span>Total Records</span>
            <strong>@TotalLogRows</strong>
            <small>Matching audit records</small>
        </div>

        <div class="audit-summary-card">
            <div class="audit-summary-icon blue">
                <i class="bi bi-boxes"></i>
            </div>
            <span>Top Module</span>
            <strong>@TopModuleName</strong>
            <small>Most active area</small>
        </div>

        <div class="audit-summary-card">
            <div class="audit-summary-icon green">
                <i class="bi bi-person-check"></i>
            </div>
            <span>Active Users</span>
            <strong>@UniqueUserCount</strong>
            <small>Users in current result</small>
        </div>

        <div class="audit-summary-card">
            <div class="audit-summary-icon amber">
                <i class="bi bi-lightning-charge"></i>
            </div>
            <span>Top Action</span>
            <strong>@TopActionName</strong>
            <small>Most common action</small>
        </div>
    </div>

    <div class="audit-control-panel">
        <input type="date" @bind="_fromDate" />
        <input type="date" @bind="_toDate" />

        <select class="audit-filter" value="@_moduleFilter" @onchange="ModuleFilterChanged">
            <option value="all">All modules</option>
            <option value="Products">Products</option>
            <option value="Stock">Stock</option>
            <option value="Stock Transfers">Stock Transfers</option>
            <option value="Sales">Sales</option>
            <option value="Refunds">Refunds</option>
            <option value="Expenses">Expenses</option>
            <option value="Users">Users</option>
            <option value="Branches">Branches</option>
            <option value="Cashier Shift">Cashier Shift</option>
            <option value="Settings">Settings</option>
            <option value="Stock Purchases">Stock Purchases</option>
            <option value="Quotes">Quotes</option>
            <option value="Invoices">Invoices</option>
        </select>

        <select class="audit-filter" value="@_actionFilter" @onchange="ActionFilterChanged">
            <option value="all">All actions</option>
            <option value="Create">Create</option>
            <option value="Update">Update</option>
            <option value="Delete">Delete</option>
            <option value="Activate">Activate</option>
            <option value="Deactivate">Deactivate</option>
            <option value="Open">Open</option>
            <option value="Close">Close</option>
            <option value="Cash In">Cash In</option>
            <option value="Cash Out">Cash Out</option>
            <option value="Refund">Refund</option>
            <option value="Transfer">Transfer</option>
            <option value="Stock In">Stock In</option>
            <option value="Stock Out">Stock Out</option>
            <option value="Correction">Correction</option>
            <option value="Refunds">Refunds</option>
        </select>

        <div class="audit-search">
            <i class="bi bi-search"></i>
            <input @bind="_searchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search user, action, module or summary" />
        </div>

        <button type="button" class="audit-secondary-btn" @onclick="ApplyFiltersAsync">
            <i class="bi bi-filter"></i>
            Filter
        </button>

        <button type="button" class="audit-ghost-btn" @onclick="ResetFiltersAsync">
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
        </button>
    </div>

    @if (!_loading && _logs.Count > 0)
    {
        <div class="audit-chart-grid">
            <div class="audit-chart-card">
                <div class="audit-chart-header">
                    <div>
                        <h2>Activity by Module</h2>
                        <p>Which system areas are receiving the most activity.</p>
                    </div>
                </div>

                <div class="audit-bar-chart">
                    @foreach (var item in TopModules)
                    {
                        <div class="audit-bar-row">
                            <div class="audit-bar-label">
                                <span>@item.Name</span>
                                <strong>@item.Count</strong>
                            </div>

                            <div class="audit-bar-track">
                                <div class="audit-bar-fill blue" style="@GetBarStyle(item.Count, TopModuleMax)"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="audit-chart-card">
                <div class="audit-chart-header">
                    <div>
                        <h2>Activity by Action</h2>
                        <p>Create, update, delete and operational movement types.</p>
                    </div>
                </div>

                <div class="audit-bar-chart">
                    @foreach (var item in TopActions)
                    {
                        <div class="audit-bar-row">
                            <div class="audit-bar-label">
                                <span>@item.Name</span>
                                <strong>@item.Count</strong>
                            </div>

                            <div class="audit-bar-track">
                                <div class="audit-bar-fill @GetActionBarClass(item.Name)" style="@GetBarStyle(item.Count, TopActionMax)"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="audit-table-card">
        <div class="audit-table-header">
            <div>
                <h2>Activity Log</h2>
                <p>Showing @PageStart - @PageEnd of @TotalLogRows matching audit record@(TotalLogRows == 1 ? "" : "s").</p>
            </div>

            <div class="audit-rows-tool">
                <label>Rows</label>
                <select value="@_rowsMode" @onchange="RowsChanged">
                    <option value="10">10 rows</option>
                    <option value="25">25 rows</option>
                    <option value="50">50 rows</option>
                    <option value="all">Show all</option>
                </select>
            </div>
        </div>

        @if (_loading)
        {
            <div class="audit-empty">
                <div class="audit-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading audit records...</strong>
                <span>Please wait while we fetch activity logs.</span>
            </div>
        }
        else if (_logs.Count == 0)
        {
            <div class="audit-empty">
                <div class="audit-empty-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <strong>No audit records found</strong>
                <span>Once actions are logged, they will appear here.</span>
            </div>
        }
        else
        {
            <div class="audit-table-wrap">
                <table class="audit-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>User</th>
                            <th>Branch</th>
                            <th>Module</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Summary</th>
                            <th>IP</th>
                            <th class="audit-actions-col">Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in PaginatedLogs)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.UserName</td>
                                <td>@item.BranchName</td>
                                <td>
                                    <span class="audit-module-pill">@item.Module</span>
                                </td>
                                <td>
                                    <span class="audit-action-pill @GetActionClass(item.Action)">
                                        @item.Action
                                    </span>
                                </td>
                                <td>
                                    @item.EntityName
                                    @if (item.EntityId.HasValue)
                                    {
                                        <span class="audit-muted">#@item.EntityId</span>
                                    }
                                </td>
                                <td>@item.Summary</td>
                                <td>@(string.IsNullOrWhiteSpace(item.IpAddress) ? "-" : item.IpAddress)</td>
                                <td class="audit-actions-cell">
                                    <button type="button" class="audit-mini-btn" @onclick="() => ViewLog(item)">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="audit-pagination">
                <div class="audit-page-info">
                    Showing
                    <strong>@PageStart</strong>
                    -
                    <strong>@PageEnd</strong>
                    of
                    <strong>@TotalLogRows</strong>
                </div>

                <div class="audit-page-controls">
                    <button type="button" class="@PreviousPageClass" @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="audit-page-count">
                        @(ShowAllRows ? "Showing all" : $"Page {_currentPage} of {TotalPages}")
                    </span>

                    <button type="button" class="@NextPageClass" @onclick="NextPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

@if (_selectedLog != null)
{
    <div class="audit-modal-backdrop">
        <div class="audit-modal">
            <div class="audit-modal-header">
                <div>
                    <span>@_selectedLog.Module · @_selectedLog.Action</span>
                    <h4>@_selectedLog.Summary</h4>
                    <p>@_selectedLog.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") by @_selectedLog.UserName</p>
                </div>

                <button type="button" class="audit-close-btn" @onclick="CloseLog">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="audit-detail-grid">
                <div>
                    <span>Entity</span>
                    <strong>@_selectedLog.EntityName @(_selectedLog.EntityId.HasValue ? $"#{_selectedLog.EntityId}" : "")</strong>
                </div>

                <div>
                    <span>Branch</span>
                    <strong>@_selectedLog.BranchName</strong>
                </div>

                <div>
                    <span>IP Address</span>
                    <strong>@(string.IsNullOrWhiteSpace(_selectedLog.IpAddress) ? "-" : _selectedLog.IpAddress)</strong>
                </div>
            </div>

            <div class="audit-json-grid">
                <div>
                    <h5>Old Values</h5>
                    <pre>@(string.IsNullOrWhiteSpace(_selectedLog.OldValues) ? "No old values captured." : _selectedLog.OldValues)</pre>
                </div>

                <div>
                    <h5>New Values</h5>
                    <pre>@(string.IsNullOrWhiteSpace(_selectedLog.NewValues) ? "No new values captured." : _selectedLog.NewValues)</pre>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .audit-page {
        animation: auditIn .22s ease both;
    }

    .audit-top {
        margin-bottom: 16px;
    }

    .audit-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .audit-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .audit-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .audit-settings-strip,
    .audit-summary-grid,
    .audit-chart-grid {
        display: grid;
        gap: 12px;
        margin-bottom: 16px;
    }

    .audit-settings-strip,
    .audit-summary-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .audit-chart-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .audit-settings-strip div,
    .audit-summary-card,
    .audit-chart-card,
    .audit-table-card {
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
    }

    .audit-settings-strip div {
        padding: 15px;
        border-radius: 20px;
    }

    .audit-settings-strip span,
    .audit-settings-strip strong,
    .audit-summary-card span,
    .audit-summary-card strong,
    .audit-summary-card small {
        display: block;
    }

    .audit-settings-strip span,
    .audit-summary-card span {
        color: #667085;
        font-size: .72rem;
        font-weight: 700;
    }

    .audit-settings-strip strong,
    .audit-summary-card strong {
        margin-top: 6px;
        color: #111827;
        font-size: 1.05rem;
        font-weight: 760;
        letter-spacing: -.02em;
    }

    .audit-summary-card small {
        margin-top: 4px;
        color: #98a2b3;
        font-size: .72rem;
    }

    .audit-summary-card {
        padding: 15px;
        border-radius: 20px;
    }

        .audit-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

            .audit-summary-card.hero span,
            .audit-summary-card.hero strong,
            .audit-summary-card.hero small {
                color: #ffffff;
            }

    .audit-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .audit-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .audit-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .audit-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

    .audit-control-panel {
        display: grid;
        grid-template-columns: 150px 150px 180px 160px minmax(240px, 1fr) auto auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17,24,39,.035);
    }

        .audit-control-panel input,
        .audit-filter,
        .audit-rows-tool select {
            width: 100%;
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            color: #111827;
            padding: 0 12px;
            font-size: 16px;
            outline: none;
        }

    .audit-search {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #e5e7eb;
        color: #98a2b3;
    }

        .audit-search input {
            width: 100%;
            border: 0;
            outline: none;
            background: transparent;
            color: #111827;
            font-size: 16px;
        }

    .audit-secondary-btn,
    .audit-ghost-btn,
    .audit-mini-btn,
    .audit-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        transition: transform .18s ease;
    }

    .audit-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .audit-ghost-btn,
    .audit-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .audit-mini-btn {
        min-height: 32px;
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
        padding: 0 10px;
    }

        .audit-secondary-btn:hover,
        .audit-ghost-btn:hover,
        .audit-mini-btn:hover,
        .audit-page-btn:hover {
            transform: translateY(-1px);
        }

    .audit-page-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .audit-chart-card,
    .audit-table-card {
        border-radius: 22px;
        overflow: visible;
    }

    .audit-chart-header,
    .audit-table-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .audit-chart-header h2,
        .audit-table-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .audit-chart-header p,
        .audit-table-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .audit-rows-tool {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 170px;
    }

        .audit-rows-tool label {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

    .audit-bar-chart {
        padding: 16px 18px;
        display: grid;
        gap: 13px;
    }

    .audit-bar-row {
        display: grid;
        gap: 7px;
    }

    .audit-bar-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

        .audit-bar-label span {
            color: #667085;
            font-size: .78rem;
            font-weight: 700;
        }

        .audit-bar-label strong {
            color: #111827;
            font-size: .78rem;
            font-weight: 760;
        }

    .audit-bar-track {
        height: 10px;
        border-radius: 999px;
        background: #f3f4f6;
        overflow: hidden;
    }

    .audit-bar-fill {
        height: 100%;
        min-width: 4px;
        border-radius: 999px;
        background: #252525;
    }

        .audit-bar-fill.blue {
            background: #2563eb;
        }

        .audit-bar-fill.green {
            background: #8FA6A1;
        }

        .audit-bar-fill.amber {
            background: #b7791f;
        }

        .audit-bar-fill.red {
            background: #d92d20;
        }

        .audit-bar-fill.gray {
            background: #667085;
        }

    .audit-table-wrap {
        overflow-x: auto;
        padding-bottom: 100px;
    }

    .audit-table {
        width: 100%;
        min-width: 1180px;
        border-collapse: collapse;
    }

        .audit-table th {
            padding: 12px 16px;
            background: #fafafa;
            color: #667085;
            font-size: .7rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 1px solid #e8eaef;
            white-space: nowrap;
        }

        .audit-table td {
            padding: 14px 16px;
            color: #334155;
            font-size: .82rem;
            border-bottom: 1px solid #f1f2f5;
            vertical-align: middle;
        }

    .audit-module-pill,
    .audit-action-pill {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .audit-module-pill {
        color: #2563eb;
        background: #eff6ff;
    }

    .audit-action-pill.create,
    .audit-action-pill.open,
    .audit-action-pill.cash-in {
        color: #15803d;
        background: #ecfdf5;
    }

    .audit-action-pill.update,
    .audit-action-pill.transfer {
        color: #2563eb;
        background: #eff6ff;
    }

    .audit-action-pill.delete,
    .audit-action-pill.cash-out,
    .audit-action-pill.refund {
        color: #d92d20;
        background: #fef3f2;
    }

    .audit-action-pill.default {
        color: #667085;
        background: #f3f4f6;
    }

    .audit-muted {
        display: block;
        margin-top: 2px;
        color: #98a2b3;
        font-size: .7rem;
    }

    .audit-actions-col,
    .audit-actions-cell {
        text-align: right;
    }

    .audit-empty {
        margin: 18px;
        padding: 34px 20px;
        border-radius: 18px;
        background: #fafafa;
        border: 1px dashed #d0d5dd;
        text-align: center;
    }

    .audit-empty-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 10px;
        border-radius: 16px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .audit-empty strong,
    .audit-empty span {
        display: block;
    }

    .audit-empty strong {
        color: #111827;
        font-size: .9rem;
        font-weight: 720;
    }

    .audit-empty span {
        margin-top: 4px;
        color: #667085;
        font-size: .78rem;
    }

    .audit-pagination {
        padding: 14px 18px;
        border-top: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        border-radius: 0 0 22px 22px;
    }

    .audit-page-info {
        color: #667085;
        font-size: .78rem;
        font-weight: 600;
    }

        .audit-page-info strong {
            color: #111827;
        }

    .audit-page-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .audit-page-count {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding: 0 11px;
        border-radius: 11px;
        background: #fafafa;
        border: 1px solid #e8eaef;
        color: #667085;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .audit-modal-backdrop {
