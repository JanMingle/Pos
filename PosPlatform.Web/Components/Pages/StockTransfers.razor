@code {
    private BusinessSettingsFormModel _settings = new();
    private List<BranchOptionViewModel> _branches = new();
    private List<StockTransferProductOptionViewModel> _sourceProducts = new();
    private List<StockTransferHistoryRowViewModel> _transfers = new();

    private CreateStockTransferModel _transfer = new();

    private bool _showTransferPanel;
    private bool _savingTransfer;
    private bool _loadingTransfers = true;

    private DateTime? _fromDate = DateTime.Today.AddDays(-30);
    private DateTime? _toDate = DateTime.Today;
    private int? _branchFilter;
    private string? _searchTerm;

    private string? _message;
    private bool _isSuccess;

    private int _transferPage = 1;
    private int _transferPageSize = 10;

    private decimal TransferTotalQuantity => _transfer.Items.Sum(x => x.Quantity);

    private List<StockTransferHistoryRowViewModel> OrderedTransfers =>
        _transfers
            .OrderByDescending(x => x.TransferDate)
            .ToList();

    private int TotalTransfers => OrderedTransfers.Count;

    private string TransferPlural => TotalTransfers == 1 ? "" : "s";

    private decimal FilteredTransferQuantity => _transfers.Sum(x => x.TotalQuantity);

    private int FilteredTransferItems => _transfers.Sum(x => x.ItemCount);

    private int TransferTotalPages =>
        TotalTransfers == 0
            ? 1
            : (int)Math.Ceiling(TotalTransfers / (double)_transferPageSize);

    private int SafeTransferPage =>
        Math.Min(Math.Max(_transferPage, 1), TransferTotalPages);

    private int TransferPageStart =>
        TotalTransfers == 0
            ? 0
            : ((SafeTransferPage - 1) * _transferPageSize) + 1;

    private int TransferPageEnd =>
        TotalTransfers == 0
            ? 0
            : Math.Min(SafeTransferPage * _transferPageSize, TotalTransfers);

    private List<StockTransferHistoryRowViewModel> PaginatedTransfers =>
        OrderedTransfers
            .Skip((SafeTransferPage - 1) * _transferPageSize)
            .Take(_transferPageSize)
            .ToList();

    private string PreviousTransferPageClass =>
        _transferPage <= 1 ? "transfer-page-btn is-disabled" : "transfer-page-btn";

    private string NextTransferPageClass =>
        _transferPage >= TransferTotalPages ? "transfer-page-btn is-disabled" : "transfer-page-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("stock-transfers"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        _branches = await BranchService.GetBranchOptionsAsync();

        ResetTransferForm();
        await LoadTransfersAsync();
    }

    private async Task LoadTransfersAsync()
    {
        _loadingTransfers = true;

        _transfers = await StockTransferService.GetTransfersAsync(_fromDate, _toDate, _branchFilter, _searchTerm);

        if (_transferPage > TransferTotalPages)
        {
            _transferPage = TransferTotalPages;
        }

        _loadingTransfers = false;
    }

    private async Task ApplyTransferFiltersAsync()
    {
        _transferPage = 1;
        await LoadTransfersAsync();
    }

    private async Task HandleTransferSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyTransferFiltersAsync();
        }
    }

    private void NextTransferPage()
    {
        if (_transferPage < TransferTotalPages)
        {
            _transferPage++;
        }
    }

    private void PreviousTransferPage()
    {
        if (_transferPage > 1)
        {
            _transferPage--;
        }
    }

    private void OpenTransferPanel()
    {
        _showTransferPanel = true;

        if (_transfer.Items.Count == 0)
        {
            AddLine();
        }
    }

    private void CloseTransferPanel()
    {
        _showTransferPanel = false;
    }

    private void ResetTransferForm()
    {
        _transfer = new CreateStockTransferModel
        {
            TransferDate = DateTime.Today,
            Items = new List<CreateStockTransferItemModel>()
        };

        _sourceProducts = new List<StockTransferProductOptionViewModel>();
        AddLine();
    }

    private async Task SourceBranchChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var branchId))
        {
            branchId = 0;
        }

        _transfer.SourceBranchId = branchId;

        if (_transfer.DestinationBranchId == branchId)
        {
            _transfer.DestinationBranchId = 0;
        }

        _sourceProducts = branchId > 0
            ? await StockTransferService.GetSourceProductsAsync(branchId)
            : new List<StockTransferProductOptionViewModel>();

        _transfer.Items.Clear();
        AddLine();
    }

    private void AddLine()
    {
        _transfer.Items.Add(new CreateStockTransferItemModel
        {
            Quantity = 1
        });
    }

    private void RemoveLine(CreateStockTransferItemModel line)
    {
        _transfer.Items.Remove(line);
    }

    private void ProductChanged(CreateStockTransferItemModel line, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            line.ProductId = 0;
            line.SourceProductVariantId = null;
            line.TargetProductVariantId = null;
            return;
        }

        var product = _sourceProducts.FirstOrDefault(x => x.OptionKey == value);

        if (product == null)
        {
            line.ProductId = 0;
            line.SourceProductVariantId = null;
            line.TargetProductVariantId = null;
            return;
        }

        line.ProductId = product.ProductId;
        line.SourceProductVariantId = product.ProductVariantId;
        line.TargetProductVariantId = null;
    }

    private async Task SaveTransferAsync()
    {
        if (_savingTransfer)
        {
            return;
        }

        _savingTransfer = true;

        _transfer.Items = _transfer.Items
            .Where(x => x.ProductId > 0 && x.Quantity > 0)
            .ToList();

        var result = await StockTransferService.CreateTransferAsync(_transfer);

        _savingTransfer = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            ResetTransferForm();
            _showTransferPanel = false;
            _transferPage = 1;
            await LoadTransfersAsync();
        }
    }

    private string GetLineOptionKey(CreateStockTransferItemModel line)
    {
        if (line.SourceProductVariantId.HasValue)
        {
            return $"v:{line.SourceProductVariantId.Value}";
        }

        return line.ProductId > 0 ? $"p:{line.ProductId}" : "";
    }

    private string GetProductOptionText(StockTransferProductOptionViewModel product)
    {
        var unit = string.IsNullOrWhiteSpace(product.UnitOfMeasure) ? "" : $" {product.UnitOfMeasure}";
        var label = string.IsNullOrWhiteSpace(product.DisplayName) ? product.ProductName : product.DisplayName;
        var variantTag = product.IsVariant ? " · Variant" : "";

        return $"{label} ({product.SKU}){variantTag} · Available {product.CurrentStock:0.##}{unit}";
    }

    private string GetAvailableText(CreateStockTransferItemModel line)
    {
        var key = GetLineOptionKey(line);
        var product = _sourceProducts.FirstOrDefault(x => x.OptionKey == key);

        if (product == null)
        {
            return "-";
        }

        var unit = string.IsNullOrWhiteSpace(product.UnitOfMeasure) ? "" : $" {product.UnitOfMeasure}";
        return $"{product.CurrentStock:0.##}{unit}";
    }

    private string GetBranchName(int branchId)
    {
        if (branchId <= 0)
        {
            return "Not selected";
        }

        var branch = _branches.FirstOrDefault(x => x.Id == branchId);
        return branch?.Name ?? "Unknown branch";
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }
}