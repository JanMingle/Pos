@page "/stock-transfers"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Branches
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Models.StockTransfers
@using PosPlatform.Web.Services
@inject StockTransferService StockTransferService
@inject BranchService BranchService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Stock Transfers</PageTitle>

<section class="transfer-page">
    <div class="transfer-top">
        <div>
            <div class="transfer-kicker">
                <i class="bi bi-arrow-left-right"></i>
                Branch inventory
            </div>

            <h1>Stock Transfers</h1>
            <p>Move stock between branches, transfer variants, and keep branch inventory movement history accurate.</p>
        </div>

        @if (_settings.StockTrackingEnabled)
        {
            <button type="button" class="transfer-primary-btn" @onclick="OpenTransferPanel">
                <i class="bi bi-plus-lg"></i>
                New Transfer
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="transfer-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="transfer-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Branches</span>
            <strong>@_branches.Count active</strong>
        </div>

        <div>
            <span>Currency</span>
            <strong>@_settings.CurrencyCode · @_settings.CurrencySymbol</strong>
        </div>

        <div>
            <span>Stock Tracking</span>
            <strong>@(_settings.StockTrackingEnabled ? "Enabled" : "Disabled")</strong>
        </div>
    </div>

    @if (!_settings.StockTrackingEnabled)
    {
        <div class="transfer-warning">
            <div>
                <strong>Stock tracking is disabled</strong>
                <span>Enable stock tracking in Business Settings before transferring stock between branches.</span>
            </div>

            <a href="/settings" class="transfer-warning-link">
                Open Settings
            </a>
        </div>
    }
    else
    {
        <div class="transfer-summary-grid">
            <div class="transfer-summary-card hero">
                <div class="transfer-summary-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <span>Total Transfers</span>
                <strong>@TotalTransfers</strong>
                <small>For the selected period</small>
            </div>

            <div class="transfer-summary-card">
                <div class="transfer-summary-icon green">
                    <i class="bi bi-boxes"></i>
                </div>
                <span>Total Quantity</span>
                <strong>@FilteredTransferQuantity.ToString("0.##")</strong>
                <small>Units moved between branches</small>
            </div>

            <div class="transfer-summary-card">
                <div class="transfer-summary-icon blue">
                    <i class="bi bi-shop"></i>
                </div>
                <span>Active Branches</span>
                <strong>@_branches.Count</strong>
                <small>Available for transfers</small>
            </div>

            <div class="transfer-summary-card">
                <div class="transfer-summary-icon amber">
                    <i class="bi bi-list-check"></i>
                </div>
                <span>Transfer Lines</span>
                <strong>@FilteredTransferItems</strong>
                <small>Total item rows moved</small>
            </div>
        </div>
    }

    @if (_showTransferPanel && _settings.StockTrackingEnabled)
    {
        <div class="transfer-panel">
            <div class="transfer-panel-header">
                <div>
                    <h2>Create Transfer</h2>
                    <p>Select source and destination branch, then add stock items or variants.</p>
                </div>

                <button type="button" class="transfer-ghost-btn" @onclick="CloseTransferPanel">
                    <i class="bi bi-x-lg"></i>
                    Close
                </button>
            </div>

            <EditForm Model="_transfer" OnValidSubmit="SaveTransferAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="transfer-validation" />

                <div class="transfer-form-grid">
                    <div>
                        <label>Source Branch</label>
                        <select class="transfer-input"
                                value="@_transfer.SourceBranchId"
                                @onchange="SourceBranchChangedAsync">
                            <option value="0">Select source branch</option>
                            @foreach (var branch in _branches)
                            {
                                <option value="@branch.Id">
                                    @branch.Name
                                    @if (branch.IsMainBranch)
                                    {
                                        @(" · Main")
                                    }
                                </option>
                            }
                        </select>
                    </div>

                    <div>
                        <label>Destination Branch</label>
                        <InputSelect class="transfer-input" @bind-Value="_transfer.DestinationBranchId">
                            <option value="0">Select destination branch</option>
                            @foreach (var branch in _branches.Where(x => x.Id != _transfer.SourceBranchId))
                            {
                                <option value="@branch.Id">
                                    @branch.Name
                                    @if (branch.IsMainBranch)
                                    {
                                        @(" · Main")
                                    }
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <label>Transfer Date</label>
                        <InputDate class="transfer-input" @bind-Value="_transfer.TransferDate" />
                    </div>
                </div>

                <div class="transfer-route-card">
                    <div>
                        <span>From</span>
                        <strong>@GetBranchName(_transfer.SourceBranchId)</strong>
                    </div>

                    <i class="bi bi-arrow-right"></i>

                    <div>
                        <span>To</span>
                        <strong>@GetBranchName(_transfer.DestinationBranchId)</strong>
                    </div>
                </div>

                <div class="transfer-items-card">
                    <div class="transfer-items-header">
                        <div>
                            <h3>Transfer Items</h3>
                            <p>Only available stock from the selected source branch will appear.</p>
                        </div>

                        <button type="button" class="transfer-secondary-btn" @onclick="AddLine">
                            <i class="bi bi-plus-lg"></i>
                            Add Line
                        </button>
                    </div>

                    @if (_transfer.SourceBranchId <= 0)
                    {
                        <div class="transfer-empty small">
                            <div class="transfer-empty-icon">
                                <i class="bi bi-shop"></i>
                            </div>
                            <strong>Select source branch first</strong>
                            <span>Products and variants will load after selecting a source branch.</span>
                        </div>
                    }
                    else if (_sourceProducts.Count == 0)
                    {
                        <div class="transfer-empty small">
                            <div class="transfer-empty-icon">
                                <i class="bi bi-box"></i>
                            </div>
                            <strong>No stock available</strong>
                            <span>No stock-tracked items with available quantity were found for this branch.</span>
                        </div>
                    }
                    else if (_transfer.Items.Count == 0)
                    {
                        <div class="transfer-empty small">
                            <div class="transfer-empty-icon">
                                <i class="bi bi-plus-circle"></i>
                            </div>
                            <strong>No items added</strong>
                            <span>Add at least one item to transfer.</span>
                        </div>
                    }
                    else
                    {
                        <div class="transfer-lines">
                            @foreach (var line in _transfer.Items)
                            {
                                <div class="transfer-line">
                                    <div>
                                        <label>Product / Variant</label>
                                        <select class="transfer-input"
                                                value="@GetLineOptionKey(line)"
                                                @onchange="(e) => ProductChanged(line, e.Value?.ToString())">
                                            <option value="">Select product</option>
                                            @foreach (var product in _sourceProducts)
                                            {
                                                <option value="@product.OptionKey">
                                                    @GetProductOptionText(product)
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div>
                                        <label>Qty</label>
                                        <InputNumber class="transfer-input" @bind-Value="line.Quantity" />
                                    </div>

                                    <div>
                                        <label>Available</label>
                                        <div class="transfer-line-total">
                                            @GetAvailableText(line)
                                        </div>
                                    </div>

                                    <button type="button" class="transfer-remove-btn" @onclick="() => RemoveLine(line)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="transfer-notes">
                    <label>Notes</label>
                    <InputTextArea class="transfer-input transfer-textarea" @bind-Value="_transfer.Notes" />
                </div>

                <div class="transfer-total-box">
                    <div>
                        <span>Total Lines</span>
                        <strong>@_transfer.Items.Count</strong>
                    </div>

                    <div>
                        <span>Total Quantity</span>
                        <strong>@TransferTotalQuantity.ToString("0.##")</strong>
                    </div>
                </div>

                <div class="transfer-actions">
                    <button type="button" class="transfer-ghost-btn" @onclick="ResetTransferForm">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset
                    </button>

                    <button type="submit" class="transfer-primary-btn">
                        <i class="bi bi-check2-circle"></i>
                        @(_savingTransfer ? "Transferring..." : "Complete Transfer")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="transfer-history-panel">
        <div class="transfer-panel-header transfer-history-header">
            <div>
                <h2>Transfer History</h2>
                <p>Showing @TransferPageStart - @TransferPageEnd of @TotalTransfers transfer@(TransferPlural).</p>
            </div>

            <div class="transfer-filters">
                <input type="date" @bind="_fromDate" />
                <input type="date" @bind="_toDate" />

                <select class="transfer-filter-select" @bind="_branchFilter">
                    <option value="">All branches</option>
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Id">
                            @branch.Name
                            @if (branch.IsMainBranch)
                            {
                                @(" · Main")
                            }
                        </option>
                    }
                </select>

                <div class="transfer-search small-search">
                    <i class="bi bi-search"></i>
                    <input @bind="_searchTerm"
                           @bind:event="oninput"
                           @onkeydown="HandleTransferSearchKeyDown"
                           placeholder="Search transfer or branch" />
                </div>

                <button type="button" class="transfer-secondary-btn" @onclick="ApplyTransferFiltersAsync">
                    <i class="bi bi-filter"></i>
                    Filter
                </button>
            </div>
        </div>

        @if (_loadingTransfers)
        {
            <div class="transfer-empty">
                <div class="transfer-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading transfers...</strong>
                <span>Please wait while we fetch stock transfers.</span>
            </div>
        }
        else if (_transfers.Count == 0)
        {
            <div class="transfer-empty">
                <div class="transfer-empty-icon">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <strong>No transfers found</strong>
                <span>Transfer stock between branches to see records here.</span>
            </div>
        }
        else
        {
            <div class="transfer-table-wrap">
                <table class="transfer-table">
                    <thead>
                        <tr>
                            <th>Transfer No.</th>
                            <th>Date</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Items</th>
                            <th>Qty</th>
                            <th>Status</th>
                            <th>Created By</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var transfer in PaginatedTransfers)
                        {
                            <tr>
                                <td>
                                    <strong>@transfer.TransferNumber</strong>
                                </td>
                                <td>@transfer.TransferDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>@transfer.SourceBranchName</td>
                                <td>@transfer.DestinationBranchName</td>
                                <td>@transfer.ItemCount</td>
                                <td>@transfer.TotalQuantity.ToString("0.##")</td>
                                <td>
                                    <span class="transfer-status-pill">@transfer.Status</span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(transfer.CreatedByName) ? "-" : transfer.CreatedByName)</td>
                                <td>@(string.IsNullOrWhiteSpace(transfer.Notes) ? "-" : transfer.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="transfer-pagination">
                <div class="transfer-page-info">
                    Showing
                    <strong>@TransferPageStart</strong>
                    -
                    <strong>@TransferPageEnd</strong>
                    of
                    <strong>@TotalTransfers</strong>
                </div>

                <div class="transfer-page-controls">
                    <button type="button"
                            class="@PreviousTransferPageClass"
                            @onclick="PreviousTransferPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="transfer-page-count">
                        Page @_transferPage of @TransferTotalPages
                    </span>

                    <button type="button"
                            class="@NextTransferPageClass"
                            @onclick="NextTransferPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .transfer-page {
        animation: transferIn .22s ease both;
    }

    .transfer-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .transfer-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .transfer-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .transfer-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .transfer-primary-btn,
    .transfer-secondary-btn,
    .transfer-ghost-btn,
    .transfer-warning-link,
    .transfer-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        text-decoration: none;
        transition: transform .18s ease;
    }

    .transfer-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17, 24, 39, .12);
    }

    .transfer-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .transfer-ghost-btn,
    .transfer-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .transfer-warning-link {
        color: #ffffff;
        background: #252525;
    }

        .transfer-primary-btn:hover,
        .transfer-secondary-btn:hover,
        .transfer-ghost-btn:hover,
        .transfer-warning-link:hover,
        .transfer-page-btn:hover {
            transform: translateY(-1px);
        }

    .transfer-page-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .transfer-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .transfer-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .transfer-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .transfer-alert span {
            flex: 1;
        }

        .transfer-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .transfer-settings-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
    }

        .transfer-settings-strip div {
            padding: 13px;
            border-radius: 16px;
            background: #ffffff;
            border: 1px solid #e8eaef;
            box-shadow: 0 10px 24px rgba(17, 24, 39, .035);
        }

        .transfer-settings-strip span,
        .transfer-settings-strip strong {
            display: block;
        }

        .transfer-settings-strip span {
            color: #98a2b3;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .transfer-settings-strip strong {
            margin-top: 4px;
            color: #111827;
            font-size: .84rem;
            font-weight: 720;
        }

    .transfer-warning {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
        padding: 16px;
        border-radius: 18px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
    }

        .transfer-warning strong,
        .transfer-warning span {
            display: block;
        }

        .transfer-warning strong {
            color: #9a3412;
            font-size: .9rem;
            font-weight: 750;
        }

        .transfer-warning span {
            margin-top: 3px;
            color: #c2410c;
            font-size: .78rem;
        }

    .transfer-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .transfer-summary-card {
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
    }

        .transfer-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

        .transfer-summary-card span,
        .transfer-summary-card strong,
        .transfer-summary-card small {
            display: block;
        }

        .transfer-summary-card span {
            margin-top: 11px;
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .transfer-summary-card strong {
            margin-top: 6px;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 760;
            letter-spacing: -.02em;
        }

        .transfer-summary-card small {
            margin-top: 4px;
            color: #98a2b3;
            font-size: .72rem;
            line-height: 1.35;
        }

        .transfer-summary-card.hero span,
        .transfer-summary-card.hero strong,
        .transfer-summary-card.hero small {
            color: #ffffff;
        }

    .transfer-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .transfer-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .transfer-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .transfer-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

    .transfer-panel,
    .transfer-history-panel,
    .transfer-items-card {
        background: #ffffff;
        border: 1px solid #e8eaef;
        border-radius: 22px;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
        overflow: hidden;
        margin-bottom: 16px;
    }

    .transfer-panel-header,
    .transfer-items-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .transfer-panel-header h2,
        .transfer-items-header h3 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .transfer-panel-header p,
        .transfer-items-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .transfer-form-grid {
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

        .transfer-form-grid label,
        .transfer-lines label,
        .transfer-notes label {
            display: block;
            margin-bottom: 6px;
            color: #475569;
            font-size: .77rem;
            font-weight: 700;
        }

    .transfer-input,
    .transfer-filters input,
    .transfer-filter-select {
        width: 100%;
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #111827;
        padding: 0 12px;
        font-size: 16px;
        outline: none;
    }

    .transfer-route-card {
        margin: 0 18px 14px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        gap: 12px;
        align-items: center;
        padding: 14px;
        border-radius: 18px;
        background: #fafafa;
        border: 1px solid #e8eaef;
    }

        .transfer-route-card div {
            padding: 12px;
            border-radius: 15px;
            background: #ffffff;
            border: 1px solid #e8eaef;
        }

        .transfer-route-card span,
        .transfer-route-card strong {
            display: block;
        }

        .transfer-route-card span {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .transfer-route-card strong {
            margin-top: 4px;
            color: #111827;
            font-size: .86rem;
            font-weight: 720;
        }

        .transfer-route-card > i {
            color: #8FA6A1;
            font-size: 1.2rem;
        }

    .transfer-items-card {
        margin: 0 18px 14px;
        box-shadow: none;
    }

    .transfer-lines {
        padding: 14px 18px;
        display: grid;
        gap: 10px;
    }

    .transfer-line {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) 130px 150px auto;
        gap: 10px;
        align-items: end;
        padding: 13px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid #e8eaef;
    }

    .transfer-line-total {
        min-height: 40px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        padding: 0 12px;
        color: #111827;
        font-size: .84rem;
        font-weight: 750;
    }

    .transfer-remove-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid #fecaca;
        background: #fef3f2;
        color: #d92d20;
    }

    .transfer-notes {
        margin: 0 18px 14px;
    }

    .transfer-textarea {
        min-height: 86px;
        padding-top: 10px;
        resize: vertical;
    }

    .transfer-total-box {
        margin: 0 18px 14px;
        border-top: 1px solid #edf2f7;
        padding-top: 12px;
        display: grid;
        gap: 8px;
    }

        .transfer-total-box div {
            display: flex;
            justify-content: space-between;
            color: #667085;
            font-size: .84rem;
        }

        .transfer-total-box strong {
            color: #111827;
        }

    .transfer-actions {
        padding: 0 18px 18px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .transfer-validation {
