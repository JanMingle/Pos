@code {
    private BusinessSettingsFormModel _form = new();
    private List<BusinessTypeOptionViewModel> _businessTypes = new();

    private bool _loading = true;
    private bool _saving;

    private string? _message;
    private bool _isSuccess;

    private string SaveButtonClass =>
        _saving || _loading
            ? "settings-primary-btn is-disabled"
            : "settings-primary-btn";

    private int SetupScore
    {
        get
        {
            var completed = 0;
            var total = 10;

            if (!string.IsNullOrWhiteSpace(_form.BusinessName)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.BusinessType)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.CurrencyCode)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.CurrencySymbol)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.Phone)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.Email)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.Address)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.ReceiptTitle)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.ReceiptFooterMessage)) completed++;
            if (!string.IsNullOrWhiteSpace(_form.ReturnPolicyText)) completed++;

            return (int)Math.Round(completed / (double)total * 100);
        }
    }

    private string SetupStatus =>
        SetupScore >= 90
            ? "Excellent"
            : SetupScore >= 70
                ? "Good"
                : "Needs attention";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("settings"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _businessTypes = BusinessSettingsService.GetBusinessTypes();
        await ReloadSettingsAsync();
    }

    private async Task ReloadSettingsAsync()
    {
        _loading = true;
        _message = null;
        _form = await BusinessSettingsService.GetSettingsAsync();
        _loading = false;
    }

    private async Task SaveSettingsAsync()
    {
        if (_saving || _loading)
        {
            return;
        }

        _saving = true;

        var result = await BusinessSettingsService.SaveSettingsAsync(_form);

        _saving = false;
        _message = result.Message;
        _isSuccess = result.Success;
    }

    private void ClearMessage()
    {
        _message = null;
    }

    private string GetBusinessTypeDescription(string businessType)
    {
        return _businessTypes.FirstOrDefault(x => x.Name == businessType)?.Description
            ?? "Flexible setup for this business.";
    }

    private string YesNo(bool value)
    {
        return value ? "Enabled" : "Disabled";
    }

    private string GetTagClass(bool enabled)
    {
        return enabled ? "settings-tag-on" : "settings-tag-off";
    }

    private string GetTaxLabel()
    {
        if (!_form.TaxEnabled)
        {
            return "Disabled";
        }

        var taxName = string.IsNullOrWhiteSpace(_form.TaxName) ? "Tax" : _form.TaxName;
        return $"{taxName} {_form.TaxRate:0.##}%";
    }

    private string DisplayValue(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private string GetProgressStyle(int value)
    {
        var safeValue = Math.Clamp(value, 0, 100);
        return $"width:{safeValue}%;";
    }
}