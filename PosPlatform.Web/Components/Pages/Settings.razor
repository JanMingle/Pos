@page "/settings"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Settings</PageTitle>

<section class="settings-page">
    <div class="settings-top">
        <div>
            <div class="settings-kicker">
                <i class="bi bi-gear"></i>
                Business setup
            </div>

            <h1>Settings</h1>
            <p>Review the setup captured at registration and update your business configuration.</p>
        </div>

        <button type="button" class="@SaveButtonClass" @onclick="SaveSettingsAsync">
            <i class="bi bi-check2-circle"></i>
            @(_saving ? "Saving..." : "Save Settings")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="settings-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (_loading)
    {
        <div class="settings-empty">
            <div class="settings-empty-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <strong>Loading settings...</strong>
            <span>Please wait while we prepare your business configuration.</span>
        </div>
    }
    else
    {
        <div class="settings-hero">
            <div class="settings-hero-main">
                <div>
                    <span>Registered setup</span>
                    <h2>@_form.BusinessName</h2>
                    <p>@_form.BusinessType · @_form.CurrencyCode · @_form.CurrencySymbol</p>
                </div>

                <div class="settings-score-card">
                    <span>Setup Score</span>
                    <strong>@SetupScore%</strong>
                    <small>@SetupStatus</small>
                </div>
            </div>

            <div class="settings-progress">
                <div style="@GetProgressStyle(SetupScore)"></div>
            </div>

            <div class="settings-status-grid">
                <div>
                    <span>Tax / VAT</span>
                    <strong>@GetTaxLabel()</strong>
                </div>

                <div>
                    <span>Products</span>
                    <strong>@YesNo(_form.ProductsEnabled)</strong>
                </div>

                <div>
                    <span>Stock Tracking</span>
                    <strong>@YesNo(_form.StockTrackingEnabled)</strong>
                </div>

                <div>
                    <span>Services</span>
                    <strong>@YesNo(_form.ServicesEnabled)</strong>
                </div>

                <div>
                    <span>Customers</span>
                    <strong>@YesNo(_form.CustomersEnabled)</strong>
                </div>

                <div>
                    <span>Appointments</span>
                    <strong>@YesNo(_form.AppointmentsEnabled)</strong>
                </div>
            </div>
        </div>

        <div class="settings-rule-grid">
            <div class="settings-rule-card">
                <div class="settings-rule-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <div>
                    <span>Receipt title</span>
                    <strong>@DisplayValue(_form.ReceiptTitle, "Sales Receipt")</strong>
                </div>
            </div>

            <div class="settings-rule-card">
                <div class="settings-rule-icon green">
                    <i class="bi bi-percent"></i>
                </div>

                <div>
                    <span>Discounts</span>
                    <strong>@YesNo(_form.AllowDiscounts)</strong>
                </div>
            </div>

            <div class="settings-rule-card">
                <div class="settings-rule-icon amber">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div>
                    <span>Negative Stock</span>
                    <strong>@YesNo(_form.AllowNegativeStock)</strong>
                </div>
            </div>

            <div class="settings-rule-card">
                <div class="settings-rule-icon blue">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>
                    <span>Customer Required</span>
                    <strong>@YesNo(_form.RequireCustomerForSale)</strong>
                </div>
            </div>
        </div>

        <EditForm Model="_form" OnValidSubmit="SaveSettingsAsync">
            <DataAnnotationsValidator />

            <div class="settings-layout">
                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <h2>Business Profile</h2>
                            <p>This information appears across the system and on receipts.</p>
                        </div>

                        <i class="bi bi-building"></i>
                    </div>

                    <div class="settings-form">
                        <div>
                            <label>Business Name</label>
                            <InputText class="settings-input" @bind-Value="_form.BusinessName" />
                        </div>

                        <div>
                            <label>Business Type</label>
                            <InputSelect class="settings-input" @bind-Value="_form.BusinessType">
                                @foreach (var option in _businessTypes)
                                {
                                    <option value="@option.Name">@option.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="settings-business-hint">
                            <strong>@_form.BusinessType</strong>
                            <span>@GetBusinessTypeDescription(_form.BusinessType)</span>
                        </div>

                        <div>
                            <label>Address</label>
                            <InputTextArea class="settings-input settings-textarea" @bind-Value="_form.Address" />
                        </div>

                        <div class="settings-two-col">
                            <div>
                                <label>Phone</label>
                                <InputText class="settings-input" @bind-Value="_form.Phone" />
                            </div>

                            <div>
                                <label>Email</label>
                                <InputText class="settings-input" @bind-Value="_form.Email" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <h2>Currency & Tax</h2>
                            <p>Control how prices, tax and receipts display.</p>
                        </div>

                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <div class="settings-form">
                        <div class="settings-two-col">
                            <div>
                                <label>Currency Code</label>
                                <InputText class="settings-input" @bind-Value="_form.CurrencyCode" />
                            </div>

                            <div>
                                <label>Currency Symbol</label>
                                <InputText class="settings-input" @bind-Value="_form.CurrencySymbol" />
                            </div>
                        </div>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.TaxEnabled" />
                            <span>
                                <strong>Enable Tax / VAT</strong>
                                <small>Apply tax calculation rules to sales and receipts.</small>
                            </span>
                        </label>

                        <div class="settings-two-col">
                            <div>
                                <label>Tax Name</label>
                                <InputText class="settings-input" @bind-Value="_form.TaxName" />
                            </div>

                            <div>
                                <label>Tax Rate %</label>
                                <InputNumber class="settings-input" @bind-Value="_form.TaxRate" />
                            </div>
                        </div>

                        <div class="settings-tax-preview">
                            <span>Current tax display</span>
                            <strong>@GetTaxLabel()</strong>
                        </div>
                    </div>
                </div>

                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <h2>Modules</h2>
                            <p>Choose which parts of the platform this business uses.</p>
                        </div>

                        <i class="bi bi-grid"></i>
                    </div>

                    <div class="settings-switch-list">
                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.ProductsEnabled" />
                            <span>
                                <strong>Products</strong>
                                <small>Enable product catalogue and item setup.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.StockTrackingEnabled" />
                            <span>
                                <strong>Stock Tracking</strong>
                                <small>Track stock levels, stock movements and low-stock alerts.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.ServicesEnabled" />
                            <span>
                                <strong>Services</strong>
                                <small>Useful for salons, repair shops and service businesses.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.AppointmentsEnabled" />
                            <span>
                                <strong>Appointments</strong>
                                <small>Enable bookings and staff scheduling later.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.CustomersEnabled" />
                            <span>
                                <strong>Customers</strong>
                                <small>Enable customer profiles and purchase history.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.AgeRestrictedProductsEnabled" />
                            <span>
                                <strong>Age-Restricted Products</strong>
                                <small>Useful for regulated products that need extra control.</small>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="settings-panel">
                    <div class="settings-panel-header">
                        <div>
                            <h2>POS Rules</h2>
                            <p>Set controls for checkout and stock handling.</p>
                        </div>

                        <i class="bi bi-sliders"></i>
                    </div>

                    <div class="settings-switch-list">
                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.AllowDiscounts" />
                            <span>
                                <strong>Allow Discounts</strong>
                                <small>Users can apply discounts during sales.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.AllowNegativeStock" />
                            <span>
                                <strong>Allow Negative Stock</strong>
                                <small>Allow sales even when stock is below zero.</small>
                            </span>
                        </label>

                        <label class="settings-switch-row">
                            <InputCheckbox @bind-Value="_form.RequireCustomerForSale" />
                            <span>
                                <strong>Require Customer for Sale</strong>
                                <small>Useful for service businesses and account customers.</small>
                            </span>
                        </label>
                    </div>

                    <div class="settings-rule-preview">
                        <h3>Current checkout behavior</h3>

                        <div>
                            <span class="@GetTagClass(_form.AllowDiscounts)">Discounts: @YesNo(_form.AllowDiscounts)</span>
                            <span class="@GetTagClass(_form.AllowNegativeStock)">Negative Stock: @YesNo(_form.AllowNegativeStock)</span>
                            <span class="@GetTagClass(_form.RequireCustomerForSale)">Customer Required: @YesNo(_form.RequireCustomerForSale)</span>
                        </div>
                    </div>
                </div>

                <div class="settings-panel settings-panel-wide">
                    <div class="settings-panel-header">
                        <div>
                            <h2>Receipt Settings</h2>
                            <p>Control the wording shown on printed sales slips.</p>
                        </div>

                        <i class="bi bi-printer"></i>
                    </div>

                    <div class="settings-receipt-layout">
                        <div class="settings-form">
                            <div>
                                <label>Receipt Title</label>
                                <InputText class="settings-input" @bind-Value="_form.ReceiptTitle" />
                            </div>

                            <div>
                                <label>Footer Message</label>
                                <InputTextArea class="settings-input settings-textarea" @bind-Value="_form.ReceiptFooterMessage" />
                            </div>

                            <div>
                                <label>Return Policy Text</label>
                                <InputTextArea class="settings-input settings-textarea" @bind-Value="_form.ReturnPolicyText" />
                            </div>
                        </div>

                        <div class="settings-receipt-preview">
                            <div class="settings-receipt-paper">
                                <strong>@DisplayValue(_form.BusinessName, "Business Name")</strong>
                                <span>@DisplayValue(_form.ReceiptTitle, "Sales Receipt")</span>

                                <hr />

                                <div class="receipt-line">
                                    <span>Item total</span>
                                    <strong>@_form.CurrencySymbol 100.00</strong>
                                </div>

                                @if (_form.TaxEnabled)
                                {
                                    <div class="receipt-line">
                                        <span>@DisplayValue(_form.TaxName, "Tax")</span>
                                        <strong>@_form.TaxRate.ToString("0.##")%</strong>
                                    </div>
                                }

                                <div class="receipt-line total">
                                    <span>Total</span>
                                    <strong>@_form.CurrencySymbol 100.00</strong>
                                </div>

                                <hr />

                                <small>@DisplayValue(_form.ReceiptFooterMessage, "Thank you for your support.")</small>
                                <em>@DisplayValue(_form.ReturnPolicyText, "Return policy will show here.")</em>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <ValidationSummary class="settings-validation" />

            <div class="settings-bottom-actions">
                <button type="button" class="settings-ghost-btn" @onclick="ReloadSettingsAsync">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset Changes
                </button>

                <button type="submit" class="@SaveButtonClass">
                    <i class="bi bi-check2-circle"></i>
                    @(_saving ? "Saving..." : "Save Settings")
                </button>
            </div>
        </EditForm>
    }
</section>

<style>
    .settings-page {
        animation: settingsIn .22s ease both;
    }

    .settings-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .settings-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .settings-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .settings-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .settings-primary-btn,
    .settings-ghost-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        transition: transform .18s ease;
        white-space: nowrap;
    }

    .settings-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17,24,39,.12);
    }

    .settings-ghost-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

        .settings-primary-btn:hover,
        .settings-ghost-btn:hover {
            transform: translateY(-1px);
        }

    .settings-primary-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .settings-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .settings-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .settings-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .settings-alert span {
            flex: 1;
        }

        .settings-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .settings-hero,
    .settings-panel,
    .settings-rule-card {
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
    }

    .settings-hero {
        border-radius: 24px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .settings-hero-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        padding: 20px;
        background: radial-gradient(circle at top right, rgba(143, 166, 161, .22), transparent 34%), linear-gradient(135deg, #ffffff, #f8fafc);
    }

        .settings-hero-main span {
            display: block;
            color: #8FA6A1;
            font-size: .72rem;
            font-weight: 760;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .settings-hero-main h2 {
            margin: 6px 0 0;
            color: #111827;
            font-size: 1.22rem;
            font-weight: 780;
            letter-spacing: -.03em;
        }

        .settings-hero-main p {
            margin: 5px 0 0;
            color: #667085;
            font-size: .84rem;
        }

    .settings-score-card {
        min-width: 140px;
        padding: 13px;
        border-radius: 18px;
        background: #252525;
        color: #ffffff;
    }

        .settings-score-card span,
        .settings-score-card strong,
        .settings-score-card small {
            display: block;
            color: #ffffff;
        }

        .settings-score-card strong {
            margin-top: 5px;
            font-size: 1.2rem;
            font-weight: 800;
        }

        .settings-score-card small {
            margin-top: 3px;
            opacity: .75;
            font-size: .72rem;
        }

    .settings-progress {
        height: 8px;
        background: #f3f4f6;
        overflow: hidden;
    }

        .settings-progress div {
            height: 100%;
            background: #8FA6A1;
            border-radius: 999px;
        }

    .settings-status-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        padding: 14px 18px 18px;
    }

        .settings-status-grid div {
            padding: 13px;
            border-radius: 16px;
            background: #fafafa;
            border: 1px solid #e8eaef;
        }

        .settings-status-grid span,
        .settings-status-grid strong {
            display: block;
        }

        .settings-status-grid span {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .settings-status-grid strong {
            margin-top: 4px;
            color: #111827;
            font-size: .84rem;
            font-weight: 740;
        }

    .settings-rule-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .settings-rule-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px;
        border-radius: 20px;
    }

    .settings-rule-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #252525;
        background: #f3f4f6;
    }

        .settings-rule-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .settings-rule-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

        .settings-rule-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

    .settings-rule-card span,
    .settings-rule-card strong {
        display: block;
    }

    .settings-rule-card span {
        color: #667085;
        font-size: .72rem;
        font-weight: 700;
    }

    .settings-rule-card strong {
        margin-top: 4px;
        color: #111827;
        font-size: .88rem;
        font-weight: 750;
    }

    .settings-layout {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .settings-panel {
        border-radius: 22px;
        overflow: hidden;
    }

    .settings-panel-wide {
        grid-column: 1 / -1;
    }

    .settings-panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: flex-start;
    }

        .settings-panel-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .settings-panel-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

        .settings-panel-header i {
            color: #8FA6A1;
            font-size: 1.05rem;
        }

    .settings-form,
    .settings-switch-list {
        padding: 18px;
        display: grid;
        gap: 13px;
    }

    .settings-two-col {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .settings-form label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: .77rem;
        font-weight: 700;
    }

    .settings-input {
        width: 100%;
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #111827;
        padding: 0 12px;
        font-size: 16px;
        outline: none;
    }

    .settings-textarea {
        min-height: 86px;
        padding-top: 10px;
        resize: vertical;
    }

    .settings-business-hint,
    .settings-switch-row,
    .settings-tax-preview,
    .settings-rule-preview {
        padding: 13px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid #e8eaef;
    }

        .settings-business-hint strong,
        .settings-business-hint span,
        .settings-tax-preview span,
        .settings-tax-preview strong {
            display: block;
        }

        .settings-business-hint strong,
        .settings-tax-preview strong {
            color: #111827;
            font-size: .86rem;
            font-weight: 740;
        }

        .settings-business-hint span,
        .settings-tax-preview span {
            margin-top: 3px;
            color: #667085;
            font-size: .76rem;
        }

    .settings-switch-row {
        display: flex;
        gap: 11px;
        align-items: flex-start;
        cursor: pointer;
    }

        .settings-switch-row input {
            margin-top: 4px;
        }

        .settings-switch-row strong,
        .settings-switch-row small {
            display: block;
        }

        .settings-switch-row strong {
            color: #111827;
            font-size: .84rem;
            font-weight: 720;
        }

        .settings-switch-row small {
            margin-top: 2px;
            color: #667085;
            font-size: .74rem;
            line-height: 1.35;
        }

    .settings-rule-preview {
        margin: 0 18px 18px;
    }

        .settings-rule-preview h3 {
            margin: 0 0 10px;
            color: #111827;
            font-size: .86rem;
            font-weight: 720;
        }

        .settings-rule-preview div {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .settings-rule-preview span {
            display: inline-flex;
            min-height: 28px;
            align-items: center;
            padding: 0 10px;
            border-radius: 999px;
            font-size: .74rem;
            font-weight: 740;
        }

    .settings-tag-on {
        color: #15803d;
        background: #ecfdf5;
    }

    .settings-tag-off {
        color: #667085;
        background: #f3f4f6;
    }

    .settings-receipt-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 16px;
        padding: 0;
    }

    .settings-receipt-preview {
        padding: 18px 18px 18px 0;
    }

    .settings-receipt-paper {
        border-radius: 18px;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        box-shadow: 0 12px 26px rgba(17,24,39,.06);
        padding: 18px;
        text-align: center;
    }

        .settings-receipt-paper strong,
        .settings-receipt-paper span,
