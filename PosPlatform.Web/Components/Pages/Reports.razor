@page "/reports"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using System.Globalization
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Reports
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject ReportsService ReportsService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Reports</PageTitle>

<section class="reports-page">
    <div class="reports-top">
        <div>
            <div class="reports-kicker">
                <i class="bi bi-bar-chart"></i>
                Business intelligence
            </div>

            <h1>Reports Dashboard</h1>
            <p>View sales, profit, expenses, payment methods, stock, customers, suppliers and till differences.</p>

            <div class="reports-branch-badge">
                <i class="bi bi-shop"></i>
                Showing: @_dashboard.SelectedBranchName
            </div>
        </div>

        <div class="reports-actions">
            <div class="reports-quick-range">
                <button type="button" @onclick="SetTodayAsync">Today</button>
                <button type="button" @onclick="SetLast7DaysAsync">7 Days</button>
                <button type="button" @onclick="SetLast30DaysAsync">30 Days</button>
                <button type="button" @onclick="SetThisMonthAsync">This Month</button>
            </div>

            <div class="reports-date-filters">
                <input type="date" @bind="_fromDate" />
                <input type="date" @bind="_toDate" />

                <select class="reports-filter-input"
                        value="@(_branchFilter?.ToString() ?? "")"
                        @onchange="BranchFilterChanged">
                    <option value="">All branches</option>
                    @foreach (var branch in _dashboard.Branches)
                    {
                        <option value="@branch.Id">
                            @branch.Name
                            @if (branch.IsMainBranch)
                            {
                                @(" · Main")
                            }
                        </option>
                    }
                </select>

                <button type="button" class="reports-primary-btn" @onclick="LoadReportsAsync">
                    <i class="bi bi-filter"></i>
                    Apply
                </button>

                <button type="button" class="reports-secondary-btn" @onclick="DownloadExcelReport">
                    <i class="bi bi-file-earmark-excel"></i>
                    Export Excel
                </button>
            </div>
        </div>
    </div>

    <div class="reports-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Business Type</span>
            <strong>@_settings.BusinessType</strong>
        </div>

        <div>
            <span>Currency</span>
            <strong>@_settings.CurrencyCode · @_settings.CurrencySymbol</strong>
        </div>

        <div>
            <span>Period</span>
            <strong>@_fromDate?.ToString("yyyy-MM-dd") to @_toDate?.ToString("yyyy-MM-dd")</strong>
        </div>
    </div>

    @if (_loading)
    {
        <div class="reports-empty">
            <div class="reports-empty-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <strong>Loading reports...</strong>
            <span>Please wait while we prepare your business dashboard.</span>
        </div>
    }
    else
    {
        <div class="reports-summary-grid">
            <div class="reports-summary-card hero">
                <div class="reports-summary-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <span>Net Sales</span>
                <strong>@Money(_dashboard.NetSales)</strong>
                <small>Gross sales less refunds</small>
            </div>

            <div class="reports-summary-card hero">
                <div class="reports-summary-icon">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <span>Net Profit</span>
                <strong>@Money(_dashboard.NetProfit)</strong>
                <small>@_dashboard.NetProfitMargin.ToString("0.##")% net margin</small>
            </div>

            <div class="reports-summary-card">
                <div class="reports-summary-icon green">
                    <i class="bi bi-piggy-bank"></i>
                </div>
                <span>Gross Profit</span>
                <strong>@Money(_dashboard.GrossProfit)</strong>
                <small>@_dashboard.GrossProfitMargin.ToString("0.##")% gross margin</small>
            </div>

            <div class="reports-summary-card">
                <div class="reports-summary-icon red">
                    <i class="bi bi-wallet2"></i>
                </div>
                <span>Total Expenses</span>
                <strong>@Money(_dashboard.TotalExpenses)</strong>
                <small>@_dashboard.ExpenseCount expense(s)</small>
            </div>

            <div class="reports-summary-card">
                <div class="reports-summary-icon amber">
                    <i class="bi bi-box-seam"></i>
                </div>
                <span>Cost of Goods</span>
                <strong>@Money(_dashboard.NetCostOfGoodsSold)</strong>
                <small>After returned costs</small>
            </div>

            <div class="reports-summary-card">
                <div class="reports-summary-icon blue">
                    <i class="bi bi-cart-check"></i>
                </div>
                <span>Transactions</span>
                <strong>@_dashboard.TotalTransactions</strong>
                <small>Average sale: @Money(_dashboard.AverageSale)</small>
            </div>

            <div class="reports-summary-card">
                <div class="reports-summary-icon violet">
                    <i class="bi bi-arrow-repeat"></i>
                </div>
                <span>Refunds / Returns</span>
                <strong>@Money(_dashboard.TotalRefunds)</strong>
                <small>@_dashboard.RefundCount refund(s)</small>
            </div>

            <div class="reports-summary-card @GetDifferenceClass(_dashboard.TotalCashDifference)">
                <div class="reports-summary-icon">
                    <i class="bi bi-cash-coin"></i>
                </div>
                <span>Cash Difference</span>
                <strong>@Money(_dashboard.TotalCashDifference)</strong>
                <small>Cashier shift over/short</small>
            </div>
        </div>

        <div class="reports-insight-grid">
            <div class="reports-insight-card">
                <span>Top Payment Method</span>
                <strong>@TopPaymentMethod</strong>
                <small>Based on net amount</small>
            </div>

            <div class="reports-insight-card">
                <span>Top Expense Category</span>
                <strong>@TopExpenseCategory</strong>
                <small>Largest spend category</small>
            </div>

            <div class="reports-insight-card">
                <span>Top Selling Item</span>
                <strong>@TopSellingItem</strong>
                <small>Highest sales value</small>
            </div>

            <div class="reports-insight-card">
                <span>Stock Value</span>
                <strong>@Money(_dashboard.StockValue)</strong>
                <small>Current stock value</small>
            </div>
        </div>

        <div class="reports-chart-grid">
            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Profit Snapshot</h2>
                        <p>Sales, cost, expenses and profit compared visually.</p>
                    </div>
                </div>

                <div class="reports-bar-chart">
                    <div class="reports-bar-row">
                        <div class="reports-bar-label">
                            <span>Net Sales</span>
                            <strong>@Money(_dashboard.NetSales)</strong>
                        </div>
                        <div class="reports-bar-track">
                            <div class="reports-bar-fill sales" style="@GetBarStyle(_dashboard.NetSales, ProfitChartMax)"></div>
                        </div>
                    </div>

                    <div class="reports-bar-row">
                        <div class="reports-bar-label">
                            <span>Cost of Goods</span>
                            <strong>@Money(_dashboard.NetCostOfGoodsSold)</strong>
                        </div>
                        <div class="reports-bar-track">
                            <div class="reports-bar-fill amber" style="@GetBarStyle(_dashboard.NetCostOfGoodsSold, ProfitChartMax)"></div>
                        </div>
                    </div>

                    <div class="reports-bar-row">
                        <div class="reports-bar-label">
                            <span>Expenses</span>
                            <strong>@Money(_dashboard.TotalExpenses)</strong>
                        </div>
                        <div class="reports-bar-track">
                            <div class="reports-bar-fill red" style="@GetBarStyle(_dashboard.TotalExpenses, ProfitChartMax)"></div>
                        </div>
                    </div>

                    <div class="reports-bar-row">
                        <div class="reports-bar-label">
                            <span>Net Profit</span>
                            <strong class="@GetProfitTextClass(_dashboard.NetProfit)">@Money(_dashboard.NetProfit)</strong>
                        </div>
                        <div class="reports-bar-track">
                            <div class="reports-bar-fill @( _dashboard.NetProfit >= 0 ? "green" : "red" )" style="@GetBarStyle(_dashboard.NetProfit, ProfitChartMax)"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Payment Mix</h2>
                        <p>Share of net sales by payment type.</p>
                    </div>
                </div>

                <div class="reports-donut-layout">
                    <div class="reports-donut" style="@GetPaymentDonutStyle()">
                        <div>
                            <strong>@Money(PaymentMixTotal)</strong>
                            <span>Net payments</span>
                        </div>
                    </div>

                    <div class="reports-donut-legend">
                        <div>
                            <span class="legend-dot cash"></span>
                            <strong>Cash</strong>
                            <em>@PercentageText(CashPaymentTotal, PaymentMixTotal)</em>
                        </div>

                        <div>
                            <span class="legend-dot card"></span>
                            <strong>Card</strong>
                            <em>@PercentageText(CardPaymentTotal, PaymentMixTotal)</em>
                        </div>

                        <div>
                            <span class="legend-dot eft"></span>
                            <strong>EFT</strong>
                            <em>@PercentageText(EftPaymentTotal, PaymentMixTotal)</em>
                        </div>

                        <div>
                            <span class="legend-dot other"></span>
                            <strong>Other</strong>
                            <em>@PercentageText(OtherPaymentTotal, PaymentMixTotal)</em>
                        </div>
                    </div>
                </div>
            </div>

            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Top Selling Items</h2>
                        <p>Best performers by total sales value.</p>
                    </div>
                </div>

                @if (_dashboard.TopItems.Count == 0)
                {
                    <ReportsEmpty Text="No item sales found." />
                }
                else
                {
                    <div class="reports-bar-chart">
                        @foreach (var item in _dashboard.TopItems.Take(6))
                        {
                            <div class="reports-bar-row">
                                <div class="reports-bar-label">
                                    <span>@item.ProductName</span>
                                    <strong>@Money(item.TotalAmount)</strong>
                                </div>
                                <div class="reports-bar-track">
                                    <div class="reports-bar-fill blue" style="@GetBarStyle(item.TotalAmount, TopItemsMax)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Expenses by Category</h2>
                        <p>Highest expense categories in the selected period.</p>
                    </div>
                </div>

                @if (_dashboard.ExpensesByCategory.Count == 0)
                {
                    <ReportsEmpty Text="No expenses found." />
                }
                else
                {
                    <div class="reports-bar-chart">
                        @foreach (var item in _dashboard.ExpensesByCategory.Take(6))
                        {
                            <div class="reports-bar-row">
                                <div class="reports-bar-label">
                                    <span>@item.CategoryName</span>
                                    <strong>@Money(item.TotalAmount)</strong>
                                </div>
                                <div class="reports-bar-track">
                                    <div class="reports-bar-fill red" style="@GetBarStyle(item.TotalAmount, ExpensesCategoryMax)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Sales by Cashier</h2>
                        <p>Cashier performance by sales total.</p>
                    </div>
                </div>

                @if (_dashboard.Cashiers.Count == 0)
                {
                    <ReportsEmpty Text="No cashier sales found." />
                }
                else
                {
                    <div class="reports-bar-chart">
                        @foreach (var item in _dashboard.Cashiers.Take(6))
                        {
                            <div class="reports-bar-row">
                                <div class="reports-bar-label">
                                    <span>@item.CashierName</span>
                                    <strong>@Money(item.TotalSales)</strong>
                                </div>
                                <div class="reports-bar-track">
                                    <div class="reports-bar-fill green" style="@GetBarStyle(item.TotalSales, CashiersMax)"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-chart-card">
                <div class="reports-chart-header">
                    <div>
                        <h2>Payment Methods</h2>
                        <p>Gross, refunds and net payment performance.</p>
                    </div>
                </div>

                @if (_dashboard.PaymentMethods.Count == 0)
                {
                    <ReportsEmpty Text="No payment data found." />
                }
                else
                {
                    <div class="reports-list compact-list">
                        @foreach (var item in _dashboard.PaymentMethods)
                        {
                            <div class="reports-list-row reports-payment-row">
                                <div>
                                    <strong>@item.PaymentMethod</strong>
                                    <span>@item.Transactions sale@(item.Transactions == 1 ? "" : "s") · @item.Refunds refund@(item.Refunds == 1 ? "" : "s")</span>
                                </div>

                                <div class="reports-mini-metrics">
                                    <span>Gross: <strong>@Money(item.TotalAmount)</strong></span>
                                    <span>Refunds: <strong>@Money(item.RefundAmount)</strong></span>
                                    <span>Net: <strong>@Money(item.NetAmount)</strong></span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="reports-panel">
            <div class="reports-panel-header">
                <div>
                    <h2>Profit Breakdown</h2>
                    <p>Sales minus refunds, item costs and expenses.</p>
                </div>
            </div>

            <div class="reports-list">
                <div class="reports-list-row">
                    <div>
                        <strong>Gross Sales</strong>
                        <span>Total sales before refunds.</span>
                    </div>
                    <strong>@Money(_dashboard.GrossSales)</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Refunds / Returns</strong>
                        <span>Refunded sales value.</span>
                    </div>
                    <strong class="reports-negative">@Money(_dashboard.TotalRefunds)</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Net Sales</strong>
                        <span>Gross sales minus refunds.</span>
                    </div>
                    <strong>@Money(_dashboard.NetSales)</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Cost of Goods Sold</strong>
                        <span>Cost of items sold, after returned cost.</span>
                    </div>
                    <strong class="reports-negative">@Money(_dashboard.NetCostOfGoodsSold)</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Gross Profit</strong>
                        <span>Net sales minus net cost.</span>
                    </div>
                    <strong class="@GetProfitTextClass(_dashboard.GrossProfit)">
                        @Money(_dashboard.GrossProfit)
                    </strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Expenses</strong>
                        <span>Business operating expenses in this period.</span>
                    </div>
                    <strong class="reports-negative">@Money(_dashboard.TotalExpenses)</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Net Profit</strong>
                        <span>Gross profit minus expenses.</span>
                    </div>
                    <strong class="@GetProfitTextClass(_dashboard.NetProfit)">
                        @Money(_dashboard.NetProfit)
                    </strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Net Profit Margin</strong>
                        <span>Net profit as a percentage of net sales.</span>
                    </div>
                    <strong>@_dashboard.NetProfitMargin.ToString("0.##")%</strong>
                </div>

                <div class="reports-list-row">
                    <div>
                        <strong>Gross Profit Margin</strong>
                        <span>Gross profit as a percentage of net sales.</span>
                    </div>
                    <strong>@_dashboard.GrossProfitMargin.ToString("0.##")%</strong>
                </div>
            </div>
        </div>

        <div class="reports-grid">
            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Recent Expenses</h2>
                        <p>Latest recorded business costs.</p>
                    </div>
                </div>

                @if (_dashboard.RecentExpenses.Count == 0)
                {
                    <ReportsEmpty Text="No recent expenses found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Expense No.</th>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Vendor</th>
                                    <th>Payment</th>
                                    <th>Subtotal</th>
                                    <th>Tax</th>
                                    <th>Total</th>
                                    <th>Created By</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in _dashboard.RecentExpenses)
                                {
                                    <tr>
                                        <td>@item.ExpenseNumber</td>
                                        <td>@item.ExpenseDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                        <td>@item.CategoryName</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.VendorName) ? "-" : item.VendorName)</td>
                                        <td>@item.PaymentMethod</td>
                                        <td>@Money(item.Subtotal)</td>
                                        <td>@Money(item.TaxAmount)</td>
                                        <td class="reports-negative">@Money(item.TotalAmount)</td>
                                        <td>@item.CreatedByName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Top Suppliers</h2>
                        <p>Supplier spending in the selected period.</p>
                    </div>
                </div>

                @if (_dashboard.TopSuppliers.Count == 0)
                {
                    <ReportsEmpty Text="No supplier purchases found." />
                }
                else
                {
                    <div class="reports-list">
                        @foreach (var supplier in _dashboard.TopSuppliers)
                        {
                            <div class="reports-list-row">
                                <div>
                                    <strong>@supplier.SupplierName</strong>
                                    <span>@supplier.Purchases purchase@(supplier.Purchases == 1 ? "" : "s")</span>
                                </div>

                                <strong>@Money(supplier.TotalSpent)</strong>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Refund Activity by Cashier</h2>
                        <p>Refunds, returns and voids processed by users.</p>
                    </div>
                </div>

                @if (_dashboard.RefundCashiers.Count == 0)
                {
                    <ReportsEmpty Text="No refund activity found." />
                }
                else
                {
                    <div class="reports-list">
                        @foreach (var item in _dashboard.RefundCashiers)
                        {
                            <div class="reports-list-row">
                                <div>
                                    <strong>@item.CashierName</strong>
                                    <span>@item.Refunds refund@(item.Refunds == 1 ? "" : "s") processed</span>
                                </div>

                                <strong class="reports-negative">@Money(item.TotalRefunded)</strong>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Top Selling Items</h2>
                        <p>Products and services with highest sales value.</p>
                    </div>
                </div>

                @if (_dashboard.TopItems.Count == 0)
                {
                    <ReportsEmpty Text="No item sales found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>SKU</th>
                                    <th>Qty</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _dashboard.TopItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.SKU</td>
                                        <td>@item.QuantitySold.ToString("0.##")</td>
                                        <td>@Money(item.TotalAmount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Top Refunded Items</h2>
                        <p>Items with the highest refund or return value.</p>
                    </div>
                </div>

                @if (_dashboard.TopRefundedItems.Count == 0)
                {
                    <ReportsEmpty Text="No refunded items found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>SKU</th>
                                    <th>Qty Returned</th>
                                    <th>Refunded</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _dashboard.TopRefundedItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.SKU</td>
                                        <td>@item.QuantityReturned.ToString("0.##")</td>
                                        <td class="reports-negative">@Money(item.RefundAmount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Low Stock</h2>
                        <p>Items requiring attention.</p>
                    </div>
                </div>

                @if (_dashboard.LowStock.Count == 0)
                {
                    <ReportsEmpty Text="No low-stock items found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>SKU</th>
                                    <th>Stock</th>
                                    <th>Reorder</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _dashboard.LowStock)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.SKU</td>
                                        <td>@item.QuantityInStock.ToString("0.##")</td>
                                        <td>@item.ReorderLevel.ToString("0.##")</td>
                                        <td>@Money(item.StockValue)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Top Customers</h2>
                        <p>Customers with the highest spend in this period.</p>
                    </div>
                </div>

                @if (_dashboard.TopCustomers.Count == 0)
                {
                    <ReportsEmpty Text="No customer-linked sales found." />
                }
                else
                {
                    <div class="reports-list">
                        @foreach (var item in _dashboard.TopCustomers)
                        {
                            <div class="reports-list-row reports-payment-row">
                                <div>
                                    <strong>@item.CustomerName</strong>
                                    <span>@item.Purchases purchase@(item.Purchases == 1 ? "" : "s") · Last @item.LastPurchaseDate?.ToLocalTime().ToString("yyyy-MM-dd")</span>
                                </div>

                                <div class="reports-mini-metrics">
                                    <span>Gross: <strong>@Money(item.GrossSpent)</strong></span>
                                    <span>Refunded: <strong>@Money(item.Refunded)</strong></span>
                                    <span>Net: <strong>@Money(item.TotalSpent)</strong></span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Recent Sales</h2>
                        <p>Latest transactions in the selected period.</p>
                    </div>
                </div>

                @if (_dashboard.RecentSales.Count == 0)
                {
                    <ReportsEmpty Text="No recent sales found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Receipt</th>
                                    <th>Date</th>
                                    <th>Cashier</th>
                                    <th>Payment</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in _dashboard.RecentSales)
                                {
                                    <tr>
                                        <td>@sale.SaleNumber</td>
                                        <td>@sale.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@sale.CashierName</td>
                                        <td>@sale.PaymentMethod</td>
                                        <td>@sale.ItemCount</td>
                                        <td>@Money(sale.TotalAmount)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel">
                <div class="reports-panel-header">
                    <div>
                        <h2>Recent Refunds / Returns</h2>
                        <p>Latest refund, return and void activity.</p>
                    </div>
                </div>

                @if (_dashboard.RecentRefunds.Count == 0)
                {
                    <ReportsEmpty Text="No recent refunds found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Return No.</th>
                                    <th>Sale</th>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th>Method</th>
                                    <th>Processed By</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in _dashboard.RecentRefunds)
                                {
                                    <tr>
                                        <td>@item.ReturnNumber</td>
                                        <td>@item.SaleNumber</td>
                                        <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@item.ReturnType</td>
                                        <td>@item.RefundMethod</td>
                                        <td>@item.ReturnedByName</td>
                                        <td class="reports-negative">@Money(item.TotalRefundAmount)</td>
                                        <td>
                                            <span class="reports-status-pill closed">@item.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="reports-panel reports-panel-wide">
                <div class="reports-panel-header">
                    <div>
                        <h2>Cashier Shift Differences</h2>
                        <p>Cash over/short from closed shifts.</p>
                    </div>
                </div>

                @if (_dashboard.Shifts.Count == 0)
                {
                    <ReportsEmpty Text="No cashier shifts found." />
                }
                else
                {
                    <div class="reports-table-wrap">
                        <table class="reports-table">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Cashier</th>
                                    <th>Opened</th>
                                    <th>Closed</th>
                                    <th>Opening</th>
                                    <th>Cash Sales</th>
                                    <th>Expected</th>
                                    <th>Closing</th>
                                    <th>Difference</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var shift in _dashboard.Shifts)
                                {
                                    <tr>
                                        <td>
                                            <span class="reports-status-pill @(shift.Status == "Open" ? "open" : "closed")">
                                                @shift.Status
                                            </span>
                                        </td>
                                        <td>@shift.CashierName</td>
                                        <td>@shift.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(shift.ClosedAt.HasValue? shift.ClosedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                        <td>@Money(shift.OpeningCash)</td>
                                        <td>@Money(shift.CashSales)</td>
                                        <td>@Money(shift.ExpectedCash)</td>
                                        <td>@Money(shift.ClosingCash)</td>
                                        <td class="@GetDifferenceTextClass(shift.CashDifference)">
                                            @Money(shift.CashDifference)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</section>

