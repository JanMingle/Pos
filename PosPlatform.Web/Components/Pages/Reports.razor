@code {
    private BusinessSettingsFormModel _settings = new();
    private ReportsDashboardViewModel _dashboard = new();

    private bool _loading = true;
    private int? _branchFilter;

    private DateTime? _fromDate = DateTime.Today;
    private DateTime? _toDate = DateTime.Today;

    private decimal CashPaymentTotal => Math.Max(0, _dashboard.CashSales);
    private decimal CardPaymentTotal => Math.Max(0, _dashboard.CardSales);
    private decimal EftPaymentTotal => Math.Max(0, _dashboard.EftSales);

    private decimal OtherPaymentTotal =>
        Math.Max(0, _dashboard.NetSales - CashPaymentTotal - CardPaymentTotal - EftPaymentTotal);

    private decimal PaymentMixTotal =>
        CashPaymentTotal + CardPaymentTotal + EftPaymentTotal + OtherPaymentTotal;

    private decimal ProfitChartMax =>
        MaxOf(_dashboard.NetSales, _dashboard.NetCostOfGoodsSold, _dashboard.TotalExpenses, Math.Abs(_dashboard.NetProfit));

    private decimal TopItemsMax =>
        _dashboard.TopItems.Count == 0 ? 0 : _dashboard.TopItems.Max(x => x.TotalAmount);

    private decimal ExpensesCategoryMax =>
        _dashboard.ExpensesByCategory.Count == 0 ? 0 : _dashboard.ExpensesByCategory.Max(x => x.TotalAmount);

    private decimal CashiersMax =>
        _dashboard.Cashiers.Count == 0 ? 0 : _dashboard.Cashiers.Max(x => x.TotalSales);

    private string TopPaymentMethod =>
        _dashboard.PaymentMethods
            .OrderByDescending(x => x.NetAmount)
            .FirstOrDefault()?.PaymentMethod ?? "No data";

    private string TopExpenseCategory =>
        _dashboard.ExpensesByCategory
            .OrderByDescending(x => x.TotalAmount)
            .FirstOrDefault()?.CategoryName ?? "No data";

    private string TopSellingItem =>
        _dashboard.TopItems
            .OrderByDescending(x => x.TotalAmount)
            .FirstOrDefault()?.ProductName ?? "No data";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("reports"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        _loading = true;
        _dashboard = await ReportsService.GetDashboardAsync(_fromDate, _toDate, _branchFilter);
        _loading = false;
    }

    private async Task SetTodayAsync()
    {
        _fromDate = DateTime.Today;
        _toDate = DateTime.Today;
        await LoadReportsAsync();
    }

    private async Task SetLast7DaysAsync()
    {
        _fromDate = DateTime.Today.AddDays(-6);
        _toDate = DateTime.Today;
        await LoadReportsAsync();
    }

    private async Task SetLast30DaysAsync()
    {
        _fromDate = DateTime.Today.AddDays(-29);
        _toDate = DateTime.Today;
        await LoadReportsAsync();
    }

    private async Task SetThisMonthAsync()
    {
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
        await LoadReportsAsync();
    }

    private void BranchFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        _branchFilter = int.TryParse(value, out var branchId)
            ? branchId
            : null;
    }

    private string Money(decimal value)
    {
        var symbol = string.IsNullOrWhiteSpace(_settings.CurrencySymbol)
            ? "R"
            : _settings.CurrencySymbol;

        return $"{symbol} {value:0.00}";
    }

    private string GetDifferenceClass(decimal value)
    {
        if (value > 0)
        {
            return "good";
        }

        if (value < 0)
        {
            return "bad";
        }

        return "";
    }

    private string GetDifferenceTextClass(decimal value)
    {
        if (value > 0)
        {
            return "difference-good";
        }

        if (value < 0)
        {
            return "difference-bad";
        }

        return "difference-neutral";
    }

    private string GetProfitTextClass(decimal value)
    {
        return value >= 0 ? "difference-good" : "difference-bad";
    }

    private decimal MaxOf(params decimal[] values)
    {
        var max = values
            .Select(Math.Abs)
            .DefaultIfEmpty(0)
            .Max();

        return max <= 0 ? 1 : max;
    }

    private string GetBarStyle(decimal value, decimal max)
    {
        if (max <= 0)
        {
            return "width:0%;";
        }

        var width = Math.Min(100, Math.Abs(value) / max * 100);

        return $"width:{width.ToString("0.##", CultureInfo.InvariantCulture)}%;";
    }

    private string PercentageText(decimal value, decimal total)
    {
        if (total <= 0)
        {
            return "0%";
        }

        var percentage = value / total * 100;

        return $"{percentage.ToString("0.##", CultureInfo.InvariantCulture)}%";
    }

    private string GetPaymentDonutStyle()
    {
        if (PaymentMixTotal <= 0)
        {
            return "background:#f3f4f6;";
        }

        var cashEnd = CashPaymentTotal / PaymentMixTotal * 100;
        var cardEnd = cashEnd + (CardPaymentTotal / PaymentMixTotal * 100);
        var eftEnd = cardEnd + (EftPaymentTotal / PaymentMixTotal * 100);

        var cash = cashEnd.ToString("0.##", CultureInfo.InvariantCulture);
        var card = cardEnd.ToString("0.##", CultureInfo.InvariantCulture);
        var eft = eftEnd.ToString("0.##", CultureInfo.InvariantCulture);

        return $"background:conic-gradient(#252525 0 {cash}%, #8FA6A1 {cash}% {card}%, #b7791f {card}% {eft}%, #2563eb {eft}% 100%);";
    }

    private void DownloadExcelReport()
    {
        var query = new List<string>();

        if (_fromDate.HasValue)
        {
            query.Add($"fromDate={_fromDate.Value:yyyy-MM-dd}");
        }

        if (_toDate.HasValue)
        {
            query.Add($"toDate={_toDate.Value:yyyy-MM-dd}");
        }

        if (_branchFilter.HasValue)
        {
            query.Add($"branchId={_branchFilter.Value}");
        }

        var url = "/reports/export/excel";

        if (query.Count > 0)
        {
            url += "?" + string.Join("&", query);
        }

        NavigationManager.NavigateTo(url, forceLoad: true);
    }
}