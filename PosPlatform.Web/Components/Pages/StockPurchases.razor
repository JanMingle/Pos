@page "/stock-purchases"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Models.Suppliers
@using PosPlatform.Web.Models.Purchases
@using PosPlatform.Web.Models.Branches
@using PosPlatform.Web.Services
@inject StockPurchaseService StockPurchaseService
@inject SupplierService SupplierService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject BranchService BranchService
@inject NavigationManager NavigationManager

<PageTitle>Stock Purchases</PageTitle>

<section class="purchase-page">
    <div class="purchase-top">
        <div>
            <div class="purchase-kicker">
                <i class="bi bi-box-arrow-in-down"></i>
                Stock receiving
            </div>

            <h1>Stock Purchases</h1>
            <p>Receive supplier stock, update quantities, track costs and review purchase history.</p>
        </div>

        <button type="button" class="purchase-primary-btn" @onclick="OpenReceivePanel">
            <i class="bi bi-plus-lg"></i>
            Receive Stock
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="purchase-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="purchase-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Currency</span>
            <strong>@_settings.CurrencyCode · @_settings.CurrencySymbol</strong>
        </div>

        <div>
            <span>Stock Tracking</span>
            <strong>@(_settings.StockTrackingEnabled ? "Enabled" : "Disabled")</strong>
        </div>

        <div>
            <span>Suppliers</span>
            <strong>@_suppliers.Count active</strong>
        </div>
    </div>

    @if (!_settings.StockTrackingEnabled)
    {
        <div class="purchase-warning">
            <div>
                <strong>Stock tracking is disabled</strong>
                <span>Enable stock tracking in Business Settings before receiving stock purchases.</span>
            </div>

            <a href="/settings" class="purchase-warning-link">
                Open Settings
            </a>
        </div>
    }
    else
    {
        <div class="purchase-summary-grid">
            <div class="purchase-summary-card hero">
                <div class="purchase-summary-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <span>Total Purchases</span>
                <strong>@Money(FilteredPurchaseTotal)</strong>
                <small>For the selected period</small>
            </div>

            <div class="purchase-summary-card">
                <div class="purchase-summary-icon green">
                    <i class="bi bi-list-check"></i>
                </div>
                <span>Purchase Count</span>
                <strong>@_purchases.Count</strong>
                <small>Purchase records found</small>
            </div>

            <div class="purchase-summary-card">
                <div class="purchase-summary-icon amber">
                    <i class="bi bi-percent"></i>
                </div>
                <span>Total Tax</span>
                <strong>@Money(FilteredPurchaseTax)</strong>
                <small>Tax captured</small>
            </div>

            <div class="purchase-summary-card">
                <div class="purchase-summary-icon blue">
                    <i class="bi bi-boxes"></i>
                </div>
                <span>Quantity Received</span>
                <strong>@FilteredPurchaseQuantity.ToString("0.##")</strong>
                <small>Units received</small>
            </div>
        </div>
    }

    @if (_showReceivePanel && _settings.StockTrackingEnabled)
    {
        <div class="purchase-receive-panel">
            <div class="purchase-panel-header">
                <div>
                    <h2>Receive Stock</h2>
                    <p>Select a supplier, add stock-tracked products or variants, then receive into inventory.</p>
                </div>

                <button type="button" class="purchase-ghost-btn" @onclick="CloseReceivePanel">
                    <i class="bi bi-x-lg"></i>
                    Close
                </button>
            </div>

            <EditForm Model="_purchase" OnValidSubmit="SavePurchaseAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="purchase-validation" />

                <div class="purchase-form-grid">
                    <div>
                        <label>Supplier</label>
                        <InputSelect class="purchase-input" @bind-Value="_purchase.SupplierId">
                            <option value="0">Select supplier</option>
                            @foreach (var supplier in _suppliers)
                            {
                                <option value="@supplier.Id">@supplier.SupplierName</option>
                            }
                        </InputSelect>
                    </div>

                    <div>
                        <label>Supplier Invoice No.</label>
                        <InputText class="purchase-input" @bind-Value="_purchase.SupplierInvoiceNumber" />
                    </div>

                    <div>
                        <label>Purchase Date</label>
                        <InputDate class="purchase-input" @bind-Value="_purchase.PurchaseDate" />
                    </div>

                    <div>
                        <label>Tax Amount (@CurrencyLabel)</label>
                        <InputNumber class="purchase-input" @bind-Value="_purchase.TaxAmount" />
                    </div>
                </div>

                <div class="purchase-check-row">
                    <label>
                        <InputCheckbox @bind-Value="_purchase.UpdateProductCostPrice" />
                        <span>
                            <strong>Update product cost price</strong>
                            <small>Use the latest supplier unit cost as the product cost price.</small>
                        </span>
                    </label>
                </div>

                <div class="purchase-items-card">
                    <div class="purchase-items-header">
                        <div>
                            <h3>Purchase Items</h3>
                            <p>Only stock-tracked products and variants are listed here.</p>
                        </div>

                        <button type="button" class="purchase-secondary-btn" @onclick="AddLine">
                            <i class="bi bi-plus-lg"></i>
                            Add Line
                        </button>
                    </div>

                    @if (_purchase.Items.Count == 0)
                    {
                        <div class="purchase-empty small">
                            <strong>No items added</strong>
                            <span>Add at least one stock item to receive.</span>
                        </div>
                    }
                    else
                    {
                        <div class="purchase-lines">
                            @foreach (var line in _purchase.Items)
                            {
                                <div class="purchase-line">
                                    <div>
                                        <label>Product / Variant</label>
                                        <select class="purchase-input"
                                                value="@GetLineOptionKey(line)"
                                                @onchange="(e) => ProductChanged(line, e.Value?.ToString())">
                                            <option value="0">Select product</option>
                                            @foreach (var product in _products)
                                            {
                                                <option value="@product.OptionKey">
                                                    @GetProductOptionText(product)
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div>
                                        <label>Qty</label>
                                        <InputNumber class="purchase-input" @bind-Value="line.Quantity" />
                                    </div>

                                    <div>
                                        <label>Unit Cost (@CurrencyLabel)</label>
                                        <InputNumber class="purchase-input" @bind-Value="line.UnitCost" />
                                    </div>

                                    <div>
                                        <label>Line Total</label>
                                        <div class="purchase-line-total">@Money(GetLineTotal(line))</div>
                                    </div>

                                    <button type="button" class="purchase-remove-btn" @onclick="() => RemoveLine(line)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="purchase-notes-box">
                    <label>Notes</label>
                    <InputTextArea class="purchase-input purchase-textarea" @bind-Value="_purchase.Notes" />
                </div>

                <div class="purchase-total-box">
                    <div>
                        <span>Subtotal</span>
                        <strong>@Money(PurchaseSubtotal)</strong>
                    </div>

                    <div>
                        <span>Tax</span>
                        <strong>@Money(_purchase.TaxAmount)</strong>
                    </div>

                    <div class="final">
                        <span>Total</span>
                        <strong>@Money(PurchaseTotal)</strong>
                    </div>
                </div>

                <div class="purchase-actions">
                    <button type="button" class="purchase-ghost-btn" @onclick="ResetPurchaseForm">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset
                    </button>

                    <button type="submit" class="purchase-primary-btn">
                        <i class="bi bi-check2-circle"></i>
                        @(_savingPurchase ? "Receiving..." : "Receive Stock")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="purchase-history-panel">
        <div class="purchase-panel-header purchase-history-header">
            <div>
                <h2>Purchase History</h2>
                <p>Showing @PurchasePageStart - @PurchasePageEnd of @TotalPurchases purchase@(PurchasePlural).</p>
            </div>

            <div class="purchase-date-filters">
                <input type="date" @bind="_fromDate" />
                <input type="date" @bind="_toDate" />

                <select class="purchase-filter-select" @bind="_branchFilter">
                    <option value="">All branches</option>
                    @foreach (var branch in _branches)
                    {
                        <option value="@branch.Id">
                            @branch.Name
                            @if (branch.IsMainBranch)
                            {
                                @(" · Main")
                            }
                        </option>
                    }
                </select>

                <div class="purchase-search small-search">
                    <i class="bi bi-search"></i>
                    <input @bind="_searchTerm"
                           @bind:event="oninput"
                           @onkeydown="HandlePurchaseSearchKeyDown"
                           placeholder="Search PO, invoice or supplier" />
                </div>

                <button type="button" class="purchase-secondary-btn" @onclick="ApplyPurchaseFiltersAsync">
                    <i class="bi bi-filter"></i>
                    Filter
                </button>
            </div>
        </div>

        @if (_loadingPurchases)
        {
            <div class="purchase-empty">
                <div class="purchase-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading purchases...</strong>
                <span>Please wait while we fetch purchase records.</span>
            </div>
        }
        else if (_purchases.Count == 0)
        {
            <div class="purchase-empty">
                <div class="purchase-empty-icon">
                    <i class="bi bi-box-arrow-in-down"></i>
                </div>
                <strong>No purchases found</strong>
                <span>Receive stock from suppliers to see purchase records here.</span>
            </div>
        }
        else
        {
            <div class="purchase-table-wrap">
                <table class="purchase-table">
                    <thead>
                        <tr>
                            <th>Purchase No.</th>
                            <th>Supplier</th>
                            <th>Invoice</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Qty</th>
                            <th>Subtotal</th>
                            <th>Tax</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Created By</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in PaginatedPurchases)
                        {
                            <tr>
                                <td>
                                    <strong>@item.PurchaseNumber</strong>
                                </td>
                                <td>@item.SupplierName</td>
                                <td>@(string.IsNullOrWhiteSpace(item.SupplierInvoiceNumber) ? "-" : item.SupplierInvoiceNumber)</td>
                                <td>@item.PurchaseDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                <td>@item.ItemCount</td>
                                <td>@item.TotalQuantity.ToString("0.##")</td>
                                <td>@Money(item.Subtotal)</td>
                                <td>@Money(item.TaxAmount)</td>
                                <td class="purchase-strong">@Money(item.TotalAmount)</td>
                                <td>
                                    <span class="purchase-status-pill">@item.Status</span>
                                </td>
                                <td>@item.CreatedByName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="purchase-pagination">
                <div class="purchase-page-info">
                    Showing
                    <strong>@PurchasePageStart</strong>
                    -
                    <strong>@PurchasePageEnd</strong>
                    of
                    <strong>@TotalPurchases</strong>
                </div>

                <div class="purchase-page-controls">
                    <button type="button"
                            class="@PreviousPurchasePageClass"
                            @onclick="PreviousPurchasePage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="purchase-page-count">
                        Page @_purchasePage of @PurchaseTotalPages
                    </span>

                    <button type="button"
                            class="@NextPurchasePageClass"
                            @onclick="NextPurchasePage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .purchase-page {
        animation: purchaseIn .22s ease both;
    }

    .purchase-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .purchase-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .purchase-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .purchase-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .purchase-primary-btn,
    .purchase-secondary-btn,
    .purchase-ghost-btn,
    .purchase-warning-link,
    .purchase-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        text-decoration: none;
        transition: transform .18s ease;
    }

    .purchase-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17, 24, 39, .12);
    }

    .purchase-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .purchase-ghost-btn,
    .purchase-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .purchase-warning-link {
        color: #ffffff;
        background: #252525;
    }

        .purchase-primary-btn:hover,
        .purchase-secondary-btn:hover,
        .purchase-ghost-btn:hover,
        .purchase-warning-link:hover,
        .purchase-page-btn:hover {
            transform: translateY(-1px);
        }

    .purchase-page-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .purchase-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .purchase-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .purchase-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .purchase-alert span {
            flex: 1;
        }

        .purchase-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .purchase-settings-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
    }

        .purchase-settings-strip div {
            padding: 13px;
            border-radius: 16px;
            background: #ffffff;
            border: 1px solid #e8eaef;
            box-shadow: 0 10px 24px rgba(17, 24, 39, .035);
        }

        .purchase-settings-strip span,
        .purchase-settings-strip strong {
            display: block;
        }

        .purchase-settings-strip span {
            color: #98a2b3;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .purchase-settings-strip strong {
            margin-top: 4px;
            color: #111827;
            font-size: .84rem;
            font-weight: 720;
        }

    .purchase-warning {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
        padding: 16px;
        border-radius: 18px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
    }

        .purchase-warning strong,
        .purchase-warning span {
            display: block;
        }

        .purchase-warning strong {
            color: #9a3412;
            font-size: .9rem;
            font-weight: 750;
        }

        .purchase-warning span {
            margin-top: 3px;
            color: #c2410c;
            font-size: .78rem;
        }

    .purchase-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
    }

    .purchase-summary-card {
        padding: 15px;
        border-radius: 20px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
    }

        .purchase-summary-card.hero {
            background: #252525;
            border-color: #252525;
        }

        .purchase-summary-card span,
        .purchase-summary-card strong,
        .purchase-summary-card small {
            display: block;
        }

        .purchase-summary-card span {
            margin-top: 11px;
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
        }

        .purchase-summary-card strong {
            margin-top: 6px;
            color: #111827;
            font-size: 1.05rem;
            font-weight: 760;
            letter-spacing: -.02em;
        }

        .purchase-summary-card small {
            margin-top: 4px;
            color: #98a2b3;
            font-size: .72rem;
            line-height: 1.35;
        }

        .purchase-summary-card.hero span,
        .purchase-summary-card.hero strong,
        .purchase-summary-card.hero small {
            color: #ffffff;
        }

    .purchase-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .purchase-summary-icon.green {
            color: #8FA6A1;
            background: #f2f6f5;
        }

        .purchase-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

        .purchase-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

    .purchase-receive-panel,
    .purchase-history-panel,
    .purchase-items-card {
        background: #ffffff;
        border: 1px solid #e8eaef;
        border-radius: 22px;
        box-shadow: 0 14px 32px rgba(17, 24, 39, .045);
        overflow: hidden;
        margin-bottom: 16px;
    }

    .purchase-panel-header,
    .purchase-items-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .purchase-panel-header h2,
        .purchase-items-header h3 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .purchase-panel-header p,
        .purchase-items-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .purchase-form-grid {
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

        .purchase-form-grid label,
        .purchase-lines label,
        .purchase-notes-box label {
            display: block;
            margin-bottom: 6px;
            color: #475569;
            font-size: .77rem;
            font-weight: 700;
        }

    .purchase-input,
    .purchase-date-filters input[type="date"],
    .purchase-filter-select {
        width: 100%;
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #111827;
        padding: 0 12px;
        font-size: 16px;
        outline: none;
    }

    .purchase-textarea {
        min-height: 86px;
        padding-top: 10px;
        resize: vertical;
    }

    .purchase-notes-box {
        padding: 0 18px 14px;
    }

    .purchase-check-row {
        padding: 0 18px 14px;
    }

        .purchase-check-row label {
            display: flex;
            gap: 10px;
            padding: 12px;
            border-radius: 14px;
            background: #fafafa;
            border: 1px solid #e8eaef;
        }

        .purchase-check-row input {
            margin-top: 4px;
        }

        .purchase-check-row strong,
        .purchase-check-row small {
            display: block;
        }

        .purchase-check-row strong {
            color: #111827;
            font-size: .84rem;
        }

        .purchase-check-row small {
            margin-top: 2px;
            color: #667085;
            font-size: .74rem;
        }

    .purchase-items-card {
        margin: 0 18px 14px;
        box-shadow: none;
    }

    .purchase-lines {
        padding: 14px 18px;
        display: grid;
        gap: 10px;
    }

    .purchase-line {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) 120px 150px 140px auto;
        gap: 10px;
        align-items: end;
        padding: 13px;
        border-radius: 16px;
        background: #fafafa;
        border: 1px solid #e8eaef;
    }

    .purchase-line-total {
        min-height: 40px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        padding: 0 12px;
        color: #111827;
        font-size: .84rem;
        font-weight: 750;
    }

    .purchase-remove-btn {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid #fecaca;
        background: #fef3f2;
        color: #d92d20;
    }

    .purchase-total-box {
        margin: 0 18px 14px;
        border-top: 1px solid #edf2f7;
        padding-top: 12px;
        display: grid;
        gap: 8px;
    }

        .purchase-total-box div {
            display: flex;
            justify-content: space-between;
            color: #667085;
            font-size: .84rem;
        }

        .purchase-total-box strong {
            color: #111827;
        }

        .purchase-total-box .final {
            padding-top: 8px;
            border-top: 1px solid #edf2f7;
            color: #111827;
            font-size: .95rem;
            font-weight: 750;
        }

    .purchase-actions {
        padding: 0 18px 18px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .purchase-validation {
        margin: 0 18px 14px;
        padding: 12px 14px;
        border-radius: 14px;
        background: #fef2f2;
        color: #991b1b;
        font-size: .82rem;
    }

    .purchase-history-header {
