@code {
    private BusinessSettingsFormModel _settings = new();
    private List<BranchListItemViewModel> _branches = new();

    private BranchFormModel _form = new();

    private bool _loading = true;
    private bool _saving;
    private bool _showModal;
    private bool _showDeleteConfirm;

    private string? _searchTerm;
    private string _statusFilter = "all";

    private int _deleteId;
    private string _deleteBranchName = string.Empty;

    private string? _message;
    private bool _isSuccess;

    private int _currentPage = 1;
    private string _rowsMode = "10";
    private int? _openActionBranchId;

    private bool ShowAllRows =>
        _rowsMode.Equals("all", StringComparison.OrdinalIgnoreCase);

    private int PageSize => ParseRows(_rowsMode);

    private List<BranchListItemViewModel> OrderedBranches =>
        _branches
            .OrderByDescending(x => x.IsMainBranch)
            .ThenBy(x => x.Name)
            .ToList();

    private int TotalBranchRows => OrderedBranches.Count;

    private int TotalPages =>
        TotalBranchRows == 0 || ShowAllRows
            ? 1
            : (int)Math.Ceiling(TotalBranchRows / (double)PageSize);

    private int SafeCurrentPage =>
        Math.Min(Math.Max(_currentPage, 1), TotalPages);

    private int PageStart =>
        TotalBranchRows == 0
            ? 0
            : ShowAllRows
                ? 1
                : ((SafeCurrentPage - 1) * PageSize) + 1;

    private int PageEnd =>
        TotalBranchRows == 0
            ? 0
            : ShowAllRows
                ? TotalBranchRows
                : Math.Min(SafeCurrentPage * PageSize, TotalBranchRows);

    private List<BranchListItemViewModel> PaginatedBranches =>
        ShowAllRows
            ? OrderedBranches
            : OrderedBranches
                .Skip((SafeCurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();

    private string PreviousPageClass =>
        _currentPage <= 1 || ShowAllRows
            ? "branches-page-btn is-disabled"
            : "branches-page-btn";

    private string NextPageClass =>
        _currentPage >= TotalPages || ShowAllRows
            ? "branches-page-btn is-disabled"
            : "branches-page-btn";

    private string SaveButtonClass =>
        _saving
            ? "branches-primary-btn is-disabled"
            : "branches-primary-btn";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserAccessService.CanAccessAsync("branches"))
        {
            NavigationManager.NavigateTo("/dashboard");
            return;
        }

        _settings = await BusinessSettingsService.GetSettingsAsync();

        await BranchService.EnsureMainBranchExistsAsync();
        await LoadBranchesAsync();
    }

    private async Task LoadBranchesAsync()
    {
        _loading = true;
        _openActionBranchId = null;

        _branches = await BranchService.GetBranchesAsync(_searchTerm, _statusFilter);

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1;
        await LoadBranchesAsync();
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFiltersAsync();
        }
    }

    private void StatusFilterChanged(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "all";
        _currentPage = 1;
    }

    private void RowsChanged(ChangeEventArgs e)
    {
        _rowsMode = e.Value?.ToString() ?? "10";
        _currentPage = 1;
    }

    private void NextPage()
    {
        if (!ShowAllRows && _currentPage < TotalPages)
        {
            _currentPage++;
            _openActionBranchId = null;
        }
    }

    private void PreviousPage()
    {
        if (!ShowAllRows && _currentPage > 1)
        {
            _currentPage--;
            _openActionBranchId = null;
        }
    }

    private void ToggleActionMenu(int branchId)
    {
        _openActionBranchId = _openActionBranchId == branchId ? null : branchId;
    }

    private async Task ResetFiltersAsync()
    {
        _searchTerm = null;
        _statusFilter = "all";
        _currentPage = 1;
        await LoadBranchesAsync();
    }

    private void OpenAddModal()
    {
        _openActionBranchId = null;

        _form = new BranchFormModel
        {
            IsActive = true
        };

        if (!_branches.Any())
        {
            _form.IsMainBranch = true;
        }

        _showModal = true;
    }

    private async Task OpenEditModal(int id)
    {
        _openActionBranchId = null;

        var model = await BranchService.GetByIdAsync(id);

        if (model == null)
        {
            ShowMessage("Branch not found.", false);
            return;
        }

        _form = model;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _form = new BranchFormModel();
    }

    private async Task SaveBranchAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;

        var result = await BranchService.SaveAsync(_form);

        _saving = false;
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            _showModal = false;
            _form = new BranchFormModel();
            _currentPage = 1;
            await LoadBranchesAsync();
        }
    }

    private async Task ToggleStatusAsync(int id)
    {
        _openActionBranchId = null;

        var result = await BranchService.ToggleStatusAsync(id);
        ShowMessage(result.Message, result.Success);

        if (result.Success)
        {
            await LoadBranchesAsync();
        }
    }

    private void ConfirmDelete(int id, string name)
    {
        _openActionBranchId = null;

        _deleteId = id;
        _deleteBranchName = name;
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _deleteId = 0;
        _deleteBranchName = string.Empty;
        _showDeleteConfirm = false;
    }

    private async Task DeleteConfirmedAsync()
    {
        var result = await BranchService.DeleteAsync(_deleteId);

        ShowMessage(result.Message, result.Success);

        _deleteId = 0;
        _deleteBranchName = string.Empty;
        _showDeleteConfirm = false;

        if (result.Success)
        {
            await LoadBranchesAsync();
        }
    }

    private int ParseRows(string value)
    {
        return int.TryParse(value, out var rows) && rows > 0
            ? rows
            : 10;
    }

    private string Money(decimal value)
    {
        var symbol = string.IsNullOrWhiteSpace(_settings.CurrencySymbol)
            ? "R"
            : _settings.CurrencySymbol;

        return $"{symbol} {value:0.00}";
    }

    private string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "B";
        }

        var words = value
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .Select(x => x[0].ToString().ToUpper());

        return string.Join("", words);
    }

    private void ShowMessage(string message, bool success)
    {
        _message = message;
        _isSuccess = success;
    }

    private void ClearMessage()
    {
        _message = null;
    }
}