@page "/branches"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Web
@using PosPlatform.Web.Components.Layout
@using PosPlatform.Web.Models.Branches
@using PosPlatform.Web.Models.Settings
@using PosPlatform.Web.Services
@inject BranchService BranchService
@inject BusinessSettingsService BusinessSettingsService
@inject UserAccessService UserAccessService
@inject NavigationManager NavigationManager

<PageTitle>Branches</PageTitle>

<section class="branches-page">
    <div class="branches-top">
        <div>
            <div class="branches-kicker">
                <i class="bi bi-shop"></i>
                Branch management
            </div>

            <h1>Branches</h1>
            <p>Manage business locations, outlets, salons, warehouses and branch-level activity.</p>
        </div>

        <button type="button" class="branches-primary-btn" @onclick="OpenAddModal">
            <i class="bi bi-plus-lg"></i>
            Add Branch
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="branches-alert @(_isSuccess ? "success" : "danger")">
            <i class="bi @(_isSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
            <span>@_message</span>
            <button type="button" @onclick="ClearMessage">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <div class="branches-settings-strip">
        <div>
            <span>Business</span>
            <strong>@_settings.BusinessName</strong>
        </div>

        <div>
            <span>Business Type</span>
            <strong>@_settings.BusinessType</strong>
        </div>

        <div>
            <span>Total Branches</span>
            <strong>@_branches.Count</strong>
        </div>

        <div>
            <span>Active Branches</span>
            <strong>@_branches.Count(x => x.IsActive)</strong>
        </div>
    </div>

    <div class="branches-summary-grid">
        <div class="branches-summary-card hero">
            <div class="branches-summary-icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <span>Total Sales</span>
            <strong>@Money(_branches.Sum(x => x.SalesTotal))</strong>
            <small>Across filtered branches</small>
        </div>

        <div class="branches-summary-card">
            <div class="branches-summary-icon blue">
                <i class="bi bi-cart-check"></i>
            </div>
            <span>Sales Count</span>
            <strong>@_branches.Sum(x => x.SalesCount)</strong>
            <small>Transactions recorded</small>
        </div>

        <div class="branches-summary-card">
            <div class="branches-summary-icon amber">
                <i class="bi bi-box-arrow-in-down"></i>
            </div>
            <span>Purchases</span>
            <strong>@Money(_branches.Sum(x => x.PurchaseTotal))</strong>
            <small>Stock received</small>
        </div>

        <div class="branches-summary-card">
            <div class="branches-summary-icon red">
                <i class="bi bi-wallet2"></i>
            </div>
            <span>Expenses</span>
            <strong>@Money(_branches.Sum(x => x.ExpenseTotal))</strong>
            <small>Branch costs</small>
        </div>
    </div>

    <div class="branches-control-panel">
        <div class="branches-search">
            <i class="bi bi-search"></i>
            <input @bind="_searchTerm"
                   @bind:event="oninput"
                   @onkeydown="HandleSearchKeyDown"
                   placeholder="Search branch name, code, phone, email or address" />
        </div>

        <select class="branches-filter" value="@_statusFilter" @onchange="StatusFilterChanged">
            <option value="all">All branches</option>
            <option value="active">Active only</option>
            <option value="inactive">Inactive only</option>
            <option value="main">Main branch</option>
        </select>

        <button type="button" class="branches-secondary-btn" @onclick="ApplyFiltersAsync">
            <i class="bi bi-filter"></i>
            Apply
        </button>

        <button type="button" class="branches-ghost-btn" @onclick="ResetFiltersAsync">
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
        </button>
    </div>

    <div class="branches-panel">
        <div class="branches-panel-header">
            <div>
                <h2>Branch List</h2>
                <p>Showing @PageStart - @PageEnd of @TotalBranchRows branch@(TotalBranchRows == 1 ? "" : "es").</p>
            </div>

            <div class="branches-rows-tool">
                <label>Rows</label>
                <select value="@_rowsMode" @onchange="RowsChanged">
                    <option value="10">10 rows</option>
                    <option value="25">25 rows</option>
                    <option value="50">50 rows</option>
                    <option value="all">Show all</option>
                </select>
            </div>
        </div>

        @if (_loading)
        {
            <div class="branches-empty">
                <div class="branches-empty-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <strong>Loading branches...</strong>
                <span>Please wait while we fetch branch records.</span>
            </div>
        }
        else if (_branches.Count == 0)
        {
            <div class="branches-empty">
                <div class="branches-empty-icon">
                    <i class="bi bi-shop"></i>
                </div>
                <strong>No branches found</strong>
                <span>Add your first branch to start tracking business locations.</span>
            </div>
        }
        else
        {
            <div class="branches-table-wrap">
                <table class="branches-table">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Contact</th>
                            <th>Sales</th>
                            <th>Purchases</th>
                            <th>Expenses</th>
                            <th>Status</th>
                            <th class="branches-actions-col">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var branch in PaginatedBranches)
                        {
                            <tr>
                                <td>
                                    <div class="branches-cell">
                                        <div class="branches-avatar">@GetInitials(branch.Name)</div>

                                        <div>
                                            <strong>
                                                @branch.Name
                                                @if (branch.IsMainBranch)
                                                {
                                                    <span class="branches-main-tag">Main</span>
                                                }
                                            </strong>
                                            <span>@(string.IsNullOrWhiteSpace(branch.BranchCode) ? "No branch code" : branch.BranchCode)</span>
                                            <small>@(string.IsNullOrWhiteSpace(branch.Address) ? "No address" : branch.Address)</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="branches-contact">
                                        <strong>@(string.IsNullOrWhiteSpace(branch.Phone) ? "-" : branch.Phone)</strong>
                                        <span>@(string.IsNullOrWhiteSpace(branch.Email) ? "No email" : branch.Email)</span>
                                    </div>
                                </td>

                                <td>
                                    <strong>@Money(branch.SalesTotal)</strong>
                                    <span class="branches-muted">@branch.SalesCount sale@(branch.SalesCount == 1 ? "" : "s")</span>
                                </td>

                                <td>
                                    <strong>@Money(branch.PurchaseTotal)</strong>
                                    <span class="branches-muted">@branch.PurchaseCount purchase@(branch.PurchaseCount == 1 ? "" : "s")</span>
                                </td>

                                <td>
                                    <strong>@Money(branch.ExpenseTotal)</strong>
                                    <span class="branches-muted">@branch.ExpenseCount expense@(branch.ExpenseCount == 1 ? "" : "s")</span>
                                </td>

                                <td>
                                    <span class="branches-status-pill @(branch.IsActive ? "active" : "inactive")">
                                        @(branch.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="branches-actions-cell">
                                    <div class="branches-action-menu">
                                        <button type="button"
                                                class="branches-action-toggle"
                                                @onclick="() => ToggleActionMenu(branch.Id)">
                                            <span>Actions</span>
                                            <i class="bi bi-chevron-down"></i>
                                        </button>

                                        @if (_openActionBranchId == branch.Id)
                                        {
                                            <div class="branches-action-dropdown">
                                                <button type="button" @onclick="() => OpenEditModal(branch.Id)">
                                                    <i class="bi bi-pencil"></i>
                                                    <span>Edit branch</span>
                                                </button>

                                                <button type="button" @onclick="() => ToggleStatusAsync(branch.Id)">
                                                    <i class="bi @(branch.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                    <span>@(branch.IsActive ? "Pause branch" : "Activate branch")</span>
                                                </button>

                                                <button type="button" class="danger" @onclick="() => ConfirmDelete(branch.Id, branch.Name)">
                                                    <i class="bi bi-trash"></i>
                                                    <span>Delete branch</span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="branches-pagination">
                <div class="branches-page-info">
                    Showing
                    <strong>@PageStart</strong>
                    -
                    <strong>@PageEnd</strong>
                    of
                    <strong>@TotalBranchRows</strong>
                </div>

                <div class="branches-page-controls">
                    <button type="button" class="@PreviousPageClass" @onclick="PreviousPage">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span class="branches-page-count">
                        @(ShowAllRows ? "Showing all" : $"Page {_currentPage} of {TotalPages}")
                    </span>

                    <button type="button" class="@NextPageClass" @onclick="NextPage">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</section>

@if (_showModal)
{
    <div class="branches-modal-backdrop">
        <div class="branches-modal">
            <div class="branches-modal-header">
                <div>
                    <span>Branch setup</span>
                    <h4>@(_form.Id.HasValue ? "Edit Branch" : "Add Branch")</h4>
                    <p>Create and manage business locations such as stores, salons, outlets and warehouses.</p>
                </div>

                <button type="button" class="branches-close-btn" @onclick="CloseModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_form" OnValidSubmit="SaveBranchAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="branches-validation" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="branches-label">Branch Name</label>
                        <InputText class="branches-input" @bind-Value="_form.Name" />
                    </div>

                    <div class="col-md-6">
                        <label class="branches-label">Branch Code</label>
                        <InputText class="branches-input" @bind-Value="_form.BranchCode" />
                    </div>

                    <div class="col-md-6">
                        <label class="branches-label">Phone</label>
                        <InputText class="branches-input" @bind-Value="_form.Phone" />
                    </div>

                    <div class="col-md-6">
                        <label class="branches-label">Email</label>
                        <InputText class="branches-input" @bind-Value="_form.Email" />
                    </div>

                    <div class="col-12">
                        <label class="branches-label">Address</label>
                        <InputText class="branches-input" @bind-Value="_form.Address" />
                    </div>

                    <div class="col-12">
                        <label class="branches-label">Notes</label>
                        <InputTextArea class="branches-input branches-textarea" @bind-Value="_form.Notes" />
                    </div>

                    <div class="col-md-6">
                        <label class="branches-check">
                            <InputCheckbox @bind-Value="_form.IsMainBranch" />
                            <span>
                                <strong>Main branch</strong>
                                <small>Set this as the main/default business branch.</small>
                            </span>
                        </label>
                    </div>

                    <div class="col-md-6">
                        <label class="branches-check">
                            <InputCheckbox @bind-Value="_form.IsActive" />
                            <span>
                                <strong>Active branch</strong>
                                <small>Allow this branch to be used in operations.</small>
                            </span>
                        </label>
                    </div>
                </div>

                <div class="branches-modal-actions">
                    <button type="button" class="branches-ghost-btn" @onclick="CloseModal">Cancel</button>

                    <button type="submit" class="@SaveButtonClass">
                        <i class="bi bi-check2-circle"></i>
                        @(_saving ? "Saving..." : "Save Branch")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_showDeleteConfirm)
{
    <div class="branches-modal-backdrop">
        <div class="branches-modal branches-delete-modal">
            <div class="branches-delete-icon">
                <i class="bi bi-trash"></i>
            </div>

            <h4>Delete Branch</h4>
            <p>
                Are you sure you want to delete <strong>@_deleteBranchName</strong>?
                If this branch has linked records, it will be deactivated instead.
            </p>

            <div class="branches-modal-actions">
                <button type="button" class="branches-ghost-btn" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="branches-danger-btn" @onclick="DeleteConfirmedAsync">
                    <i class="bi bi-trash"></i>
                    Delete
                </button>
            </div>
        </div>
    </div>
}

<style>
    .branches-page {
        animation: branchesIn .22s ease both;
    }

    .branches-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        margin-bottom: 16px;
    }

    .branches-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #8FA6A1;
        font-size: .72rem;
        font-weight: 760;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .branches-top h1 {
        margin: 0;
        color: #111827;
        font-size: 1.45rem;
        font-weight: 720;
        letter-spacing: -.035em;
    }

    .branches-top p {
        margin: 6px 0 0;
        color: #667085;
        font-size: .88rem;
    }

    .branches-primary-btn,
    .branches-secondary-btn,
    .branches-ghost-btn,
    .branches-danger-btn,
    .branches-page-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 14px;
        font-size: .8rem;
        font-weight: 680;
        border: 0;
        white-space: nowrap;
        transition: transform .18s ease;
    }

    .branches-primary-btn {
        color: #ffffff;
        background: #252525;
        box-shadow: 0 12px 24px rgba(17,24,39,.12);
    }

    .branches-secondary-btn {
        color: #8FA6A1;
        background: #f2f6f5;
        border: 1px solid #dce7e4;
    }

    .branches-ghost-btn,
    .branches-page-btn {
        color: #475569;
        background: #ffffff;
        border: 1px solid #e5e7eb;
    }

    .branches-danger-btn {
        color: #ffffff;
        background: #d92d20;
    }

        .branches-primary-btn:hover,
        .branches-secondary-btn:hover,
        .branches-ghost-btn:hover,
        .branches-danger-btn:hover,
        .branches-page-btn:hover {
            transform: translateY(-1px);
        }

    .branches-primary-btn.is-disabled,
    .branches-page-btn.is-disabled {
        opacity: .45;
        cursor: not-allowed;
        transform: none;
    }

    .branches-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
        border-radius: 14px;
        font-size: .84rem;
        font-weight: 600;
        border: 1px solid;
    }

        .branches-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .branches-alert.danger {
            color: #991b1b;
            background: #fef2f2;
            border-color: #fecaca;
        }

        .branches-alert span {
            flex: 1;
        }

        .branches-alert button {
            border: 0;
            background: transparent;
            color: inherit;
        }

    .branches-settings-strip,
    .branches-summary-grid {
        display: grid;
        gap: 12px;
        margin-bottom: 16px;
    }

    .branches-settings-strip,
    .branches-summary-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

        .branches-settings-strip div,
        .branches-summary-card {
            padding: 15px;
            border-radius: 20px;
            background: #ffffff;
            border: 1px solid #e8eaef;
            box-shadow: 0 14px 32px rgba(17,24,39,.045);
        }

            .branches-settings-strip span,
            .branches-settings-strip strong,
            .branches-summary-card span,
            .branches-summary-card strong,
            .branches-summary-card small {
                display: block;
            }

            .branches-settings-strip span,
            .branches-summary-card span {
                color: #667085;
                font-size: .72rem;
                font-weight: 700;
            }

            .branches-settings-strip strong,
            .branches-summary-card strong {
                margin-top: 6px;
                color: #111827;
                font-size: 1.05rem;
                font-weight: 760;
                letter-spacing: -.02em;
            }

            .branches-summary-card small {
                margin-top: 4px;
                color: #98a2b3;
                font-size: .72rem;
                line-height: 1.35;
            }

            .branches-summary-card.hero {
                background: #252525;
                border-color: #252525;
            }

                .branches-summary-card.hero span,
                .branches-summary-card.hero strong,
                .branches-summary-card.hero small {
                    color: #ffffff;
                }

    .branches-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #252525;
        box-shadow: 0 10px 22px rgba(17, 24, 39, .08);
    }

        .branches-summary-icon.blue {
            color: #2563eb;
            background: #eff6ff;
        }

        .branches-summary-icon.amber {
            color: #b7791f;
            background: #fffbeb;
        }

        .branches-summary-icon.red {
            color: #d92d20;
            background: #fef3f2;
        }

    .branches-control-panel {
        display: grid;
        grid-template-columns: minmax(260px, 1fr) 180px auto auto;
        gap: 10px;
        padding: 14px;
        margin-bottom: 16px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e8eaef;
        box-shadow: 0 10px 24px rgba(17,24,39,.035);
    }

    .branches-search {
        min-height: 42px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 13px;
        border-radius: 14px;
        background: #fafafa;
        border: 1px solid #e5e7eb;
        color: #98a2b3;
    }

        .branches-search input,
        .branches-filter,
        .branches-input,
        .branches-rows-tool select {
            width: 100%;
            min-height: 40px;
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            background: #ffffff;
            color: #111827;
            padding: 0 12px;
            font-size: 16px;
            outline: none;
        }

        .branches-search input {
            border: 0;
            background: transparent;
            padding: 0;
        }

    .branches-panel {
        background: #ffffff;
        border: 1px solid #e8eaef;
        border-radius: 22px;
        box-shadow: 0 14px 32px rgba(17,24,39,.045);
        overflow: visible;
    }

    .branches-panel-header {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f2f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .branches-panel-header h2 {
            margin: 0;
            color: #111827;
            font-size: .94rem;
            font-weight: 720;
        }

        .branches-panel-header p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: .75rem;
        }

    .branches-rows-tool {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 170px;
    }

        .branches-rows-tool label {
            color: #667085;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
        }

    .branches-table-wrap {
        overflow-x: auto;
        padding-bottom: 100px;
    }

    .branches-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
    }

        .branches-table th {
            padding: 12px 16px;
            background: #fafafa;
            color: #667085;
            font-size: .7rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .05em;
            border-bottom: 1px solid #e8eaef;
            white-space: nowrap;
        }

        .branches-table td {
            padding: 14px 16px;
            color: #334155;
            font-size: .82rem;
            border-bottom: 1px solid #f1f2f5;
            vertical-align: middle;
        }

    .branches-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .branches-avatar {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: #f2f6f5;
        color: #8FA6A1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .78rem;
        font-weight: 750;
    }

    .branches-cell strong,
    .branches-contact strong {
        display: block;
        color: #111827;
        font-size: .85rem;
        font-weight: 720;
    }

    .branches-cell span,
    .branches-contact span,
    .branches-muted {
        display: block;
        margin-top: 2px;
        color: #98a2b3;
        font-size: .72rem;
    }

    .branches-cell small {
        display: block;
        margin-top: 2px;
        color: #667085;
        font-size: .72rem;
    }

    .branches-main-tag {
        display: inline-flex !important;
        margin-left: 6px !important;
        min-height: 20px;
        align-items: center;
        padding: 0 7px;
        border-radius: 999px;
        background: #f5f3ff;
        color: #7c3aed !important;
        font-size: .68rem !important;
        font-weight: 750;
    }

    .branches-status-pill {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        padding: 0 9px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 750;
    }

        .branches-status-pill.active {
            color: #15803d;
            background: #ecfdf5;
        }

        .branches-status-pill.inactive {
            color: #667085;
            background: #f3f4f6;
        }

    .branches-actions-col,
    .branches-actions-cell {
        text-align: right;
    }

    .branches-actions-cell {
        position: relative;
        min-width: 150px;
    }

    .branches-action-menu {
        position: relative;
        display: inline-block;
    }

    .branches-action-toggle {
        min-height: 34px;
        border-radius: 11px;
        border: 1px solid #e5e7eb;
        background: #ffffff;
        color: #252525;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 11px;
        font-size: .74rem;
        font-weight: 750;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(17, 24, 39, .04);
